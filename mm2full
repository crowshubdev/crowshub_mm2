local function runCleanup()
    local cleaned = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        local char = SafeGetCharacter(plr)
        if char then
            local hum = SafeGetHumanoid(char)
            if hum and hum.Health <= 0 then
                removeESPFromChar(char)
                cleaned = cleaned + 1
            end
        end
    end
