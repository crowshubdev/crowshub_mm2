-- Farm main loop
task.spawn(function()
    while task.wait(0.1) do
        if farm.On then
            local char = getChar(LocalPlayer)
            local root = getHRP(char)
            local hum = getHum(char)
            if root and hum and hum.Health > 0 then
                local coins = getCoins()
                if #coins > 0 then
                    local mur = farm.Avoid and getMurderer() or nil
                    local murHRP = mur and getHRP(getChar(mur))
                    local murPos = murHRP and murHRP.Position
                    local myPos = root.Position

                    table.sort(coins, function(a, b)
                        local pa, pb = coinPos(a), coinPos(b)
                        if not pa then return false end
                        if not pb then return true end
                        return (pa - myPos).Magnitude < (pb - myPos).Magnitude
                    end)

                    -- безопасная монета
                    local target
                    for _, c in ipairs(coins) do
                        local p = coinPos(c)
                        if p then
                            local cc = not murPos or (p - murPos).Magnitude > farm.SafeR
                            local pc = not murPos or segmentGap(myPos, p, murPos) > farm.SafeR
                            if cc and pc then target = c break end
                        end
                    end

                    if target then
                        local p = coinPos(target)
                        local dest = p
                        if farm.Mode == "Down" then
                            dest = Vector3.new(p.X, p.Y - farm.Depth, p.Z)
                            hum.PlatformStand = true
                        else
                            hum.PlatformStand = false
                        end

                        -- движение шагами
                        local dist = (dest - root.Position).Magnitude
                        local t = TweenService:Create(root,
                            TweenInfo.new(dist / farm.Speed, Enum.EasingStyle.Linear),
                            { CFrame = CFrame.new(dest) })
                        t:Play()

                        local abort = false
                        local conn
                        conn = RunService.Heartbeat:Connect(function()
                            local r = getHRP(getChar(LocalPlayer))
                            if not r or not target.Parent then abort = true return end
                            local cp = coinPos(target)
                            if not cp then abort = true return end

                            local flat = (Vector3.new(cp.X, 0, cp.Z)
                                - Vector3.new(r.Position.X, 0, r.Position.Z)).Magnitude

                            if flat < 8 then
                                local part = target:IsA("BasePart") and target
                                    or target:FindFirstChildWhichIsA("BasePart", true)
                                touchGrab(part, r)
                            end

                            if farm.Avoid and murPos then
                                local m = getHRP(getChar(getMurderer()))
                                if m then
                                    local mp = m.Position
                                    local near = (mp - r.Position).Magnitude < farm.FleeR
                                    local onPath = segmentGap(r.Position, dest, mp) < farm.SafeR
                                    if near or onPath then abort = true end
                                end
                            end
                        end)

                        while not abort and t.PlaybackState == Enum.PlaybackState.Playing do
                            task.wait(0.05)
                        end
                        t:Cancel()
                        if conn then conn:Disconnect() end
                        hum.PlatformStand = false
                        task.wait(0.15)
                    else
                        task.wait(0.5)
                    end
                end
            end
        end
    end
end)

