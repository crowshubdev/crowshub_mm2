do -- ═══ [CWH SCOPE] G20: REMOVE KILL PARTS (убираем киллпарты) ═══
-- ═══════════════════════════════════════════════════════════════
-- [v1.18] Идея из Overdrive (RemoveTraps): киллпарты карты (невидимка на
-- mansion 2 за стеной и т.п.) уезжают далеко вверх — ТОЛЬКО У ТЕБЯ, на
-- клиенте. Другие игроки видят их как раньше: софтеры умрут, ты — нет.
-- Плюс авто-детектор: умер от касания — этот парт сам уезжает.
local RP = { On = false, AutoDeath = true, Moved = {}, LastTouch = nil, LastTouchT = 0 }
local RP_PATTERNS = { "kill", "die", "death", "trap", "lava", "spike", "poison", "murder" }
local function rpPark(obj, silent)
    if RP.Moved[obj] then return false end
    local ok = pcall(function()
        RP.Moved[obj] = obj.CFrame
        obj.CFrame = obj.CFrame + Vector3.new(0, 5000, 0)
    end)
    if ok and not silent then
        Notify("Remove Kill Parts", "Киллпарт сдвинут: " .. obj.Name, nil, 2)
    end
    return ok
end
local function rpScan()
    local myChar = getChar(LocalPlayer)
    local n = 0
    pcall(function()
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Parent then
                local topModel = obj:FindFirstAncestorOfClass("Model")
                if not (topModel and Players:GetPlayerFromCharacter(topModel))
                    and not (myChar and obj:IsDescendantOf(myChar)) then
                    local lname = obj.Name:lower()
                    local isKill = false
                    for _, pat in ipairs(RP_PATTERNS) do
                        if lname:find(pat) then isKill = true break end
                    end
                    if isKill and rpPark(obj, true) then n = n + 1 end
                end
            end
        end
    end)
    return n
end
local function rpRestore()
    for obj, cf in pairs(RP.Moved) do
        if obj and obj.Parent then pcall(function() obj.CFrame = cf end) end
    end
    RP.Moved = {}
end
Tabs.Other:AddSection("☠️ Remove Kill Parts")
Tabs.Other:AddToggle("CWHRP", {
    Title = "☠️ Remove Kill Parts",
    Description = "[v1.18] Киллпарты (kill/trap/lava/…) уезжают вверх только у тебя: ты не умираешь, а другие софтеры по-прежнему могут. Проверка каждые 3 секунды и после респавна",
    Default = false
}):OnChanged(function(v)
    RP.On = v
    if v then
        local n = rpScan()
        Notify("Remove Kill Parts", "ВКЛ — сдвинуто деталей: " .. tostring(n), nil, 3)
    else
        rpRestore()
        Notify("Remove Kill Parts", "ВЫКЛ — детали вернулись", nil, 2)
    end
end)
Tabs.Other:AddToggle("CWHRPAuto", {
    Title = "🧟 Авто-сдвиг убийцы (по смерти)",
    Description = "[v1.18] Умер от касания киллпарта (например, невидимка на mansion 2) — этот парт сам уедет вверх",
