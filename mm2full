-- ═══ [v1.20] CLUTCH: бросил бомбу/банку светлячков → телепорт к броску ═══
-- Как в Overdrive: предмет летит — когда долетел и затормозил (или через 1.5с),
-- телепортируемся к нему. Работает с любым бросковым предметом.
local clutchOn = false
local CLUTCH_ALL = { "bomb", "jar", "firefl", "noves", "snowball", "egg", "pumpkin", "rocket", "grenade" }
local CLUTCH_BOMB = { "bomb", "noves", "grenade", "rocket", "egg" }
local CLUTCH_JAR = { "jar", "firefl" }
local function clutchKind(nm)
    local l = tostring(nm):lower()
    for _, pat in ipairs(CLUTCH_BOMB) do
        if l:find(pat, 1, true) then return "bomb" end
    end
    for _, pat in ipairs(CLUTCH_JAR) do
        if l:find(pat, 1, true) then return "jar" end
    end
    return "other"
end
local function clutchNameOK(nm)
    local l = tostring(nm):lower()
    for _, pat in ipairs(CLUTCH_ALL) do
        if l:find(pat, 1, true) then return true end
    end
    return false
end
local function clutchHook(t)
    if not (t and t:IsA("Tool")) then return end
    pcall(function()
        t.Activated:Connect(function()
            if not clutchOn then return end
            local char = getChar(LocalPlayer)
            local hrp = getHRP(char)
            if not hrp then return end
            local nm = t.Name
            task.spawn(function()
                local start = hrp.Position
                local kind = clutchKind(nm)
                local proj = nil
                -- ищем вылетевший предмет: летит от нас, дальше 3 студов
                -- бомбу ищем быстро — надо успеть ТП в момент броска
                for _ = 1, (kind == "bomb") and 14 or 30 do
                    task.wait(0.05)
                    for _, obj in ipairs(workspace:GetChildren()) do
                        local pp = obj
                        if obj:IsA("Model") then pp = obj:FindFirstChildWhichIsA("BasePart", true) end
                        if pp and pp:IsA("BasePart") and clutchNameOK(pp.Name) then
                            local d = (pp.Position - start).Magnitude
                            if d > 3 and d < 30 then proj = pp break end
                        end
                    end
                    if proj then break end
                end
                if not proj then return end
                if kind == "bomb" then
                    -- [v1.21] бомба: телепорт СРАЗУ, даже пока летит — «двойной
                    -- прыжок» в воздухе, как clutch в Overdrive (прыжок с высоты)
                else
                    -- банка светлячков: ждём, когда отлетит крышка (lid/cap)
                    -- или предмет остановится — тогда телепорт («второй прыжок»)
                    local lidSeen = false
                    local connL = workspace.DescendantAdded:Connect(function(o)
                        local l = tostring(o.Name):lower()
                        if l:find("lid", 1, true) or l:find("cap", 1, true) then lidSeen = true end
                    end)
                    local t0 = os.clock()
                    task.wait(0.35)
                    while proj and proj.Parent and os.clock() - t0 < 2 and not lidSeen do
                        local v = proj.AssemblyLinearVelocity
                        if v and v.Magnitude < 4 then break end
                        task.wait(0.05)
                    end
                    pcall(function() connL:Disconnect() end)
                end
                if proj and proj.Parent then
                    pcall(function()
                        hrp.CFrame = CFrame.new(proj.Position + Vector3.new(0, 2, 0))
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end)
                    Notify("Clutch", "Телепорт к броску: " .. nm, nil, 2)
                end
            end)
        end)
    end)
end
task.spawn(function()
    local function hookChar(char)
        if not char then return end
        local function h(t)
            if t:IsA("Tool") and not (t.Name == "Knife" or t.Name == "Gun") then
                clutchHook(t)
            end
        end
        for _, t2 in ipairs(char:GetChildren()) do h(t2) end
        char.ChildAdded:Connect(h)
        local bp = LocalPlayer:FindFirstChild("Backpack")
        if bp then
            for _, t2 in ipairs(bp:GetChildren()) do h(t2) end
            bp.ChildAdded:Connect(h)
        end
    end
    hookChar(getChar(LocalPlayer))
    LocalPlayer.CharacterAdded:Connect(function(ch)
        task.wait(0.4)
        hookChar(ch)
    end)
end)
Tabs.Other:AddSection("🪁 Clutch (бросок → телепорт)")
Tabs.Other:AddToggle("CWHClutch", {
    Title = "🪁 Clutch — телепорт к броску",
    Description = "[v1.21] Бомба — телепорт В МОМЕНТ броска (двойной прыжок в воздухе, прыжок с высоты). Банка светлячков — телепорт, когда отлетает крышка. Работает с любым бросковым предметом",
    Default = false
}):OnChanged(function(v) clutchOn = v end)

