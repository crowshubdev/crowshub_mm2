                    AutoFarm.Enabled = false
                    Notify("Farm", "Max coins! (" .. AutoFarm.MaxCoins .. ")", nil, 4)
                else
                    local coins = GetCoins()
                    local murderer = GetMurderer()
                    local mHRP = murderer and SafeGetHRP(SafeGetCharacter(murderer))
                    local bestCoin, bestDist = nil, math.huge
                    
                    for _, coin in pairs(coins) do
                        if coin and coin.Parent and coin:IsA("BasePart") then
                            local dist = (hrp.Position - coin.Position).Magnitude
                            if AutoFarm.AvoidMurder and mHRP then
                                if (mHRP.Position - coin.Position).Magnitude < AutoFarm.AvoidRange then continue end
                            end
                            if dist < bestDist then bestDist = dist bestCoin = coin end
                        end
                    end
                    
                    if bestCoin then
                        local cp = bestCoin.Position
                        if AutoFarm.CoinAura and bestDist <= AutoFarm.AuraRange then
                            hrp.CFrame = CFrame.new(cp.X, cp.Y + 2, cp.Z)
                            AutoFarm.CollectedCoins = AutoFarm.CollectedCoins + 1
