-- ═══ [v1.9] SA4-PRED: ядро предсказания из нового Pulse (V4-движок) ═══
-- Каждый кадр пишем сэмплы позиции КАЖДОГО игрока; скорость и ускорение —
-- сглаженные по окну истории. Прицельная точка = pos + v*dt + 0.5*a*dt².
-- Это то, из-за чего Pulse-аим почти не мисает на движущихся целях.
local pred4 = { samples = {} }
local pred4Conn = RunService.Heartbeat:Connect(function()
    local now = os.clock()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local root = getHRP(p.Character)
            if root then
                local list = pred4.samples[p]
                if not list then list = {} pred4.samples[p] = list end
                -- [v1.10] анти-телепорт: скачок >25 студов = сброс истории,
                -- иначе V4-предикт улетает за телепортом/респавном цели
                local last = list[#list]
                if last and (root.Position - last.pos).Magnitude > 25 then
                    list = {}
                    pred4.samples[p] = list
                end
                list[#list + 1] = { t = now, pos = root.Position }
                while #list > 25 or (list[1] and now - list[1].t > 1.0) do
                    table.remove(list, 1)
                end
            else
                pred4.samples[p] = nil
            end
        end
    end
end)

local function pred4Velocity(t)
    local list = pred4.samples[t]
    if not list or #list < 2 then return nil end
    local a, b = list[1], list[#list]
    local dt = b.t - a.t
    if dt <= 0.02 then return nil end
    return (b.pos - a.pos) / dt
end

local function pred4Accel(t)
    local list = pred4.samples[t]
    if not list or #list < 6 then return Vector3.zero end
    local mid = math.floor(#list / 2)
    local dt1 = list[mid].t - list[1].t
    local dt2 = list[#list].t - list[mid].t
    if dt1 <= 0.02 or dt2 <= 0.02 then return Vector3.zero end
    local v1 = (list[mid].pos - list[1].pos) / dt1
    local v2 = (list[#list].pos - list[mid].pos) / dt2
    return (v2 - v1) / ((dt1 + dt2) / 2)
end

local function pred4Pos(t, curPos, dt)
    local v = pred4Velocity(t)
    if not v then return curPos end
    local a = pred4Accel(t)
    local p = curPos + v * dt + a * (0.5 * dt * dt)
    -- [v1.9] против "улетевших" точек: не дальше 6 студов от реальной позиции
    if (p - curPos).Magnitude > 6 then
        p = curPos + (p - curPos).Unit * 6
    end
    return p
end
