smbCorner.Parent = smb

local smbStroke = Instance.new("UIStroke")
smbStroke.Color = Color3.fromRGB(126, 126, 255)
smbStroke.Thickness = 2.5
smbStroke.Transparency = 0.1
smbStroke.Parent = smb

local SMB_W, SMB_H = 170, 44
local function applySize()
    smb.Size = UDim2.new(0, SMB_W, 0, SMB_H)
    smb.TextSize = math.clamp(math.min(SMB_W, SMB_H) * 0.4, 10, 26)
end

local lastShot = 0
local shooting = false

local function doShoot()
    if shooting then return end
    local now = os.clock()
    if now - lastShot < 0.8 then return end

    -- ган: найти и экипировать
    local c = getChar(LocalPlayer)
    local gun = c and c:FindFirstChild("Gun")
    if not gun then
        local bp = LocalPlayer:FindFirstChild("Backpack")
        gun = bp and bp:FindFirstChild("Gun")
        if gun then
            local hum = getHum(c)
            if hum then
                pcall(function() hum:EquipTool(gun) end)
                task.wait(0.2)
                gun = getChar(LocalPlayer):FindFirstChild("Gun")
            end
        end
    end
    -- [v1.23] сначала цель, потом оружие: из ЛОББИ гана нет — НЕ отдаёмся с
    -- «Нет Gun!», а стреляем: sa3FireShot сам найдёт Shoot-ремоут (SA3.NoGun,
    -- включён по умолчанию) и отправит выстрел с origin у мардера
    local mur = getMurderer()
    if not mur then Notify("Shoot", "Murderer не найден", nil, 3) return end

    shooting = true
    lastShot = os.clock()
    -- [v1.6] на кнопке появляется текст "fired"
    smb.Text = "fired"
    task.delay(1.2, function()
        pcall(function() smb.Text = "Shoot Murderer" end)
    end)
    -- прямой выстрел ремоутом Shoot в Murderer (SA3/Pulse-метод — пробивает стены);
    -- [v1.10] origin НАД головой мардера — пуля летит сверху вниз, как раньше
    local ok = sa3FireShot(mur, true)
    shooting = false

    if ok then
        smbStroke.Color = Color3.fromRGB(255, 80, 80)
        task.delay(0.25, function()
            smbStroke.Color = Color3.fromRGB(126, 126, 255)
        end)
        Notify("Shoot", "🔫 → " .. mur.Name, nil, 2)
    else
        Notify("Shoot", "Не получилось — нет Gun/Shoot-ремоута или цель недоступна", nil, 3)
    end
end

-- [v1.6] ТАП = выстрел, ДРАГ = перенос. Порог 8px: при простом нажатии кнопка
-- никуда не сдвигается и не "улетает" (второй палец драг не перехватывает).
do
    local dragging, dragMoved = false, false
    local dragInput, dragStart, startPos = nil, nil, nil

    smb.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragMoved = false
            dragInput = i
            dragStart = i.Position
            startPos = smb.Position
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if not dragMoved then
                        pcall(getgenv().CWH_ClickSound) -- [v1.8] щелчок на кнопку Shoot Murderer
                        task.spawn(doShoot)
                    end
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
            or (i.UserInputType == Enum.UserInputType.Touch and i == dragInput)) then
            local d = i.Position - dragStart
            if d.Magnitude > 8 then dragMoved = true end
            if dragMoved then
                smb.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end
    end)
end

