-- Silent Aim v2 (Simple/Pro/Hacker)
local SA2 = local SA2 = { On = false, Mode = "Simple", Target = "Murderer", Predict = true, Range = 300, AimPart = "Torso" }
local WS2, origM, origT, hooked = nil, nil, nil, false

local function getWS()
    if WS2 then return WS2 end
    local ok, m = pcall(function()
        return require(ReplicatedStorage:WaitForChild("ClientServices", 10):WaitForChild("WeaponService", 10))
    end)
    if ok and type(m) == "table" then WS2 = m end
    return WS2
end

local function pickSA()
    if SA2.Target == "Murderer" then return getMurderer() end
    if SA2.Target == "Sheriff" then return getSheriff() end
    local my = getHRP(getChar(LocalPlayer))
    if not my then return end
    local best, bd = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local h = getHum(getChar(p))
            local hrp = getChar(p) and getHRP(getChar(p))
            if h and h.Health > 0 and hrp then
                local d = (hrp.Position - my.Position).Magnitude
                if d < bd then bd = d best = p end
            end
        end
    end
    return best
end

local function aimCF()
    local t = pickSA()
    if not (t and t.Character) then return end
    local c = t.Character
    local part = c:FindFirstChild("Head") or c:FindFirstChild("UpperTorso")
        or c:FindFirstChild("Torso") or c:FindFirstChild("HumanoidRootPart")
    local my = getHRP(getChar(LocalPlayer))
    if not (part and my) then return end
    local pos = part.Position
    local dist = (pos - my.Position).Magnitude
    if SA2.Mode == "Simple" then
        if dist > SA2.Range then return end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { LocalPlayer.Character }
        local hit = workspace:Raycast(my.Position, pos - my.Position, params)
        if hit and not (hit.Instance and hit.Instance:IsDescendantOf(c)) then return end
    elseif SA2.Mode == "Pro" then
        if dist > SA2.Range then return end
    end
    if SA2.Predict then
        local root = getHRP(c)
        if root then
            local vel = root.AssemblyLinearVelocity or Vector3.zero
            local ping = 0
            pcall(function() ping = LocalPlayer:GetNetworkPing() or 0 end)
            if ping > 1 then ping = ping / 1000 end
            pos = pos + vel * (ping + 0.05)
        end
    end
    return CFrame.new(pos)
end

local function installHooks()
    local m = getWS()
    if not m then return false end
    if hooked then return true end
    pcall(function() setreadonly(m, false) end)
    if type(m.GetMouseTargetCFrame) == "function" then
        origM = m.GetMouseTargetCFrame
        m.GetMouseTargetCFrame = function(s, ...)
            if SA2.On then
                local cf = aimCF()
                if cf then return cf end
            end
            return origM(s, ...)
        end
    end
    if type(m.GetTargetPosition) == "function" then
        origT = m.GetTargetPosition
        m.GetTargetPosition = function(s, ...)
            if SA2.On then
                local cf = aimCF()
                if cf then return cf.Position end
            end
            return origT(s, ...)
        end
    end
    hooked = true
    return true
end

local function removeHooks()
    if WS2 and hooked then
        pcall(function() setreadonly(WS2, false) end)
        if origM then pcall(function() WS2.GetMouseTargetCFrame = origM end) end
        if origT then pcall(function() WS2.GetTargetPosition = origT end) end
    end
    hooked = false
end

-- Hacker: push attachment за стену
local pushConn, savedAtt = nil, nil
local function getAtt()
    local hrp = getHRP(getChar(LocalPlayer))
    return hrp and hrp:FindFirstChild("GunRaycastAttachment")
end
local function restoreAtt()
    local a = getAtt()
    if a and savedAtt then pcall(function() a.WorldCFrame = savedAtt end) end
    savedAtt = nil
end

local function startPush()
    if pushConn then pushConn:Disconnect() end
    pushConn = RunService.Heartbeat:Connect(function()
        if not (SA2.On and SA2.Mode == "Hacker") then return end
        local t = pickSA()
        local my = getHRP(getChar(LocalPlayer))
        local th = t and t.Character and getHRP(t.Character)
        if not (t and my and th) then restoreAtt() return end
        local a = getAtt()
        if not a then return end
        if not savedAtt then pcall(function() savedAtt = a.WorldCFrame end) end

        local dir = (th.Position - my.Position)
        if dir.Magnitude < 1 then return end
        dir = dir.Unit

        -- стена между нами?
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { LocalPlayer.Character }
        local hit = workspace:Raycast(my.Position, th.Position - my.Position, params)
        local tchar = t.Character
        local blocked = hit and tchar and not hit.Instance:IsDescendantOf(tchar)

        if not blocked then
            -- путь чист — обычный выстрел, ничего не двигаем
            restoreAtt()
            return
        end

        -- стена есть: точка выстрела за ней (60% пути до цели)
        local d = math.max(math.min((th.Position - my.Position).Magnitude * 0.6, 60), 10)
        pcall(function()
            a.WorldCFrame = CFrame.new(my.Position + dir * d, th.Position)
        end)
    end)
end

local function stopPush()
    if pushConn then pushConn:Disconnect() pushConn = nil end
    restoreAtt()
end

