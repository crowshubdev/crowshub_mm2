-- KILL EVERYONE (убить всех, включая невидимок)
-- ═══════════════════════════════════════════════════════════════

local KillEveryone = {
    Enabled = false,
    Range = 99999,              -- Радиус (999 = вся карта)
    UseFireTouch = true,      -- firetouchinterest (работает через стены)
    UseStab = true,           -- KnifeStabbed (дополнительно)
    Delay = 0.1,              -- Задержка между ударами
    Thread = nil,
}

-- Проверка что я Murderer
local function amMurderer()
    local char = SafeGetCharacter(LocalPlayer)
    if not char then return false end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    return (char:FindFirstChild("Knife") ~= nil) or (bp and bp:FindFirstChild("Knife") ~= nil)
end

-- Получить нож
local function getMyKnife()
    local char = SafeGetCharacter(LocalPlayer)
    if char then
        local eq = char:FindFirstChild("Knife")
        if eq then return eq end
    end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        return bp:FindFirstChild("Knife")
    end
    return nil
end

-- Экипировать нож
local function equipKnife()
    local knife = getMyKnife()
    if not knife then return nil end
    local char = SafeGetCharacter(LocalPlayer)
    if knife.Parent ~= char then
        local hum = SafeGetHumanoid(char)
        if hum then
            pcall(function() hum:EquipTool(knife) end)
            task.wait(0.2)
        end
    end
    return getMyKnife()
end

-- Убить игрока
local function killTarget(part)
    local knife = getMyKnife()
    if not knife or not part then return false end
    
    local events = knife:FindFirstChild("Events")
    
    -- Способ 1: KnifeStabbed
    if KillEveryone.UseStab and events then
        local stabbed = events:FindFirstChild("KnifeStabbed")
        if stabbed then
            pcall(function() stabbed:FireServer() end)
        end
    end
    
    -- Способ 2: HandleTouched (главный)
    if events then
        local touched = events:FindFirstChild("HandleTouched")
        if touched then
            pcall(function() touched:FireServer(part) end)
        end
    end
    
    -- Способ 3: firetouchinterest (работает через стены)
    if KillEveryone.UseFireTouch and firetouchinterest then
        local handle = knife:FindFirstChild("Handle")
        if handle then
            pcall(function()
                firetouchinterest(handle, part, 1)
                firetouchinterest(handle, part, 0)
            end)
        end
    end
    
    return true
end

-- Главный loop Kill Everyone
local function killEveryoneLoop()
    while KillEveryone.Enabled do
        if amMurderer() then
            local knife = equipKnife()
            if knife then
                local myChar = SafeGetCharacter(LocalPlayer)
                local myHRP = SafeGetHRP(myChar)
                
                if myHRP then
                    -- Проходим по всем игрокам
                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr ~= LocalPlayer then
                            local pChar = SafeGetCharacter(plr)
                            if pChar then
                                local pHum = SafeGetHumanoid(pChar)
                                if pHum and pHum.Health > 0 then
                                    local pHRP = SafeGetHRP(pChar)
                                    if pHRP then
                                        local dist = (myHRP.Position - pHRP.Position).Magnitude
                                        if dist <= KillEveryone.Range then
                                            -- Убиваем (работает даже на невидимках!)
                                            killTarget(pHRP)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        task.wait(KillEveryone.Delay)
    end
end

-- GUI
Tabs.Combat:AddSection("Kill Everyone")

local KillEveryoneToggle = Tabs.Combat:AddToggle("KillEveryoneToggle", {
    Title = "💀 Kill Everyone",
    Description = "Убивает всех игроков (включая невидимок)",
