local function removeESPFromChar(char)
    if not char then return end
    local hl = char:FindFirstChild("CrowsESP_HL")
    if hl then hl:Destroy() end
    local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
    if hrp then
        local bg = hrp:FindFirstChild("CrowsNameESP")
        if bg then bg:Destroy() end
    end
end

local function updateESP()
    local myHRP = SafeGetHRP(SafeGetCharacter(LocalPlayer))
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = SafeGetCharacter(plr)
        if not char then continue end

        local role = getCachedRole(plr)
        local roleColor = GetRoleColor(role)

        if ESPConfig.Players then
            createPlayerHighlight(plr)
            local hl = char:FindFirstChild("CrowsESP_HL")
            if hl then
                hl.FillColor = roleColor
                hl.OutlineColor = roleColor
                hl.Enabled = true
            end
        else
            local hl = char:FindFirstChild("CrowsESP_HL")
            if hl then hl.Enabled = false end
        end

        if ESPConfig.Names or ESPConfig.Distance or ESPConfig.Health then
            createPlayerNameTag(plr)
            local hrp = SafeGetHRP(char)
            local bg = hrp and hrp:FindFirstChild("CrowsNameESP")
            if bg then
                bg.Enabled = true
                local label = bg:FindFirstChild("Label")
                if label then
                    local lines = {}
                    if ESPConfig.Names then
                        table.insert(lines, plr.Name .. " [" .. role .. "]")
                    end
                    if ESPConfig.Health then
                        local hum = SafeGetHumanoid(char)
                        if hum then
                            table.insert(lines, "HP: " .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth))
                        end
                    end
                    if ESPConfig.Distance and myHRP and hrp then
                        local dist = math.floor((myHRP.Position - hrp.Position).Magnitude)
                        table.insert(lines, dist .. " studs")
                    end
                    label.Text = table.concat(lines, "\n")
                    label.TextColor3 = roleColor
                end
            end
        else
            local hrp = SafeGetHRP(char)
            local bg = hrp and hrp:FindFirstChild("CrowsNameESP")
            if bg then bg.Enabled = false end
        end
    end
end

task.spawn(function()
    while not getgenv().CWH_Unloaded do
        if ESPConfig.Players or ESPConfig.Names or ESPConfig.Distance or ESPConfig.Health then
            pcall(updateESP)
        end
        task.wait(0.2)
    end
end)

