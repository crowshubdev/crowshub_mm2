local function segmentGap(a, b, p)
    if not a then return (b - p).Magnitude end
    local ab = b - a
    local l2 = ab:Dot(ab)
    if l2 < 1e-6 then return (b - p).Magnitude end
    local t = math.clamp((p - a):Dot(ab) / l2, 0, 1)
    return (a + ab * t - p).Magnitude
end

