local function CreatePlayerESP(player)
    if player == LocalPlayer then return end
    if ESPObjects[player] then return end
    local char = SafeGetCharacter(player)
    if not char then return end
    local data = {}

    local hl = Instance.new("Highlight")
    hl.Name = "CrowsESP_HL"
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    if ESP.Mode == "Chams" then
        hl.FillTransparency = 0.1
        hl.OutlineTransparency = 0
    else
        hl.FillTransparency = 0.6
        hl.OutlineTransparency = 0.2
    end
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.Parent = char
    data.Highlight = hl

    local nameBillboard = CreateBillboard(char, UDim2.new(0, 200, 0, 35), Vector3.new(0, 3.5, 0))
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 1, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextStrokeTransparency = 0.4
    nameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 14
    nameLabel.Parent = nameBillboard
    data.NameTag = nameBillboard
    data.NameLabel = nameLabel

    local healthBillboard = CreateBillboard(char, UDim2.new(0, 100, 0, 6), Vector3.new(0, 2.8, 0))
    local healthBg = Instance.new("Frame")
    healthBg.Size = UDim2.new(1, 0, 1, 0)
    healthBg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    healthBg.BorderSizePixel = 0
    healthBg.Parent = healthBillboard
    local healthCorner = Instance.new("UICorner")
    healthCorner.CornerRadius = UDim.new(0, 2)
    healthCorner.Parent = healthBg
    local healthFill = Instance.new("Frame")
    healthFill.Size = UDim2.new(1, 0, 1, 0)
    healthFill.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
    healthFill.BorderSizePixel = 0
    healthFill.Parent = healthBg
    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(0, 2)
    fillCorner.Parent = healthFill
    data.HealthBar = healthBillboard
    data.HealthFill = healthFill

    ESPObjects[player] = data
end

local function UpdatePlayerESP(player)
    local data = ESPObjects[player]
    if not data then return end
    local char = SafeGetCharacter(player)
    if not char then ClearPlayerESP(player) return end
    local role = GetRole(player)
    local roleColor = GetRoleColor(role)
    local hum = SafeGetHumanoid(char)
    local hrp = SafeGetHRP(char)
    local localHRP = SafeGetHRP(SafeGetCharacter(LocalPlayer))

    if data.Highlight then
        data.Highlight.FillColor = roleColor
        data.Highlight.Enabled = ESP.Players
        if ESP.Mode == "Chams" then
            data.Highlight.FillTransparency = 0.1
            data.Highlight.OutlineTransparency = 0
        else
            data.Highlight.FillTransparency = 0.6
            data.Highlight.OutlineTransparency = 0.2
        end
    end
    if data.NameTag and data.NameLabel then
        data.NameTag.Enabled = ESP.Names or ESP.Distance
        local text = ""
        if ESP.Names then
            text = player.DisplayName .. " (" .. player.Name .. ")\n[" .. role .. "]"
        end
        if ESP.Distance and localHRP and hrp then
            local dist = math.floor((localHRP.Position - hrp.Position).Magnitude)
            if text ~= "" then text = text .. "\n" end
            text = text .. dist .. " studs"
        end
        data.NameLabel.Text = text
        data.NameLabel.TextColor3 = roleColor
    end
    if data.HealthBar and data.HealthFill then
        data.HealthBar.Enabled = ESP.Health and hum ~= nil
        if hum then
            local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            data.HealthFill.Size = UDim2.new(pct, 0, 1, 0)
            data.HealthFill.BackgroundColor3 = Color3.fromRGB(255 * (1-pct), 255 * pct, 50)
        end
    end
end

local function UpdateGunESP()
    local gun = workspace:FindFirstChild("GunDrop", true)
    if not gun or not ESP.Gun then
        if GunESPObject then
            if GunESPObject.Highlight and GunESPObject.Highlight.Parent then GunESPObject.Highlight:Destroy() end
            if GunESPObject.NameTag and GunESPObject.NameTag.Parent then GunESPObject.NameTag:Destroy() end
            GunESPObject = nil
        end
        return
    end
    if not GunESPObject then
        GunESPObject = {}
        local hl = Instance.new("Highlight")
        hl.Name = "CrowsESP_Gun"
        hl.FillColor = Color3.fromRGB(255, 215, 0)
        hl.OutlineColor = Color3.fromRGB(255, 255, 100)
        hl.FillTransparency = 0.3
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = gun
        GunESPObject.Highlight = hl
        local billboard = CreateBillboard(gun, UDim2.new(0, 160, 0, 30), Vector3.new(0, 1.5, 0))
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = "🔫 GUN DROP"
        label.TextColor3 = Color3.fromRGB(255, 215, 0)
        label.TextStrokeTransparency = 0.3
        label.Font = Enum.Font.GothamBold
        label.TextSize = 16
        label.Parent = billboard
        GunESPObject.NameTag = billboard
    end
end

