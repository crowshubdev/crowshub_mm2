-- Большие серые части карты (полы/платформы) получают СЕРУЮ обводку, которую
-- видно даже сквозь стены — удобно под картой (Invisibility) и в темноте.
local OL = { On = false, Folder = nil, LastMap = nil }
local OL_COLOR = Color3.fromRGB(190, 190, 190)

local function olClear()
    if OL.Folder then pcall(function() OL.Folder:Destroy() end) end
    OL.Folder = nil
end

local function olBuild()
    olClear()
    local map = getMap()
    if not map then
        Notify("Обводка", "Карта не найдена", nil, 3)
        return
    end
    local f = Instance.new("Folder")
    f.Name = "CWH_MapOutline"
    local n = 0
    for _, p in ipairs(map:GetDescendants()) do
        if p:IsA("BasePart") and p.Transparency < 1 then
            local s = p.Size
            if s.X * s.Y * s.Z >= 80 and math.max(s.X, s.Y, s.Z) >= 6 then
                local ad = Instance.new("BoxHandleAdornment")
                ad.Name = "CWH_OL"
                ad.Adornee = p
                ad.AlwaysOnTop = true
                ad.ZIndex = 0
                ad.Transparency = 0.65
                ad.Color3 = OL_COLOR
                ad.Size = s + Vector3.new(0.25, 0.25, 0.25)
                ad.Parent = f
                n = n + 1
                if n >= 220 then break end
            end
        end
    end
    f.Parent = (gethui and gethui() or CoreGui)
    OL.Folder = f
    OL.LastMap = map
    Notify("Обводка карты", "Серая обводка: " .. n .. " частей", nil, 2)
end

