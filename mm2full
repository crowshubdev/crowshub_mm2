-- ═══ [v1.21] СТИЛЬ «ТЕЛЕПОРТ»: проваливаемся под пол у монеты (стоя/лёжа) ═══
-- Уход в пол — слайдер (макс 5 студов, не умрём в пустоте), тач бьёт монету
-- через пол, после сбора ещё немного уходим в пол и телепорт в лобби. По кругу.
-- Мардер не достанет: между монетами ты в лобби; монеты в kill-зоне пропускаются.
task.spawn(function()
    while true do
        if not getgenv().CWH_RUN then break end
        pcall(function()
            if not (AutoFarmSystem.Enabled and AutoFarmSystem.Style == "Телепорт") then return end
            if flinging or rawget(getgenv(), "CWH_FlingActive") == true then return end
            local hrp = farm_hrp()
            if not hrp then return end
            local list = available_coins()
            if #list > 0 then AutoFarmSystem.sawCoins = true end
            if AutoFarmSystem.CoinTarget > 0 and AutoFarmSystem.sawCoins
                and AutoFarmSystem.CollectedCount >= AutoFarmSystem.CoinTarget then
                maybeRoundDone("target")
                return
            end
            if getMap() and coin_bags_full() then
                maybeRoundDone("bags")
                return
            end
            if #list == 0 then return end
            local mhrp = murderer_hrp()
            local mpos = mhrp and mhrp.Position or nil
            local target = nearest_coin(hrp.Position, list, mpos, true)
            if not target then
                -- все монеты у кемпящего мардера — отойти и подождать
                if mpos then
                    local away = Vector3.new(hrp.Position.X - mpos.X, 0, hrp.Position.Z - mpos.Z)
                    if away.Magnitude < 0.1 then away = Vector3.new(1, 0, 0) end
                    pcall(function() hrp.CFrame = CFrame.new(hrp.Position + away.Unit * 30 + Vector3.new(0, 3, 0)) end)
                end
                task.wait(1)
                return
            end
            local lie = (AutoFarmSystem.TPPose == "Лёжа")
            set_farm_noclip(true, lie)
            local cpos = target.Position
            local depth = math.clamp(AutoFarmSystem.TPDepth or 3, 0, 5)
            local cf = CFrame.new(cpos.X, cpos.Y - depth, cpos.Z)
            if lie then cf = cf * CFrame.Angles(-math.pi * 0.5, 0, 0) end
            pcall(function()
                hrp.CFrame = cf
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end)
            task.wait(0.12)
            fire_touch(target)
            local t0 = os.clock()
            while os.clock() - t0 < 1 and coin_available(target) do task.wait(0.05) end
            -- немного ещё уходим в пол — и телепорт в лобби
            pcall(function()
                hrp.CFrame = CFrame.new(hrp.Position - Vector3.new(0, 1, 0))
                hrp.AssemblyLinearVelocity = Vector3.zero
            end)
            task.wait(0.1)
            pcall(function() hrp.CFrame = CL_LOBBY_CF end)
            set_farm_noclip(false)
            -- пауза против кика + немного рандома
            task.wait((AutoFarmSystem.TPDelay or 1.5) + math.random() * 0.3)
        end)
        task.wait(0.05)
    end
end)

