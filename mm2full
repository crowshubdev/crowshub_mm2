RunService.Stepped:Connect(function()
    -- Speedhack
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        if LocalPlayer.Character.Humanoid.WalkSpeed ~= Settings.Speedhack then
            LocalPlayer.Character.Humanoid.WalkSpeed = Settings.Speedhack
        end
    end
    
    -- FOV
    if Camera.FieldOfView ~= Settings.FOV then
        Camera.FieldOfView = Settings.FOV
    end
    
    -- Anti-Trap Logic
    if Settings.AntiTrap then
        for _, v in pairs(workspace:GetChildren()) do
            if v.Name:lower():find("trap") then
                for _, part in pairs(v:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end
    end
    
    -- Auto Grab Gun
    if Settings.AutoGrabGun then
        PullGunToPlayer()
    end
end)

