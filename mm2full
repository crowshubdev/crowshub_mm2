local FlingData = {
    Murderer = false,
    Sheriff = false,
    Player = nil,
    Anti = false
}

local function DoFling(targetPlayer)
    if not targetPlayer then return end
    local char = SafeGetCharacter(targetPlayer)
    local hrp = SafeGetHRP(char)
    if not hrp then return end

    -- Method 1: Velocity fling
    local vel = Instance.new("BodyVelocity")
    vel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    vel.Velocity = Vector3.new(math.random(-500, 500), math.random(300, 700), math.random(-500, 500))
    vel.Parent = hrp

    task.wait(0.5)
    vel:Destroy()

    -- Method 2: CFrame launch
    for i = 1, 5 do
        hrp.CFrame = hrp.CFrame + Vector3.new(0, 30, 0) + Vector3.new(math.random(-20, 20), 0, math.random(-20, 20))
        task.wait(0.05)
    end
end

