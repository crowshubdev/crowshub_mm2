-- ANTI-FLING (улучшенный, отдельный модуль)
-- ═══════════════════════════════════════════════════════════════

local AntiFling = {
    Enabled = false,
    ClearBodyMovers = true,     -- Удалять BodyVelocity у себя
    DisableEnemyCollide = true, -- Убирать CanCollide у чужих
    ResetVelocity = true,       -- Обнулять свою скорость при спайке
    MaxVelocity = 500,          -- Порог скорости (если больше — спайк)
    CheckInterval = 0.05,       -- Проверка 20 раз/сек
    LastCheck = 0
}

-- Основной loop
RunService.Heartbeat:Connect(function(dt)
    if not AntiFling.Enabled then return end
    
    AntiFling.LastCheck = AntiFling.LastCheck + dt
    if AntiFling.LastCheck < AntiFling.CheckInterval then return end
    AntiFling.LastCheck = 0
    
    local char = SafeGetCharacter(LocalPlayer)
    if not char then return end
    
    local hrp = SafeGetHRP(char)
    local hum = SafeGetHumanoid(char)
    if not hrp then return end
    
    -- ═══ Защита 1: очистка BodyMovers у себя ═══
    if AntiFling.ClearBodyMovers then
        for _, obj in pairs(char:GetDescendants()) do
            if obj:IsA("BodyVelocity") 
                or obj:IsA("BodyAngularVelocity")
                or obj:IsA("BodyThrust") 
                or obj:IsA("BodyGyro")
                or obj:IsA("LinearVelocity") 
                or obj:IsA("AngularVelocity")
                or obj:IsA("VectorForce") 
                or obj:IsA("Torque") then
                pcall(function() obj:Destroy() end)
            end
        end
    end
    
    -- ═══ Защита 2: убираем CanCollide у чужих ═══
    if AntiFling.DisableEnemyCollide then
        for _, other in ipairs(Players:GetPlayers()) do
            if other ~= LocalPlayer then
                local oChar = SafeGetCharacter(other)
                if oChar then
                    for _, part in ipairs(oChar:GetChildren()) do
                        if part:IsA("BasePart") and part.CanCollide then
                            part.CanCollide = false
                            -- Обнуляем скорость HRP чужого
                            if part.Name == "HumanoidRootPart" then
                                part.Velocity = Vector3.zero
                                part.RotVelocity = Vector3.zero
                            end
                        end
                    end
                end
            end
        end
    end
    
    -- ═══ Защита 3: сброс своей скорости при спайке ═══
    if AntiFling.ResetVelocity and hrp then
        local vel = hrp.AssemblyLinearVelocity or hrp.Velocity
        local rot = hrp.AssemblyAngularVelocity or hrp.RotVelocity
        
        if vel and vel.Magnitude > AntiFling.MaxVelocity then
            pcall(function()
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.Velocity = Vector3.zero
            end)
        end
        
        if rot and rot.Magnitude > AntiFling.MaxVelocity then
            pcall(function()
                hrp.AssemblyAngularVelocity = Vector3.zero
                hrp.RotVelocity = Vector3.zero
            end)
        end
    end
    
    -- ═══ Защита 4: если стоим на месте но двигаемся — фикс ═══
    if hum and hrp then
        local humanoidVel = hrp.Velocity
        if humanoidVel and humanoidVel.Magnitude > 1000 then
            pcall(function()
                hrp.CFrame = CFrame.new(hrp.Position)
                hrp.Velocity = Vector3.zero
                hrp.RotVelocity = Vector3.zero
            end)
        end
    end
end)

