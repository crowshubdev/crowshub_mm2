-- SILENT AIM + FORCE SHOOT v2 (ИСПРАВЛЕННЫЙ)
-- ═══════════════════════════════════════════════════════════════

local SilentSystem = {
    Enabled = false,
    Predict = true,
    ForceShoot = false,
    StandOff = 15,
    Target = "Murderer"
}

local weapon_service = nil
local orig_mouse = nil
local orig_screen = nil
local hook_mouse = nil
local hook_screen = nil

local function get_weapon_service()
    if weapon_service then return weapon_service end
    local ok, m = pcall(function()
        return require(ReplicatedStorage:WaitForChild("ClientServices"):WaitForChild("WeaponService"))
    end)
    if ok and type(m) == "table" then weapon_service = m end
    return weapon_service
end

local function get_target_player()
    if SilentSystem.Target == "Murderer" then
        return GetMurderer()
    elseif SilentSystem.Target == "Sheriff" then
        return GetSheriff()
    else
        local closest, minDist = nil, math.huge
        local myHRP = SafeGetHRP(SafeGetCharacter(LocalPlayer))
        if myHRP then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    local pHRP = SafeGetHRP(SafeGetCharacter(p))
                    if pHRP then
                        local d = (pHRP.Position - myHRP.Position).Magnitude
                        if d < minDist then minDist = d closest = p end
                    end
                end
            end
        end
        return closest
    end
end

local function get_aim_cframe()
    local target = get_target_player()
    if not target then return nil end
    local tChar = SafeGetCharacter(target)
    if not tChar then return nil end

    local part = tChar:FindFirstChild("Head")
        or tChar:FindFirstChild("UpperTorso")
        or tChar:FindFirstChild("Torso")
        or tChar:FindFirstChild("HumanoidRootPart")

    if not part then return nil end

    local pos = part.Position

    if SilentSystem.Predict then
        local hum = SafeGetHumanoid(tChar)
        if hum then
            local vel = hum.RootPart and hum.RootPart.AssemblyLinearVelocity or Vector3.zero
            local ping = LocalPlayer:GetNetworkPing() or 0
            if ping > 1 then ping = ping / 1000 end
            pos = pos + vel * (ping + 0.05)
        end
    end

    return CFrame.new(pos)
end

-- ═══════════════════════════════════════════════════════════════
-- FORCE SHOOT — ИСПРАВЛЕННАЯ ЛОГИКА
-- ═══════════════════════════════════════════════════════════════

local function gun_attachment()
    local char = SafeGetCharacter(LocalPlayer)
    local hrp = SafeGetHRP(char)
    if not hrp then return nil end
    return hrp:FindFirstChild("GunRaycastAttachment")
end

local force_att = nil
local force_saved = nil

local function restore_origin()
    local att = force_att
    if not att then return end
    local saved = force_saved
    force_att = nil
    force_saved = nil
    if saved then
        pcall(function()
            if att.Parent then att.WorldCFrame = saved end
        end)
    end
end

local function push_origin(cf)
    local att = gun_attachment()
    if not att then return false end

    if force_att and force_att ~= att then restore_origin() end

    if not force_att then
        local ok, saved = pcall(function() return att.WorldCFrame end)
        if not ok then return false end
        force_att = att
        force_saved = saved
    end

    local ok = pcall(function() att.WorldCFrame = cf end)
    if not ok then
        restore_origin()
        return false
    end

    task.defer(restore_origin)
    return true
end

local function los_clear(origin, point)
    if not origin or not point then return false end
    local delta = point - origin
    local dist = delta.Magnitude
    if dist < 0.5 then return true end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LocalPlayer.Character }

    local hit = workspace:Raycast(origin, delta, params)
    if not hit then return true end

    local target = get_target_player()
    local tChar = target and SafeGetCharacter(target)
    if hit.Instance and tChar and (hit.Instance == tChar or hit.Instance:IsDescendantOf(tChar)) then
        return true
    end

    return (hit.Position - origin).Magnitude >= dist - 0.75
end

-- ИСПРАВЛЕНО: origin ВПЕРЁД от меня (а не сзади от цели)
local function resolve_force()
    local target = get_target_player()
    if not target then return nil end

    local tChar = SafeGetCharacter(target)
    local tPart = tChar and SafeGetHRP(tChar)
    if not tPart then return nil end

    local live = tPart.Position
    local myChar = SafeGetCharacter(LocalPlayer)
    local myHRP = SafeGetHRP(myChar)
    if not myHRP then return nil end

    local myPos = myHRP.Position
    local dir = (live - myPos)
    if dir.Magnitude < 1 then return nil end
    dir = dir.Unit

    -- Ищем точку ВПЕРЁД от меня, откуда видно цель
    local best_origin = nil
    local test_distances = { 50, 40, 30, 20, 15, 10, 8, 6, 4 }
    
    for _, d in ipairs(test_distances) do
        local test_origin = myPos + dir * d
        
        -- Только если точка не за целью
        if (test_origin - live).Magnitude > 2 then
            if los_clear(test_origin, live) then
                best_origin = test_origin
                break
            end
        end
    end

    if not best_origin then
        -- Fallback: около цели
        best_origin = live - dir * 2
    end

    return CFrame.new(best_origin, live), CFrame.new(live)
end

-- ═══════════════════════════════════════════════════════════════
-- HOOKS
-- ═══════════════════════════════════════════════════════════════

local function install_silent_hooks()
    local m = get_weapon_service()
    if not m then return end

    if not hook_mouse then
        hook_mouse = function(self, ...)
            if SilentSystem.Enabled then
                local cf = get_aim_cframe()
                if cf then return cf end
            end
            return orig_mouse(self, ...)
        end

        hook_screen = function(self, x, y, ...)
            if SilentSystem.Enabled then
                local cf = get_aim_cframe()
                if cf then return cf end
            end
            return orig_screen(self, x, y, ...)
        end
    end

    pcall(function() setreadonly(m, false) end)

    if type(m.GetMouseTargetCFrame) == "function" and m.GetMouseTargetCFrame ~= hook_mouse then
        orig_mouse = m.GetMouseTargetCFrame
        pcall(function() m.GetMouseTargetCFrame = hook_mouse end)
    end

    if type(m.GetTargetPosition) == "function" and m.GetTargetPosition ~= hook_screen then
        orig_screen = m.GetTargetPosition
        pcall(function() m.GetTargetPosition = hook_screen end)
    end
end

local function remove_silent_hooks()
    local m = weapon_service
    if m then
        pcall(function() setreadonly(m, false) end)
        if orig_mouse then pcall(function() m.GetMouseTargetCFrame = orig_mouse end) end
        if orig_screen then pcall(function() m.GetTargetPosition = orig_screen end) end
    end
end

-- ═══════════════════════════════════════════════════════════════
-- DO SHOOT — ВСЕГДА РАБОТАЕТ
-- ═══════════════════════════════════════════════════════════════

local function doShoot()
    local char = SafeGetCharacter(LocalPlayer)
    if not char then return false end

    local gun = char:FindFirstChild("Gun")
    if not gun then
        local bp = LocalPlayer:FindFirstChild("Backpack")
        gun = bp and bp:FindFirstChild("Gun")
        if gun then
            local hum = SafeGetHumanoid(char)
            if hum then
                hum:EquipTool(gun)
                task.wait(0.2)
                gun = char:FindFirstChild("Gun")
            end
        end
    end

    if not gun or not gun.Parent then return false end

    -- ВСЕГДА включаем Silent Aim хук
    local was_silent = SilentSystem.Enabled
    SilentSystem.Enabled = true
    install_silent_hooks()
    task.wait(0.05)

    if SilentSystem.ForceShoot then
        local origin_cf, aim_cf = resolve_force()
        if origin_cf and aim_cf then
            push_origin(origin_cf)
            pcall(function() gun:Activate() end)
            task.wait(0.15)
        else
            pcall(function() gun:Activate() end)
            task.wait(0.15)
        end
    else
        pcall(function() gun:Activate() end)
        task.wait(0.15)
    end

    SilentSystem.Enabled = was_silent
    if not was_silent then 
        task.wait(0.05)
        remove_silent_hooks() 
    end

    return true
end

