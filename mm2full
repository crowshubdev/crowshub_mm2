local FlingSystem = {
    Running = false,
    Conn = nil,
    Target = nil,
}

local function stopFling()
    FlingSystem.Running = false
    FlingSystem.Target = nil
    if FlingSystem.Conn then
        FlingSystem.Conn:Disconnect()
        FlingSystem.Conn = nil
    end
    local myHRP = SafeGetHRP(SafeGetCharacter(LocalPlayer))
    if myHRP then
        myHRP.AssemblyAngularVelocity = Vector3.zero
    end
end

local function startFling(plr)
    if not plr then
        Notify("Fling", "Цель не выбрана", nil, 3)
        return
    end
    if plr == LocalPlayer then
        Notify("Fling", "Нельзя флинговать себя", nil, 3)
        return
    end

    stopFling()
    FlingSystem.Running = true
    FlingSystem.Target = plr

    FlingSystem.Conn = RunService.Heartbeat:Connect(function()
        if not FlingSystem.Running then return end
        local tChar = SafeGetCharacter(plr)
        local tHRP = tChar and tChar:FindFirstChild("HumanoidRootPart")
        local myChar = SafeGetCharacter(LocalPlayer)
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        if not (tHRP and myHRP and myHum) or myHum.Health <= 0 then
            stopFling()
            return
        end
        -- телепорт на цель + спин: столкновение флингует
        myHRP.CFrame = tHRP.CFrame * CFrame.Angles(0, math.rad(math.random(0, 359)), 0)
        myHRP.AssemblyAngularVelocity = Vector3.new(
            math.random(-900000, 900000),
            math.random(-900000, 900000),
            math.random(-900000, 900000)
        )
    end)

    Notify("Fling", "Флинг: " .. plr.Name, nil, 3)
end

