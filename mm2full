-- РАБОЧАЯ ФУНКЦИЯ СТРЕЛЬБЫ (использует WeaponService hook)
local function ShootAtMurderer()
    local murderer = GetMurderer()
    if not murderer then
        Notify("Combat", "No murderer found!", nil, 3)
        return
    end
    local char = SafeGetCharacter(LocalPlayer)
    if not char then return end
    
    -- Ищем пистолет
    local gun = char:FindFirstChild("Gun")
    local from_backpack = false
    if not gun then
        local bp = LocalPlayer:FindFirstChild("Backpack")
        gun = bp and bp:FindFirstChild("Gun")
        from_backpack = true
    end
    
    if not gun then
        Notify("Combat", "No gun! Wait for Sheriff to die.", nil, 4)
        return
    end
    
    -- Экипируем если в бекпаке
    if from_backpack then
        local hum = SafeGetHumanoid(char)
        if hum then
            hum:EquipTool(gun)
            task.wait(0.3)
            gun = char:FindFirstChild("Gun")
        end
    end
    
    if not gun or not gun.Parent then
        Notify("Combat", "Failed to equip gun!", nil, 3)
        return
    end
    
    -- ВРЕМЕННО включаем silent aim чтобы выстрел пошёл в цель
    local was_enabled = SilentAimEnabled
    local was_target = SilentAimTarget
    
    SilentAimEnabled = true
    SilentAimTarget = "Murderer"
    install_silent_hooks()
    
    -- Стреляем
    pcall(function() gun:Activate() end)
    
    task.wait(0.15)
    
    -- Возвращаем как было
    SilentAimEnabled = was_enabled
    SilentAimTarget = was_target
    if not was_enabled then
        remove_silent_hooks()
    end
    
    Notify("Combat", "Fired at " .. murderer.Name .. "!", nil, 3)
end

