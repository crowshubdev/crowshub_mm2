-- AUTO CLEAN (чистит старые трупы/детали с карты — только у тебя,
-- сервер не трогается; помогает от лагов и мусора на экране)
-- ═══════════════════════════════════════════════════════════════
local cleanOn = false
local cleanInterval = 60

local function cleanOldStuff()
    local n = 0
    pcall(function()
        local myChar = getChar(LocalPlayer)
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj:IsA("Model") and obj ~= myChar then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health <= 0 then
                    -- мёртвый персонаж (труп) — убираем локально
                    obj:Destroy()
                    n = n + 1
                elseif not hum and obj:FindFirstChild("HumanoidRootPart") then
                    -- старый клон персонажа без гуманоида
                    local p = Players:FindFirstChild(obj.Name)
                    if p and p.Character ~= obj then
                        obj:Destroy()
                        n = n + 1
                    end
                end
            end
        end
    end)
    return n
end

task.spawn(function()
    while getgenv().CWH_RUN do
        if cleanOn then
            local n = cleanOldStuff()
            if n > 0 then Notify("Auto Clean", "🧹 Убрано деталей: " .. n, nil, 2) end
            -- спим интервал (с ранним выходом, если выключили)
            local slept = 0
            while slept < cleanInterval and cleanOn and getgenv().CWH_RUN do
                task.wait(0.5)
                slept = slept + 0.5
            end
        else
            -- ФИКС зависания: когда выключено — ОБЯЗАТЕЛЬНО ждём,
            -- иначе цикл крутится без единого task.wait и вешает поток
            task.wait(1)
        end
    end
end)

