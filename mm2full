-- Wallbang via metatable hook
local mt = getrawmetatable(game)
if mt then
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if WallbangEnabled and method == "FireServer" and self:IsA("RemoteEvent") then
            local name = self.Name:lower()
            if name:find("gun") or name:find("shoot") or name:find("fire") or name:find("bullet") or name:find("hit") or name:find("shootgun") then
                local murderer = GetMurderer()
                if murderer then
                    local mChar = SafeGetCharacter(murderer)
                    local mHead = mChar and mChar:FindFirstChild("Head")
                    if mHead then
                        local args = {...}
                        if #args > 0 then
                            if typeof(args[1]) == "Vector3" then
                                args[1] = mHead.Position
                            elseif typeof(args[1]) == "CFrame" then
                                args[1] = mHead.CFrame
                            elseif typeof(args[1]) == "table" and args[1].Position then
                                args[1].Position = mHead.Position
                            elseif typeof(args[1]) == "Instance" and args[1]:IsA("BasePart") then
                                args[1] = mHead
                            end
                        end
                        return oldNamecall(self, unpack(args))
                    end
                end
            end
        end
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)
end

