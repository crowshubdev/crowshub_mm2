-- Создать Highlight для игрока
local function createPlayerHighlight(player)
    local char = SafeGetCharacter(player)
    if not char then return end
    if char:FindFirstChild("CrowsESP_HL") then return end
    
    local hl = Instance.new("Highlight")
    hl.Name = "CrowsESP_HL"
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillTransparency = 0.6
    hl.OutlineTransparency = 0.2
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.Parent = char
end

-- Создать Billboard с именем
local function createPlayerNameTag(player)
    local char = SafeGetCharacter(player)
    if not char then return end
    local hrp = SafeGetHRP(char)
    if not hrp then return end
    if hrp:FindFirstChild("CrowsNameESP") then return end
    
    local bg = Instance.new("BillboardGui")
    bg.Name = "CrowsNameESP"
    bg.Adornee = hrp
    bg.Size = UDim2.new(0, 200, 0, 50)
    bg.StudsOffset = Vector3.new(0, 3, 0)
    bg.AlwaysOnTop = true
    bg.Parent = hrp
    
    local text = Instance.new("TextLabel")
    text.Name = "Label"
    text.BackgroundTransparency = 1
    text.Size = UDim2.new(1, 0, 1, 0)
    text.TextSize = 14
    text.Font = Enum.Font.GothamBold
    text.TextColor3 = Color3.fromRGB(255, 255, 255)
    text.TextStrokeTransparency = 0
    text.TextStrokeColor3 = Color3.new(0, 0, 0)
    text.Text = ""
    text.Parent = bg
end

-- Обновление ESP
local function updateESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        
        local char = SafeGetCharacter(plr)
        if not char then continue end
        
        -- Определяем цвет и роль
        local role = GetRole(plr)
        local roleColor = GetRoleColor(role)
        local roleName = role
        
        -- Highlight
        if ESPConfig.Players then
            createPlayerHighlight(plr)
            local hl = char:FindFirstChild("CrowsESP_HL")
            if hl then
                hl.FillColor = roleColor
                hl.OutlineColor = roleColor
                hl.Enabled = true
            end
        else
            local hl = char:FindFirstChild("CrowsESP_HL")
            if hl then hl.Enabled = false end
        end
        
        -- NameTag
        if ESPConfig.Names or ESPConfig.Distance then
            createPlayerNameTag(plr)
            local hrp = SafeGetHRP(char)
            local bg = hrp and hrp:FindFirstChild("CrowsNameESP")
            if bg then
                bg.Enabled = true
                local label = bg:FindFirstChild("Label")
                if label then
                    local text = ""
                    if ESPConfig.Names then
                        text = plr.Name .. " [" .. roleName .. "]"
                    end
                    if ESPConfig.Distance then
                        local myHRP = SafeGetHRP(SafeGetCharacter(LocalPlayer))
                        if myHRP and hrp then
                            local dist = math.floor((myHRP.Position - hrp.Position).Magnitude)
                            if text ~= "" then text = text .. "\n" end
                            text = text .. dist .. " studs"
                        end
                    end
                    label.Text = text
                    label.TextColor3 = roleColor
                end
            end
        else
            local hrp = SafeGetHRP(char)
            local bg = hrp and hrp:FindFirstChild("CrowsNameESP")
            if bg then bg.Enabled = false end
        end
    end
end

-- Cleanup при выходе игрока
local function cleanupPlayer(player)
    local char = SafeGetCharacter(player)
    if char then
        local hl = char:FindFirstChild("CrowsESP_HL")
        if hl then hl:Destroy() end
        local hrp = SafeGetHRP(char)
        if hrp then
            local bg = hrp:FindFirstChild("CrowsNameESP")
            if bg then bg:Destroy() end
        end
    end
end

-- Главный loop
RunService.RenderStepped:Connect(function()
    if ESPConfig.Players or ESPConfig.Names or ESPConfig.Distance then
        pcall(updateESP)
    end
end)

Players.PlayerRemoving:Connect(cleanupPlayer)

