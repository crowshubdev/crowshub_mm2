-- ═══ [v1.10] BULLET TRACER (ядро трейсеров из Pulse): летящая «голова» пули + хвост ═══
-- Голова трейсера летит от origin к цели со скоростью Speed (st/s), за ней тянется
-- хвост; всё исчезает через Life секунд. Цвет/толщина/стиль — в Combat.
local TR = { On = false, Life = 1.2, Width = 100, Speed = 520, Rainbow = false,
             Style = "Energy", ColorName = "Красный", Tail = 30, Kind = "Pulse (полёт)" }
local TR_COLORS = {
    ["Красный"] = Color3.fromRGB(255, 80, 80), ["Зелёный"] = Color3.fromRGB(80, 255, 120),
    ["Синий"] = Color3.fromRGB(80, 140, 255), ["Белый"] = Color3.fromRGB(240, 240, 240),
    ["Жёлтый"] = Color3.fromRGB(255, 220, 60), ["Оранжевый"] = Color3.fromRGB(255, 150, 50),
    ["Розовый"] = Color3.fromRGB(255, 90, 180), ["Фиолетовый"] = Color3.fromRGB(170, 90, 255),
}
local function cwhTracer(from, to)
    if not TR.On or not from or not to then return end
    task.spawn(function()
        pcall(function()
            local dist = (to - from).Magnitude
            if dist < 1 then return end
            local function mkPart(p)
                local pt = Instance.new("Part")
                pt.Anchored = true
                pt.CanCollide = false
                pt.CanQuery = false
                pt.CanTouch = false
                pt.CastShadow = false
                pt.Transparency = 1
                pt.Size = Vector3.new(0.05, 0.05, 0.05)
                pt.CFrame = CFrame.new(p)
                pt.Parent = workspace
                local at = Instance.new("Attachment")
                at.Parent = pt
                return pt, at
            end
            local headPart, headAtt = mkPart(from)
            local tailPart, tailAtt = mkPart(from)
            local beam = Instance.new("Beam")
            beam.Attachment0 = tailAtt
            beam.Attachment1 = headAtt
            beam.FaceCamera = true
            local w = math.clamp(TR.Width, 40, 250) / 100 * 0.35
            beam.Width0 = w
            beam.Width1 = w * 0.3
            if TR.Style == "Energy" then
                beam.LightEmission = 1
                beam.LightInfluence = 0
                beam.Brightness = 4
            end
            beam.Transparency = NumberSequence.new(0.15)
            local base = TR_COLORS[TR.ColorName] or TR_COLORS["Красный"]
            beam.Color = ColorSequence.new(base, base)
            beam.Parent = headPart
            local t0 = os.clock()
            local life = math.clamp(TR.Life, 0.3, 4)
            local tailLen = math.max(0.5, math.min(TR.Tail or 30, dist)) -- [v1.11] длина полосы
            local conn = nil

            if TR.Kind == "Shitaro (ретракт)" then
                -- [v1.12] стиль из shitaro: луч виден СРАЗУ, ширина нормализуется
                -- по дистанции до камеры (постоянная видимая толщина вдоль луча),
                -- в конце жизни — плавный ретракт с Sine-easing
                local cam = workspace.CurrentCamera
                local cp = cam and cam.CFrame.Position
                local d0 = cp and (cp - from).Magnitude or dist
                local d1 = cp and (cp - to).Magnitude or dist
                local k = math.clamp(TR.Width, 40, 250) / 100 * 0.035
                beam.Width0 = math.clamp(d0 * k, 0.05, 6)
                beam.Width1 = math.clamp(d1 * k, 0.05, 6)
                beam.Transparency = NumberSequence.new(0)
                headPart.CFrame = CFrame.new(to)
                tailPart.CFrame = CFrame.new(from:Lerp(to, math.clamp((dist - tailLen) / dist, 0, 1)))
                task.delay(life * 0.78, function()
                    pcall(function()
                        game:GetService("TweenService"):Create(beam,
                            TweenInfo.new(math.max(life * 0.22, 0.05),
                                Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                            { Width0 = 0, Width1 = 0 }):Play()
                    end)
                end)
            else
                -- [v1.10-1.11] стиль pulse: летящая голова-снаряд + хвост
                conn = RunService.Heartbeat:Connect(function()
                    local el = os.clock() - t0
                    local headT = math.min(1, el * TR.Speed / dist)
                    headPart.CFrame = CFrame.new(from:Lerp(to, headT))
                    local tailT = math.clamp((headT * dist - tailLen) / dist, 0, 1)
                    tailPart.CFrame = CFrame.new(from:Lerp(to, tailT))
                    if TR.Rainbow then
                        local hue = (el * 0.35) % 1
                        local c = Color3.fromHSV(hue, 1, 1)
                        beam.Color = ColorSequence.new(c, c)
                    end
                end)
            end
            task.delay(life, function()
                pcall(function() if conn then conn:Disconnect() end end)
                pcall(function() headPart:Destroy() end)
                pcall(function() tailPart:Destroy() end)
            end)
        end)
    end)
end

