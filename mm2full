local function ensureHL(plr)
    local c = getChar(plr)
    if not c then return end
    if not c:FindFirstChild("CWH_ESP") then
        local hl = Instance.new("Highlight")
        hl.Name = "CWH_ESP"
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillTransparency = 0.6
        hl.OutlineTransparency = 0.2
        hl.Parent = c
    end
    local hrp = getHRP(c)
    if hrp and not hrp:FindFirstChild("CWH_Tag") then
        local bg = Instance.new("BillboardGui")
        bg.Name = "CWH_Tag"
        bg.Adornee = hrp
        bg.Size = UDim2.new(0, 200, 0, 60)
        bg.StudsOffset = Vector3.new(0, 3, 0)
        bg.AlwaysOnTop = true
        bg.Parent = hrp
        local tx = Instance.new("TextLabel")
        tx.Name = "L"
        tx.BackgroundTransparency = 1
        tx.Size = UDim2.new(1, 0, 1, 0)
        tx.TextSize = 14
        tx.Font = Enum.Font.GothamBold
        tx.TextStrokeTransparency = 0
        tx.Text = ""
        tx.Parent = bg
    end
end

task.spawn(function()
    while task.wait(0.2) do
        if ESP.HL or ESP.Names or ESP.Dist or ESP.HP then
            pcall(function()
                local myHRP = getHRP(getChar(LocalPlayer))
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr == LocalPlayer then continue end
                    local c = getChar(plr)
                    if not c then continue end
                    local role = getRole(plr)
                    local color = ROLE_COLORS[role] or ROLE_COLORS.Unknown
                    ensureHL(plr)

                    local hl = c:FindFirstChild("CWH_ESP")
                    if hl then
                        hl.Enabled = ESP.HL
                        hl.FillColor = color
                        hl.OutlineColor = color
                    end

                    local hrp = getHRP(c)
                    local bg = hrp and hrp:FindFirstChild("CWH_Tag")
                    if bg then
                        bg.Enabled = ESP.Names or ESP.Dist or ESP.HP
                        local tx = bg:FindFirstChild("L")
                        if tx then
                            local lines = {}
                            if ESP.Names then table.insert(lines, plr.Name .. " [" .. role .. "]") end
                            if ESP.HP then
                                local h = getHum(c)
                                if h then table.insert(lines, "HP: " .. math.floor(h.Health)) end
                            end
                            if ESP.Dist and myHRP and hrp then
                                table.insert(lines, math.floor((myHRP.Position - hrp.Position).Magnitude) .. " studs")
                            end
                            tx.Text = table.concat(lines, "\n")
                            tx.TextColor3 = color
                        end
                    end
                end
            end)
        end
    end
end)

