-- ═══════════════════════════════════════════════════════════════
-- BOMB JUMP (метод Pulse: прыжок от игрушки FakeBomb)
-- ═══════════════════════════════════════════════════════════════
local bombJumpOn = false

local function bombJumpVel()
    local c = getChar(LocalPlayer)
    local hum = getHum(c)
    local hrp = getHRP(c)
    if not (hum and hrp and hum.Health > 0) then return end
    local v
    if hum.UseJumpPower == false then
        v = math.sqrt(2 * (workspace.Gravity or 196.2) * math.max(hum.JumpHeight or 7.2, 1))
    else
        v = math.max(hum.JumpPower or 50, 50)
    end
    local vel = hrp.AssemblyLinearVelocity
    hrp.AssemblyLinearVelocity = Vector3.new(vel.X, v, vel.Z)
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
end

local function bombFind()
    local c = getChar(LocalPlayer)
    if c then
        local t = c:FindFirstChild("FakeBomb")
        if t then return t end
    end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        local toys = bp:FindFirstChild("Toys")
        local t = (toys and toys:FindFirstChild("FakeBomb")) or bp:FindFirstChild("FakeBomb")
        if t then return t end
    end
    return nil
end

-- тоггл: активация бомбы → подпрыгиваем (взрыв подкидывает выше)
task.spawn(function()
    local function hookTool(char)
        if not char then return end
        local function h(t)
            if t:IsA("Tool") and t.Name == "FakeBomb" then
                t.Activated:Connect(function()
                    if bombJumpOn then pcall(bombJumpVel) end
                end)
            end
        end
        for _, t in ipairs(char:GetChildren()) do h(t) end
        char.ChildAdded:Connect(h)
    end
    if getChar(LocalPlayer) then hookTool(getChar(LocalPlayer)) end
    LocalPlayer.CharacterAdded:Connect(function(ch)
        task.wait(0.3)
        hookTool(ch)
    end)
end)

-- авто: сам ставит бомбу под собой и прыгает от взрыва
local function autoBombJump()
    local c = getChar(LocalPlayer)
    local hrp = getHRP(c)
    if not (c and hrp) then return end
    local bomb = bombFind()
    if not bomb then
        Notify("Bomb Jump", "Нет FakeBomb — нужна игрушка-бомба", nil, 4)
        return
    end
    if bomb.Parent ~= c then
        pcall(function() bomb.Parent = c end)
        task.wait(0.08)
        bomb = bombFind()
        if not bomb then return end
    end
    pcall(function()
        local handle = bomb:FindFirstChild("Handle")
        local hand = c:FindFirstChild("RightHand") or c:FindFirstChild("Right Arm")
        if handle and hand and not hand:FindFirstChild("RightGrip") then
            handle.Anchored = false
            local w = Instance.new("Weld")
            w.Name = "RightGrip"
            w.Part0 = hand
            w.Part1 = handle
            w.C0 = (hand.Name == "RightHand") and CFrame.new(0, -0.1, 0)
                or CFrame.new(0, -1.0, 0) * CFrame.Angles(-1.5707963267948966, 0, 0)
            w.C1 = bomb.Grip
            w.Parent = hand
