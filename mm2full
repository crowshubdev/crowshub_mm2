do -- ═══ [CWH SCOPE] G9f: Animations (эмоции + ходьба/прыжок) ═══
-- [v1.8] Эмоции: список берём У ИГРЫ — require(ReplicatedStorage.Database.Sync).Emotes
-- (так делает и новый Pulse). Эмоция играет треком приоритета Action4 с Looped=true —
-- значит НЕ прерывается ходьбой и прыжками, пока тоггл Play Emote не выключишь.
-- Ходьба/прыжок: подмена AnimationId внутри Animate-скрипта персонажа + перезапуск.
local anim = { Emote = nil, EmoteOn = false, CustomEmoteId = "", WalkId = "", JumpId = "" }
local emoteTrack = nil
local syncEmotes = nil
-- [v1.9] пресеты эмоций (проверенные UGC-эмоты каталога):
-- Get Griddy 121966805049108, Griddy 106715239721951, Griddy Dance 139951283663754, Get Sturdy 117695604334759
local PRESET_EMOTES = {
    ["🔥 Griddy (Get Griddy)"] = "121966805049108",
    ["🔥 Griddy 2 (Animations World)"] = "106715239721951",
    ["🔥 Griddy Dance"] = "139951283663754",
    ["🔥 Get Sturdy"] = "117695604334759",
}
local emoteNames = {
    "Custom (ID)",
    "🔥 Griddy (Get Griddy)",
    "🔥 Griddy 2 (Animations World)",
    "🔥 Griddy Dance",
    "🔥 Get Sturdy",
}

do
    local ok, db = pcall(function()
        return ReplicatedStorage:FindFirstChild("Database") or ReplicatedStorage:WaitForChild("Database", 5)
    end)
    if ok and db then
        local ok2, sync = pcall(function()
            return require(db:FindFirstChild("Sync") or db:WaitForChild("Sync", 5))
        end)
        if ok2 and type(sync) == "table" and type(sync.Emotes) == "table" then
            syncEmotes = sync.Emotes
            local names = {}
            for name, data in pairs(syncEmotes) do
                if type(data) == "table" and (data.AnimationID or data.Command) then
                    names[#names + 1] = name
                end
            end
            table.sort(names)
            for _, n in ipairs(names) do emoteNames[#emoteNames + 1] = n end
        end
    end
end

local function stopEmote()
    if emoteTrack then
        pcall(function() emoteTrack:Stop(0.15) end)
        emoteTrack = nil
    end
end

local function playEmote(value)
    stopEmote()
    local char = getChar(LocalPlayer)
    local hum = getHum(char)
    if not hum then
        Notify("Emote", "Нет персонажа", nil, 3)
        return
    end
    local id = nil
    if value == "Custom (ID)" then
        id = anim.CustomEmoteId
    elseif PRESET_EMOTES[value] then
        id = PRESET_EMOTES[value]
    else
        local data = syncEmotes and syncEmotes[value]
        if data and data.AnimationID then
            id = tostring(data.AnimationID):match("%d+") or tostring(data.AnimationID)
        else
            local animate = char:FindFirstChild("Animate")
            local cmd = data and data.Command or value
            local folder = animate and animate:FindFirstChild(tostring(cmd))
            local a = folder and folder:FindFirstChildOfClass("Animation")
            id = a and a.AnimationId:match("%d+") or nil
        end
    end
    if not id or id == "" then
        Notify("Emote", "Нет ID анимации — выбери эмоцию или впиши ID", nil, 3)
        return
    end
    local animator = hum:FindFirstChildOfClass("Animator") or hum
    local a = Instance.new("Animation")
    a.AnimationId = "rbxassetid://" .. id
    local ok, tr = pcall(function() return animator:LoadAnimation(a) end)
    if not ok or not tr then
        Notify("Emote", "Анимация не загрузилась", nil, 3)
        return
    end
    pcall(function() tr.Priority = Enum.AnimationPriority.Action4 end) -- как в новом Pulse
    pcall(function() tr.Looped = true end) -- эмоция не прервётся, пока не выключишь тоггл
    emoteTrack = tr
    pcall(function() tr:Play(0.1) end)
end

