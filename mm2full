----------------------------------------------------------------
-- Stats Live Update Loop
----------------------------------------------------------------
task.spawn(function()
    while task.wait(1) do
        local now = os.time()
        local diff = now - Stats.StartTime

        local days = math.floor(diff / 86400)
        local hours = math.floor((diff % 86400) / 3600)
        local minutes = math.floor((diff % 3600) / 60)
        local seconds = diff % 60

        DaysLbl.Text = "  Days: " .. tostring(days)
        HoursLbl.Text = "  Hours: " .. tostring(hours)
        MinutesLbl.Text = "  Minutes: " .. tostring(minutes)
        SecondsLbl.Text = "  Seconds: " .. tostring(seconds)

        local coinData = LocalPlayer:FindFirstChild("CoinData") or LocalPlayer:FindFirstChild("leaderstats")
        local currentCoins = coinData and coinData:FindFirstChild("Coins") and coinData.Coins.Value or 0

        if Stats.LastCoinsValue == 0 then
            Stats.LastCoinsValue = currentCoins
        elseif currentCoins > Stats.LastCoinsValue then
            Stats.CoinsEarned = Stats.CoinsEarned + (currentCoins - Stats.LastCoinsValue)
            Stats.LastCoinsValue = currentCoins
        elseif currentCoins < Stats.LastCoinsValue then
            Stats.LastCoinsValue = currentCoins
        end

        local coinsPerHour = 0
        if diff > 0 then
            coinsPerHour = math.floor((Stats.CoinsEarned / diff) * 3600)
        end

        EarnedLbl.Text = "Total Earned: " .. tostring(Stats.CoinsEarned) .. " Coins / " .. tostring(coinsPerHour) .. " Per Hour"
    end
end)

