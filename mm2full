    Description = "Teleport to selected target instantly",
    Callback = function()
        local hrp = SafeGetHRP(SafeGetCharacter(LocalPlayer))
        if not hrp then Notify("Teleport", "Character not loaded!", nil, 3) return end

        if TeleportTarget == "Lobby" then
            local lobby = workspace:FindFirstChild("Lobby") or workspace:FindFirstChild("lobby")
            if lobby and lobby:IsA("BasePart") then
                hrp.CFrame = lobby.CFrame + Vector3.new(0, 5, 0)
            else
                hrp.CFrame = CFrame.new(0, 100, 0)
            end
            Notify("Teleport", "Teleported to Lobby!", nil, 3)
        elseif TeleportTarget == "Map Spawn" then
            local spawns = {}
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("SpawnLocation") then table.insert(spawns, obj) end
            end
            if #spawns > 0 then
                hrp.CFrame = spawns[math.random(1, #spawns)].CFrame + Vector3.new(0, 5, 0)
                Notify("Teleport", "Teleported to Map Spawn!", nil, 3)
            else
                Notify("Teleport", "No spawn locations found!", nil, 3)
            end
        elseif TeleportTarget == "Murderer" then
            local m = GetMurderer()
            local mHRP = m and SafeGetHRP(SafeGetCharacter(m))
            if mHRP then
                hrp.CFrame = mHRP.CFrame + Vector3.new(0, 3, 0)
                Notify("Teleport", "Teleported to Murderer: " .. m.Name, nil, 3)
            else
                Notify("Teleport", "No murderer found!", nil, 3)
            end
        elseif TeleportTarget == "Sheriff" then
            local s = GetSheriff()
            local sHRP = s and SafeGetHRP(SafeGetCharacter(s))
            if sHRP then
                hrp.CFrame = sHRP.CFrame + Vector3.new(0, 3, 0)
                Notify("Teleport", "Teleported to Sheriff: " .. s.Name, nil, 3)
            else
                Notify("Teleport", "No sheriff found!", nil, 3)
            end
        elseif TeleportTarget == "Random Player" then
            local others = {}
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then table.insert(others, p) end
            end
            if #others > 0 then
                local target = others[math.random(1, #others)]
                local tHRP = SafeGetHRP(SafeGetCharacter(target))
                if tHRP then
                    hrp.CFrame = tHRP.CFrame + Vector3.new(0, 3, 0)
                    Notify("Teleport", "Teleported to: " .. target.Name, nil, 3)
                end
            else
                Notify("Teleport", "No other players!", nil, 3)
            end
        end
    end
