-- Auto Farm Loop (FIXED)
task.spawn(function()
    while true do
        if AutoFarm.Enabled then
            local char = SafeGetCharacter(LocalPlayer)
            local hrp = SafeGetHRP(char)
            if hrp then
                if AutoFarm.CollectedCoins >= AutoFarm.MaxCoins then
                    AutoFarm.Enabled = false
                    Notify("Farm", "Max coins reached! (" .. AutoFarm.MaxCoins .. ")", nil, 4)
                else
                    local coins = GetCoins()
                    local murderer = GetMurderer()
                    local mHRP = murderer and SafeGetHRP(SafeGetCharacter(murderer))
                    local bestCoin = nil
                    local bestDist = math.huge

                    for _, coin in pairs(coins) do
                        if coin and coin.Parent and coin:IsA("BasePart") then
                            local coinPos = coin.Position
                            local dist = (hrp.Position - coinPos).Magnitude

                            if AutoFarm.AvoidMurder and mHRP then
                                local murderDist = (mHRP.Position - coinPos).Magnitude
                                if murderDist < AutoFarm.AvoidRange then continue end
                            end

                            if dist < bestDist then
                                bestDist = dist
                                bestCoin = coin
                            end
                        end
                    end

                    if bestCoin then
                        local coinPos = bestCoin.Position
                        
                        if AutoFarm.CoinAura and bestDist <= AutoFarm.AuraRange then
                            hrp.CFrame = CFrame.new(coinPos.X, coinPos.Y + 2, coinPos.Z)
                            AutoFarm.CollectedCoins = AutoFarm.CollectedCoins + 1
                        elseif AutoFarm.Mode == "UnderMap" then
                            local underPos = Vector3.new(coinPos.X, -4, coinPos.Z)
                            local direction = (underPos - hrp.Position).Unit
                            hrp.CFrame = hrp.CFrame + direction * AutoFarm.Speed * 0.02
                            
                            if (hrp.Position - coinPos).Magnitude < 10 then
                                hrp.CFrame = CFrame.new(coinPos.X, coinPos.Y + 2, coinPos.Z)
                                task.wait(0.1)
                                AutoFarm.CollectedCoins = AutoFarm.CollectedCoins + 1
                            end
                        else
                            local targetPos = Vector3.new(coinPos.X, hrp.Position.Y, coinPos.Z)
                            local direction = (targetPos - hrp.Position).Unit
                            hrp.CFrame = hrp.CFrame + direction * AutoFarm.Speed * 0.02
                            
                            if (hrp.Position - coinPos).Magnitude < 5 then
                                AutoFarm.CollectedCoins = AutoFarm.CollectedCoins + 1
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.05)
    end
end)

