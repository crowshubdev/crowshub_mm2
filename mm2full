do -- ═══ [CWH SCOPE] G8: Invisibility — техн. обёртка (лимит 200 регистров Luau) ═══
-- ═══════════════════════════════════════════════════════════════
-- INVISIBILITY (метод Pulse: десинк под карту + призрак 50%)
--  • каждый кадр персонаж на миг улетает ГЛУБОКО под карту (выше
--    FallenPartsDestroyHeight), до отрисовки возвращается на место —
--    сервер/другие игроки тебя не видят, ты видишь себя призраком
-- ═══════════════════════════════════════════════════════════════
local invisOn = false
local invisKeyName = ""
local invParts = {}
local invRealCF, invRealHRP = nil, nil
local invDownPos, invNeedsRestore = nil, false
local invFlip = false
local invRC, invRCChar = nil, nil
local invVoidY = -400
pcall(function()
    local fdh = tonumber(workspace.FallenPartsDestroyHeight) or -500
    invVoidY = fdh + 15
end)

local function invScan()
    invParts = {}
    local c = getChar(LocalPlayer)
    if not c then return end
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") and p.Transparency == 0 then
            local near = (p.Name == "Head") or (p.Parent and p.Parent:IsA("Accessory")) or false
            invParts[#invParts + 1] = { p = p, near = near }
        end
    end
end

local function invGhostAll(alpha)
    pcall(function()
        for _, u in ipairs(invParts) do
            if u.p and u.p.Parent then
                u.p.LocalTransparencyModifier = alpha
            end
        end
    end)
end

local function invFirstPerson()
    local cam = workspace.CurrentCamera
    if not cam then return false, nil end
    local camPos = cam.CFrame.Position
    if LocalPlayer.CameraMode == Enum.CameraMode.LockFirstPerson then return true, camPos end
    local c = getChar(LocalPlayer)
    local h = c and c:FindFirstChild("Head")
    if h and (h.Position - camPos).Magnitude < 1.5 then return true, camPos end
    return false, camPos
end

local function invisOff(silent)
    if not invisOn then return end
    invisOn = false
    invGhostAll(0)
    local c = getChar(LocalPlayer)
    local hrp = getHRP(c)
    if hrp and hrp.Parent then
        if invRealHRP == hrp and invRealCF then
            pcall(function() hrp.CFrame = invRealCF end)
        end
        pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero end)
        pcall(function() hrp.AssemblyAngularVelocity = Vector3.zero end)
    end
    if not silent then
        Notify("Invisibility", "Выключена — ты снова виден", nil, 2)
        print("[CWH] Invisibility: OFF")
    end
end

local function invisToggle()
    task.spawn(function()
        if invisOn then
            invisOff()
        else
            local c = getChar(LocalPlayer)
            local hum = getHum(c)
            if not (hum and getHRP(c)) then
                Notify("Invisibility", "Нет персонажа", nil, 3)
                return
            end
            invScan()
            invisOn = true
            invGhostAll(0.5)
            Notify("Invisibility", "ВКЛ — другие тебя не видят", nil, 3)
            print("[CWH] Invisibility: ON (десинк Pulse)")
        end
    end)
end

-- респавн: пересобрать список частей
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    if invisOn then invScan() end
end)

if getgenv().CWH_InvisConn then
    pcall(function() getgenv().CWH_InvisConn:Disconnect() end)
end
getgenv().CWH_InvisConn = RunService.Heartbeat:Connect(function()
    if not invisOn or not getgenv().CWH_RUN then return end
    local ch = getChar(LocalPlayer)
    local hum = getHum(ch)
    local root = getHRP(ch)
    if not (hum and root and root.Parent) or hum.Health <= 0 then return end
    pcall(function()
        -- ферма двигает персонажа сама — не воюем с ней
        local farmRef = getgenv().CWH_FarmRef
        if farmRef and farmRef.Enabled then return end
        -- рейкаст "стоишь ли на земле" (для чередования глубины, как в Pulse)
        if not invRC then
            invRC = RaycastParams.new()
            invRC.FilterType = Enum.RaycastFilterType.Exclude
        end
        if invRCChar ~= ch then
            invRCChar = ch
            invRC.FilterDescendantsInstances = { ch }
        end
        local grounded = workspace:Raycast(root.Position, Vector3.new(0, -5, 0), invRC) ~= nil
        local moving = hum.MoveDirection.Magnitude > 0.01
        local cf = root.CFrame
        local targetY = invVoidY
        if grounded and not moving then
            invFlip = not invFlip
            if invFlip then targetY = invVoidY + 0.5 end
        end
        invRealCF = cf
        invRealHRP = root
        root.CFrame = cf * CFrame.new(0, targetY - cf.Y, 0)
        invDownPos = root.Position
        invNeedsRestore = true
    end)
