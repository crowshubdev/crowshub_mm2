-- Helper to Add Toggles
local function CreateToggle(text, settingName, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, -8, 0, 30)
    Btn.BackgroundColor3 = Settings[settingName] and Color3.fromRGB(35, 130, 55) or Themes[Settings.CurrentTheme].Button
    Btn.Text = text .. " " .. (Settings[settingName] and "[ON]" or "[OFF]")
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Btn.Font = Enum.Font.SourceSans
    Btn.TextSize = 14
    Btn.Parent = Container

    Btn:SetAttribute("IsToggleActive", Settings[settingName])
    table.insert(Themeable.Buttons, Btn)

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 5)
    Corner.Parent = Btn

    Btn.MouseButton1Click:Connect(function()
        Settings[settingName] = not Settings[settingName]
        Btn:SetAttribute("IsToggleActive", Settings[settingName])
        
        if Settings[settingName] then
            Btn.BackgroundColor3 = Color3.fromRGB(35, 130, 55)
        else
            Btn.BackgroundColor3 = Themes[Settings.CurrentTheme].Button
        end
        
        Btn.Text = text .. " " .. (Settings[settingName] and "[ON]" or "[OFF]")
        if callback then callback(Settings[settingName]) end
    end)
    return Btn
end

