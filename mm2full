local AntiAim = {
    Spin = false,
    SpinSpeed = 720,
    Jitter = false,
    JitterPower = 8,
    FaceAway = false,
    Rotation = 0,
    LastJitter = 0,
}

RunService.Heartbeat:Connect(function(dt)
    if not (AntiAim.Spin or AntiAim.Jitter or AntiAim.FaceAway) then return end
    if FarmSystem.Active then return end

    local char = SafeGetCharacter(LocalPlayer)
    local root = SafeGetHRP(char)
    local hum = SafeGetHumanoid(char)
    if not root or not hum or hum.Health <= 0 then return end

    if AntiAim.Spin then
        AntiAim.Rotation = (AntiAim.Rotation + AntiAim.SpinSpeed * dt) % 360
        root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, math.rad(AntiAim.Rotation), 0)
    end

    if AntiAim.Jitter then
        local now = os.clock()
        if now - AntiAim.LastJitter > 0.1 then
            AntiAim.LastJitter = now
            local yaw = math.random(-AntiAim.JitterPower, AntiAim.JitterPower)
            root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(yaw), 0)
        end
    end

    if AntiAim.FaceAway then
        local mur = GetMurderer()
        local mHRP = mur and SafeGetHRP(SafeGetCharacter(mur))
        if mHRP then
            local dir = (root.Position - mHRP.Position)
            dir = Vector3.new(dir.X, 0, dir.Z)
            if dir.Magnitude > 0.1 then
                root.CFrame = CFrame.new(root.Position, root.Position + dir.Unit)
            end
        end
    end
end)

