do -- ═══ [CWH SCOPE] G9b: Зеркало левой руки + Speed Glitch (Pulse) — техн. обёртка (лимит 200 регистров Luau) ═══
-- ── [v1.5] 1) ЛЕВАЯ РУКА = ЗЕРКАЛО ПРАВОЙ ──
-- Animator каждый кадр перезаписывает Motor6D.Transform, поэтому копируем Transform
-- правого плеча в левое ПОСЛЕ анимаций (RenderPriority.Character + 1):
-- левая рука встаёт ровно в ту же позу, что и правая (поднята с пушкой/ножом),
-- а зеркальный грип клона разворачивает второй пистолет/нож правильной стороной.
pcall(function() RunService:UnbindFromRenderStep("CWH_DualMirror") end)
getgenv().CWH_DualMirrorOn = false
-- [v1.6] ФИКСЫ (рука теперь РЕАЛЬНО поднимается):
-- 1) Enum.RenderPriority.Animations НЕ СУЩЕСТВУЕТ — из-за него весь G9b падал при
--    запуске: рука не поднималась, Speed Glitch и кнопка телефона не создавались.
-- 2) Простое копирование Transform было НЕВЕРНЫМ: у левого и правого плеча C0/C1
--    повёрнуты на ±90°, поэтому левому плечу нужен ЗЕРКАЛЬНЫЙ Transform (x → -x),
--    как у грипа клона оружия.
-- 3) Плюс поддержка R15 (там Motor6D зовутся RightShoulder/LeftShoulder без пробела).
local mirChar, mirRS, mirLS = nil, nil, nil
RunService:BindToRenderStep("CWH_DualMirror", Enum.RenderPriority.Character.Value + 1, function()
    if not getgenv().CWH_RUN or not getgenv().CWH_DualMirrorOn then return end
    pcall(function()
        local dchar = getChar(LocalPlayer)
        if dchar ~= mirChar then
            mirChar = dchar
            mirRS, mirLS = nil, nil
            if dchar then
                for _, d in ipairs(dchar:GetDescendants()) do
                    if d:IsA("Motor6D") then
                        if d.Name == "Right Shoulder" or d.Name == "RightShoulder" then
                            mirRS = d
                        elseif d.Name == "Left Shoulder" or d.Name == "LeftShoulder" then
                            mirLS = d
                        end
                    end
                end
            end
        end
        if mirRS and mirLS and mirRS.Parent and mirLS.Parent then
            local tx, ty, tz, r00, r01, r02, r10, r11, r12, r20, r21, r22 = mirRS.Transform:GetComponents()
            mirLS.Transform = CFrame.new(-tx, ty, tz,
                r00, -r01, -r02,
                -r10, r11, r12,
                -r20, r21, r22)
        end
    end)
end)

-- ── [v1.5] 2) SPEED GLITCH — точный порт механики из Pulse ──
-- Прыгнул → в воздухе скорость плавно разгоняется (AssemblyLinearVelocity по направлению
-- движения, WalkSpeed подтягивается на +6 сверху, как в оригинале). После приземления
-- буст живёт ещё 0.25с, если 0.3с простоял на земле — сброс. Лестницы/вода/сидя — сброс.
local SG = { On = false, Max = 120, Accel = 60, Cur = 0, LandAt = 0, Air = false }
getgenv().CWH_SGOn = false -- [v1.6] состояние Speed Glitch для кнопки телефона/кейбинда
local sgBaseWS = 16
local function sgReset(h)
    if SG.Cur ~= 0 or SG.Air then
        SG.Cur, SG.Air = 0, false
        if h and not WSOn and h.WalkSpeed > sgBaseWS then
            pcall(function() h.WalkSpeed = sgBaseWS end)
        end
    end
end
RunService.Heartbeat:Connect(function(dt)
    if not getgenv().CWH_RUN then return end
    local schar = getChar(LocalPlayer)
    local h = getHum(schar)
    local hrp = getHRP(schar)
    if not SG.On then sgReset(h) return end
    if not (h and hrp and h.Health > 0) then sgReset(h) return end
    local st = h:GetState()
    if st == Enum.HumanoidStateType.Climbing or st == Enum.HumanoidStateType.Swimming
        or st == Enum.HumanoidStateType.Seated or st == Enum.HumanoidStateType.Dead then
        sgReset(h) return
    end
    dt = math.min(dt or 0.0166, 0.1)
    local now = os.clock()
    local air = (st == Enum.HumanoidStateType.Freefall) or (st == Enum.HumanoidStateType.Jumping)
    local md = h.MoveDirection
    local k = Vector3.new(md.X, 0, md.Z)
    local moving = k.Magnitude > 0.1
    local v = hrp.AssemblyLinearVelocity
    local hv = Vector3.new(v.X, 0, v.Z)
    local spd = hv.Magnitude
    if air then
        SG.Air = true
        if moving then
            if SG.Cur < sgBaseWS then SG.Cur = sgBaseWS end
            if spd > SG.Cur and spd <= SG.Max then SG.Cur = spd end
            if SG.Cur < SG.Max then SG.Cur = math.min(SG.Max, SG.Cur + SG.Accel * dt) end
        end
    else
        if SG.Air then SG.Air, SG.LandAt = false, now end
        if now - SG.LandAt > 0.3 then sgReset(h) end
    end
    if SG.Cur > SG.Max then SG.Cur = SG.Max end
    -- WalkSpeed чуть выше буста (как в Pulse: +6), чтобы клиент не гасил скорость.
    -- Если включён тоггл WalkSpeed — не трогаем, он важнее (скорость даёт velocity).
    if SG.Cur > 0 and not WSOn and h.WalkSpeed < SG.Cur + 6 then
        pcall(function() h.WalkSpeed = SG.Cur + 6 end)
    end
    if SG.Cur > 0 and moving and (air or (now - SG.LandAt) <= 0.25) and spd < SG.Cur + 1 then
        local t = k.Unit * SG.Cur
        if (hv - t).Magnitude > 0.5 then
            hrp.AssemblyLinearVelocity = Vector3.new(t.X, v.Y, t.Z)
        end
    end
end)
Tabs.World:AddSection("Speed Glitch")
local function sgApply(v)
    SG.On = v
    getgenv().CWH_SGOn = v
    local h = getHum(getChar(LocalPlayer))
    if v then
        if h then sgBaseWS = h.WalkSpeed end
        SG.Cur, SG.Air, SG.LandAt = 0, false, 0
    else
        sgReset(h)
    end
end
local SGToggle = Tabs.World:AddToggle("SGlitchOn", {
    Title = "🏃 Speed Glitch",
    Description = "Прыгай и двигайся — разгон в воздухе (порт из Pulse)",
    Default = false
})
SGToggle:OnChanged(function(v) sgApply(v) end)

