-- TAB 5: AUTO FARM
-- Basic: стоишь вертикально, летаешь за монетами (15-90 speed)
-- Down: ЛОЖИШЬСЯ горизонтально и летишь под полом (-1..-9)
-- ═══════════════════════════════════════════════════════════════
local FarmSystem = {
    Enabled = false,
    Method = "Basic",
    UnderDepth = 5,      -- −1..−9
    AvoidMurder = true,
    SafeRadius = 45,
    FleeRadius = 30,
    Speed = 60,          -- 15-90
    CoinDelay = 0.15,
    Active = false,
    CurrentTween = nil,
    LastRerouteNotify = 0,
    PendingFlee = nil,
    WasLying = false,
}

local CoinAura = { Enabled = false, Radius = 12 }

local function coinPos(c)
    if c:IsA("BasePart") then return c.Position end
    local pp = c:FindFirstChildWhichIsA("BasePart", true)
    return pp and pp.Position or nil
end

local function farmGetCoins()
    local map = getMap()
    local container = map and map:FindFirstChild("CoinContainer")
    local list = {}
    if container then
        for _, c in ipairs(container:GetChildren()) do
            if coinPos(c) then table.insert(list, c) end
        end
    end
    return list
end

local function notifyReroute(reason)
    local now = os.clock()
    if now - FarmSystem.LastRerouteNotify > 2 then
        FarmSystem.LastRerouteNotify = now
        Notify("Auto Farm", reason, nil, 2)
    end
end

-- Лечь / встать: Down = персонаж лежит горизонтально
local function lieDown(hrp)
    if not hrp then return end
    local hum = SafeGetHumanoid(SafeGetCharacter(LocalPlayer))
    if hum then hum.PlatformStand = true end
    FarmSystem.WasLying = true
end

local function standUp(hrp)
    if not hrp then return end
    local hum = SafeGetHumanoid(SafeGetCharacter(LocalPlayer))
    if hum then hum.PlatformStand = false end
    if FarmSystem.WasLying then
        hrp.CFrame = CFrame.new(hrp.Position)
        FarmSystem.WasLying = false
    end
end

local function fleeFromMurderer(murPlr)
    local start = os.clock()
    while not getgenv().CWH_Unloaded
        and FarmSystem.Enabled
        and os.clock() - start < 12 do
        local myHRP = SafeGetHRP(SafeGetCharacter(LocalPlayer))
        local murHRP = murPlr and SafeGetHRP(SafeGetCharacter(murPlr))
        if not (myHRP and murHRP) then return end
        local dist = (murHRP.Position - myHRP.Position).Magnitude
        if dist >= FarmSystem.FleeRadius then return end
        local away = (myHRP.Position - murHRP.Position)
        away = Vector3.new(away.X, 0, away.Z)
        if away.Magnitude < 0.1 then away = Vector3.new(1, 0, 0) end
        away = away.Unit
        local fleePos = myHRP.Position + away * 20
        if FarmSystem.Method == "Down" then
            fleePos = Vector3.new(fleePos.X, myHRP.Position.Y, fleePos.Z)
            lieDown(myHRP)
        end
        local t = TweenService:Create(
            myHRP,
            TweenInfo.new(20 / FarmSystem.Speed, Enum.EasingStyle.Linear),
            { CFrame = CFrame.new(fleePos) }
        )
        t:Play()
        local waited = 0
        while t.PlaybackState == Enum.PlaybackState.Playing
            and waited < 1 and not getgenv().CWH_Unloaded do
            task.wait(0.05)
            waited = waited + 0.05
            local m2 = SafeGetHRP(SafeGetCharacter(murPlr))
            local me2 = SafeGetHRP(SafeGetCharacter(LocalPlayer))
            if m2 and me2 and (m2.Position - me2.Position).Magnitude < FarmSystem.FleeRadius * 0.7 then
                t:Cancel()
                break
            end
        end
        t:Cancel()
    end
end

local function farmGoTo(coin)
    local root = SafeGetHRP(SafeGetCharacter(LocalPlayer))
    if not root then return end
    local pos = coinPos(coin)
    if not pos then return end

    local targetPos = pos
    if FarmSystem.Method == "Down" then
        -- лёжа под полом на глубине −depth (−1..−9)
        targetPos = Vector3.new(pos.X, pos.Y - FarmSystem.UnderDepth, pos.Z)
        lieDown(root)
    else
        -- Basic: стоим вертикально
        standUp(root)
    end

    local dist = (targetPos - root.Position).Magnitude
    local travelTime = math.max(dist / FarmSystem.Speed, 0.1)
    local tween = TweenService:Create(
        root,
        TweenInfo.new(travelTime, Enum.EasingStyle.Linear),
        { CFrame = CFrame.new(targetPos) }
    )
    FarmSystem.CurrentTween = tween
    tween:Play()

    local stop = false
    local conn
    conn = RunService.Heartbeat:Connect(function()
        local r = SafeGetHRP(SafeGetCharacter(LocalPlayer))
        if not r or not coin.Parent then
            stop = true
            return
        end
        local p = coinPos(coin)
        if not p then
            stop = true
            return
        end

        -- в Down режиме важна горизонтальная близость (подбор сквозь пол)
        local flatDist = (Vector3.new(p.X, 0, p.Z) - Vector3.new(r.Position.X, 0, r.Position.Z)).Magnitude
        local closeEnough = (FarmSystem.Method == "Down") and (flatDist < 8) or ((p - r.Position).Magnitude < 6)

        if closeEnough then
            local part = coin:IsA("BasePart") and coin or coin:FindFirstChildWhichIsA("BasePart", true)
            touchGrab(part, r)
        end

        if FarmSystem.AvoidMurder then
            local mur = GetMurderer()
            if mur then
                local mHRP = SafeGetHRP(SafeGetCharacter(mur))
                if mHRP then
                    local murPos = mHRP.Position
                    local nearMe = (murPos - r.Position).Magnitude < FarmSystem.FleeRadius
                    local onPath = segment_gap(r.Position, targetPos, murPos) < FarmSystem.SafeRadius
                    if nearMe or onPath then
                        tween:Cancel()
                        notifyReroute("Murderer рядом — убегаю")
                        FarmSystem.PendingFlee = mur
                        stop = true
                        return
                    end
                end
            end
        end

        if flatDist < 3 then stop = true end
    end)

    while not stop and tween.PlaybackState == Enum.PlaybackState.Playing do
        task.wait(0.05)
    end
    tween:Cancel()
    if conn then conn:Disconnect() end
    task.wait(FarmSystem.CoinDelay)
end

task.spawn(function()
    while not getgenv().CWH_Unloaded do
        if not FarmSystem.Enabled and FarmSystem.WasLying then
            standUp(SafeGetHRP(SafeGetCharacter(LocalPlayer)))
        end

        if FarmSystem.Enabled and not FarmSystem.Active then
            if FarmSystem.PendingFlee then
                local mur = FarmSystem.PendingFlee
                FarmSystem.PendingFlee = nil
                FarmSystem.Active = true
                pcall(fleeFromMurderer, mur)
                FarmSystem.Active = false
                continue
            end

            local char = SafeGetCharacter(LocalPlayer)
            local root = SafeGetHRP(char)
            local hum = SafeGetHumanoid(char)
            if root and hum and hum.Health > 0 then
                local coins = farmGetCoins()
                if #coins == 0 then
                    standUp(root)
                    task.wait(1)
                else
                    local mur = FarmSystem.AvoidMurder and GetMurderer() or nil
                    local murHRP = mur and SafeGetHRP(SafeGetCharacter(mur))
                    local murPos = murHRP and murHRP.Position or nil
                    local myPos = root.Position

                    table.sort(coins, function(a, b)
                        local pa, pb = coinPos(a), coinPos(b)
                        if not pa then return false end
                        if not pb then return true end
                        return (pa - myPos).Magnitude < (pb - myPos).Magnitude
                    end)

                    local target
                    for _, c in ipairs(coins) do
                        local p = coinPos(c)
                        if p then
                            local coinClear = not murPos
                                or (p - murPos).Magnitude > FarmSystem.SafeRadius
                            local pathClear = not murPos
                                or segment_gap(myPos, p, murPos) > FarmSystem.SafeRadius
                            if coinClear and pathClear then
                                target = c
                                break
                            end
                        end
                    end

                    if target then
                        FarmSystem.Active = true
                        local ok, err = pcall(farmGoTo, target)
                        FarmSystem.Active = false
                        if not ok then warn("[CWH Farm] " .. tostring(err)) end
                    else
                        notifyReroute("Все монеты у Murderer — жду")
                        task.wait(0.5)
                    end
                end
            end
        end
        task.wait(0.1)
    end
end)

-- COIN AURA
task.spawn(function()
    while not getgenv().CWH_Unloaded do
        if CoinAura.Enabled then
            local root = SafeGetHRP(SafeGetCharacter(LocalPlayer))
