-- AUTO GRAB GUN SMOOTH (летит к пушке БЕЗ телепорта — скорость, как в Pulse)
-- ═══════════════════════════════════════════════════════════════
local smoothGrabOn = false
local smoothGrabMoving = false
local smoothGrabSpeed = 35

local function smoothGrabStop()
    local c = getChar(LocalPlayer)
    local hrp = getHRP(c)
    if hrp and smoothGrabMoving then
        pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero end)
    end
    smoothGrabMoving = false
    if c then
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then pcall(function() p.CanCollide = true end) end
        end
    end
end

task.spawn(function()
    while task.wait(0.1) do
    if not getgenv().CWH_RUN then break end
        pcall(function()
            if not smoothGrabOn then
                if smoothGrabMoving then smoothGrabStop() end
                return
            end
            local c = getChar(LocalPlayer)
            local hrp = getHRP(c)
            local hum = getHum(c)
            if not (hrp and hum and hum.Health > 0) then return end
            local farmRef = getgenv().CWH_FarmRef
            if farmRef and farmRef.Enabled then return end
            local bp = LocalPlayer:FindFirstChild("Backpack")
            if (c and c:FindFirstChild("Gun")) or (bp and bp:FindFirstChild("Gun")) then
                if smoothGrabMoving then smoothGrabStop() end
                return
            end
            local map = getMap()
            local drop = map and map:FindFirstChild("GunDrop", true)
            if not drop then
                if smoothGrabMoving then smoothGrabStop() end
                return
            end
            local part = drop:IsA("BasePart") and drop or drop:FindFirstChildWhichIsA("BasePart", true)
            local pos = part and part.Position
            if not pos then return end
            -- ноклип только ПОКА летим к пушке
            smoothGrabMoving = true
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
            end
            local d = (pos - hrp.Position).Magnitude
            if d < 8 then
                pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero end)
                if realFireTouch then
                    realFireTouch(drop, hrp, 1)
                    realFireTouch(drop, hrp, 0)
                end
                return
            end
            -- движение СКОРОСТЬЮ (никаких CFrame-телепортов)
            local dir = (pos - hrp.Position) / d
            pcall(function()
                hrp.AssemblyLinearVelocity = dir * smoothGrabSpeed
            end)
        end)
    end
end)

