local CoinAura = {
    Enabled = false,
    Radius = 15,
    Connection = nil,
    LastTouch = 0,
    TouchDelay = 0.05,
    CollectedCount = 0,
    UseRaycast = true,
}

-- Получить CoinContainer
local function getCoinContainers()
    local containers = {}
    for _, map in ipairs(workspace:GetChildren()) do
        local container = map:FindFirstChild("CoinContainer")
        if container then
            table.insert(containers, container)
        end
    end
    return containers
end

-- Получить монеты (с проверкой Collected/Delete)
local function getCoinParts(containers)
    local parts = {}
    for _, container in ipairs(containers) do
        for _, descendant in ipairs(container:GetDescendants()) do
            if descendant:IsA("BasePart") then
                local collected = descendant:GetAttribute("Collected")
                local deleted = descendant:GetAttribute("Delete")
                if not collected and not deleted then
                    local hasTouch = descendant:FindFirstChildOfClass("TouchTransmitter") ~= nil
                    if not hasTouch then
                        local parent = descendant.Parent
                        if parent then
                            hasTouch = parent:FindFirstChildOfClass("TouchTransmitter") ~= nil
                        end
                    end
                    if hasTouch then
                        table.insert(parts, descendant)
                    end
                end
            end
        end
    end
    return parts
end

-- Проверка что путь до монеты свободен
local function hasLineOfSight(character, from, to)
    if not CoinAura.UseRaycast then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { character }
    
    local dir = to - from
    local hit = workspace:Raycast(from, dir, params)
    
    if not hit then return true end
    
    -- Если попали в монету или её родителя — путь свободен
    if hit.Instance == to then return true end
    
    return false
end

-- Основная функция
local function collectNearbyCoins()
    if not CoinAura.Enabled then return end

    local character = LocalPlayer.Character
    if not character then return end

    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    local now = os.clock()
    if now - CoinAura.LastTouch < CoinAura.TouchDelay then return end

    local rootPos = rootPart.Position
    local containers = getCoinContainers()
    if #containers == 0 then return end

    local coinParts = getCoinParts(containers)
    if #coinParts == 0 then return end

    local touched = false
    for _, part in ipairs(coinParts) do
        if part and part.Parent then
            local dist = (rootPos - part.Position).Magnitude
            if dist <= CoinAura.Radius then
                -- Проверка прямой видимости (не через стены)
                if hasLineOfSight(character, rootPos, part.Position) then
                    pcall(function()
                        firetouchinterest(rootPart, part, 0)
                        firetouchinterest(rootPart, part, 1)
                    end)
                    touched = true
                    CoinAura.CollectedCount = CoinAura.CollectedCount + 1
                end
            end
        end
    end

    if touched then
        CoinAura.LastTouch = now
    end
end

-- Запуск
local function startCoinAura()
    CoinAura.Enabled = true
    CoinAura.CollectedCount = 0

    if CoinAura.Connection then
        CoinAura.Connection:Disconnect()
    end

    local accum = 0
    CoinAura.Connection = RunService.Heartbeat:Connect(function(dt)
        accum = accum + dt
        if accum < 0.03 then return end
        accum = 0
        pcall(collectNearbyCoins)
    end)
end

-- Стоп
local function stopCoinAura()
    CoinAura.Enabled = false
    if CoinAura.Connection then
        CoinAura.Connection:Disconnect()
        CoinAura.Connection = nil
    end
end

