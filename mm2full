-- ═══════════════════════════════════════════════════════════════
-- INVISIBILITY (метод Pulse: десинк под карту + призрак 50%)
--  • каждый кадр персонаж на миг улетает ГЛУБОКО под карту (выше
--    FallenPartsDestroyHeight), до отрисовки возвращается на место —
--    сервер/другие игроки тебя не видят, ты видишь себя призраком
-- ═══════════════════════════════════════════════════════════════
local invisOn = false
local invisKeyName = ""
local invParts = {}
local invRealCF, invRealHRP = nil, nil
local invDownPos, invNeedsRestore = nil, false
local invFlip = false
local invRC, invRCChar = nil, nil
local invVoidY = -400
pcall(function()
    local fdh = tonumber(workspace.FallenPartsDestroyHeight) or -500
    invVoidY = fdh + 15
end)

local function invScan()
    invParts = {}
    local c = getChar(LocalPlayer)
    if not c then return end
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") and p.Transparency == 0 then
            local near = (p.Name == "Head") or (p.Parent and p.Parent:IsA("Accessory")) or false
            invParts[#invParts + 1] = { p = p, near = near }
        end
    end
end

local function invGhostAll(alpha)
    pcall(function()
        for _, u in ipairs(invParts) do
            if u.p and u.p.Parent then
                u.p.LocalTransparencyModifier = alpha
            end
        end
    end)
end

local function invFirstPerson()
    local cam = workspace.CurrentCamera
    if not cam then return false, nil end
    local camPos = cam.CFrame.Position
    if LocalPlayer.CameraMode == Enum.CameraMode.LockFirstPerson then return true, camPos end
    local c = getChar(LocalPlayer)
    local h = c and c:FindFirstChild("Head")
    if h and (h.Position - camPos).Magnitude < 1.5 then return true, camPos end
    return false, camPos
end

local function invisOff(silent)
    if not invisOn then return end
    invisOn = false
    invGhostAll(0)
    local c = getChar(LocalPlayer)
    local hrp = getHRP(c)
    if hrp and hrp.Parent then
        if invRealHRP == hrp and invRealCF then
            pcall(function() hrp.CFrame = invRealCF end)
        end
        pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero end)
        pcall(function() hrp.AssemblyAngularVelocity = Vector3.zero end)
    end
    if not silent then
        Notify("Invisibility", "Выключена — ты снова виден", nil, 2)
        print("[CWH] Invisibility: OFF")
    end
end

local function invisToggle()
    task.spawn(function()
        if invisOn then
            invisOff()
        else
            local c = getChar(LocalPlayer)
            local hum = getHum(c)
            if not (hum and getHRP(c)) then
                Notify("Invisibility", "Нет персонажа", nil, 3)
                return
            end
            invScan()
            invisOn = true
            invGhostAll(0.5)
            Notify("Invisibility", "ВКЛ — другие тебя не видят", nil, 3)
            print("[CWH] Invisibility: ON (десинк Pulse)")
        end
    end)
end

