-- ROLE DETECTION
-- ═══════════════════════════════════════════════════════════════
local NotifiedRoles = {}
local RoleDetectEnabled = true

local function ResetRoleNotifications()
    NotifiedRoles = {}
end

local function DetectRoles()
    if not RoleDetectEnabled then return end
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local role = GetRole(player)
        if role == "Murderer" and NotifiedRoles[player] ~= "Murderer" then
            NotifiedRoles[player] = "Murderer"
            RoleDetectSound:Play()
            Notify("🩸 Murderer Detected", player.Name .. " is the Murderer!", "Stay away!", 8)
        elseif role == "Sheriff" and NotifiedRoles[player] ~= "Sheriff" then
            NotifiedRoles[player] = "Sheriff"
            RoleDetectSound:Play()
            Notify("🔫 Sheriff Detected", player.Name .. " is the Sheriff!", "Protect them!", 8)
        end
    end
end

