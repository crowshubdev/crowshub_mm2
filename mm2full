end

local ksLast, ssLast = 0, 0
local function playSndId(id, volPct)
    if id == "" then return end
    pcall(function()
        local snd = Instance.new("Sound")
        snd.SoundId = id
        snd.Volume = (tonumber(volPct) or 60) / 100 * 3
        snd.Parent = game:GetService("SoundService")
        snd:Play()
        game:GetService("Debris"):AddItem(snd, 8)
    end)
end

local function ksPlay(id, force)
    if id == "" then return end
    if not force and not KillSnd.On then return end
    local now = os.clock()
    if not force and now - ksLast < 0.35 then return end
    ksLast = now
    playSndId(id, KillSnd.Vol)
end

local function ssPlay(id, force)
    if id == "" then return end
    if not force and not ShotSnd.On then return end
    local now = os.clock()
    if not force and now - ssLast < 0.15 then return end
    ssLast = now
    playSndId(id, ShotSnd.Vol)
end

