task.spawn(function()
    local ok, remotes = pcall(function() return ReplicatedStorage:WaitForChild("Remotes", 8) end)
    if ok and remotes then
        local gp = remotes:FindFirstChild("Gameplay") or remotes:FindFirstChild("Gameplay", true)
