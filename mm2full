-- [v1.9] АНИМАЦИОННЫЕ БАНДЛЫ (механика плагина BundleAnimations из Overdrive):
-- AvatarEditorService:GetItemDetails → анимации бандла → HumanoidDescription →
-- CreateHumanoidModelFromDescription → Animate модели раскладывает по действиям
-- (idle/walk/run/jump/fall/climb/swim) → применяем к своему персонажу.
local ANIM_ACTION_NAMES = {
    IdleAnimation = { "idle" }, WalkAnimation = { "walk" }, RunAnimation = { "run" },
    JumpAnimation = { "jump" }, FallAnimation = { "fall" }, ClimbAnimation = { "climb" },
    SwimAnimation = { "swim", "swimidle" },
}
local AES = game:GetService("AvatarEditorService")

local function applyBundle(bundleId)
    bundleId = tonumber(bundleId)
    if not bundleId then
        Notify("Bundle", "Впиши числовой ID бандла", nil, 3)
        return
    end
    local ok, details = pcall(function()
        return AES:GetItemDetails(bundleId, Enum.AvatarItemType.Bundle)
    end)
    if not ok or type(details) ~= "table" then
        Notify("Bundle", "Бандл не найден (rate limit?)", nil, 4)
        return
    end
    local items = details.BundledItems or details.itemAssets or details.Items or {}
    if #items == 0 then
        Notify("Bundle", "Бандл пуст", nil, 3)
        return
    end
    local desc = Instance.new("HumanoidDescription")
    local got = 0
    for _, it in ipairs(items) do
        local t = tostring(it.AssetType or (it.itemType and it.itemType.Name) or "")
        local aid = tonumber(it.Id or it.id)
        if aid and ANIM_ACTION_NAMES[t] then
            pcall(function()
                desc[t] = aid
                got += 1
            end)
        end
    end
    if got == 0 then
        Notify("Bundle", "В бандле нет анимаций", nil, 3)
        return
    end
    local ok2, model = pcall(function()
        return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
    end)
    if not ok2 or not model then
        Notify("Bundle", "Модель не собралась", nil, 4)
        return
    end
    -- Animate модели знает, какая анимация для какого действия
    local found = {}
    local modelAnimate = model:FindFirstChild("Animate")
    if modelAnimate then
        for _, action in pairs(ANIM_ACTION_NAMES) do
            for _, n in ipairs(action) do
                local folder = modelAnimate:FindFirstChild(n)
                local a = folder and folder:FindFirstChildOfClass("Animation")
                if a and a.AnimationId ~= "" then
                    found[action[1]] = a.AnimationId
                    break
                end
            end
        end
    end
    pcall(function() model:Destroy() end)
    if not next(found) then
        Notify("Bundle", "Animate модели не дал анимации", nil, 3)
        return
    end
    local char = getChar(LocalPlayer)
    local myAnimate = char and char:FindFirstChild("Animate")
    if not myAnimate then
        Notify("Bundle", "Твой Animate не найден", nil, 3)
        return
    end
    local applied = 0
    for folderName, id in pairs(found) do
        local folder = myAnimate:FindFirstChild(folderName)
        if folder then
            for _, a in ipairs(folder:GetChildren()) do
                if a:IsA("Animation") then
                    if not animApply[a] then animApply[a] = a.AnimationId end
                    a.AnimationId = id
                    applied += 1
                end
            end
        end
    end
    restartAnimate(char)
    Notify("Bundle", (details.Name or "Бандл") .. ": применено " .. applied .. " анимаций", nil, 4)
end

