-- ═══════════════════════════════════════════════════════════════
-- AUTO GRAB GUN v2 (метод Pulse: сам летит к пушке с любой дистанции)
-- ═══════════════════════════════════════════════════════════════
local autoGrabOn = false
local grabNotifySeen = false

task.spawn(function()
    while task.wait(0.25) do
    if not getgenv().CWH_RUN then break end
        pcall(function()
            if not autoGrabOn then return end
            local c = getChar(LocalPlayer)
            local hrp = getHRP(c)
            local hum = getHum(c)
            if not (hrp and hum and hum.Health > 0) then return end
            -- не мешаем ферме
            local farmRef = getgenv().CWH_FarmRef
            if farmRef and farmRef.Enabled then return end
            local bp = LocalPlayer:FindFirstChild("Backpack")
            if (c and c:FindFirstChild("Gun")) or (bp and bp:FindFirstChild("Gun")) then
                if not grabNotifySeen then
                    grabNotifySeen = true
                    Notify("Auto Grab", "💥 Gun взят!", nil, 3)
                end
                return
            end
            grabNotifySeen = false
            local map = getMap()
            local drop = map and map:FindFirstChild("GunDrop", true)
            if not drop then return end
            local part = drop:IsA("BasePart") and drop or drop:FindFirstChildWhichIsA("BasePart", true)
            local pos = part and part.Position
            if not pos then return end
            local d = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(hrp.Position.X, 0, hrp.Position.Z)).Magnitude
            local dy = math.abs(pos.Y - hrp.Position.Y)
            if d < 8 and dy < 14 then
                if realFireTouch then
                    realFireTouch(drop, hrp, 1)
                    realFireTouch(drop, hrp, 0)
                else
                    hrp.CFrame = CFrame.new(pos + Vector3.new(0, 2.5, 0))
                end
            else
                -- шаг к пушке (как ферма: CFrame-шаги)
                local step = math.min(14, d)
                local dir = Vector3.new(pos.X - hrp.Position.X, 0, pos.Z - hrp.Position.Z)
                dir = (dir.Magnitude > 0.1) and dir.Unit or Vector3.new(0, 0, 1)
                hrp.CFrame = CFrame.new(hrp.Position + dir * step
                    + Vector3.new(0, math.clamp(pos.Y - hrp.Position.Y, -step, step), 0))
            end
