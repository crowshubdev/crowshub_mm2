smb.BackgroundTransparency = 0.55
smb.Text = "Shoot Murderer"
smb.TextColor3 = Color3.new(1, 1, 1)
smb.Font = Enum.Font.GothamBold
smb.TextSize = 18
smb.Active = true
smb.Parent = smbGui

-- [v1.7] стиль как на скрине: скругление 10px + заметная фиолетовая обводка
local smbCorner = Instance.new("UICorner")
