local function CreateTab(tabName)
    local Scroll = Instance.new("ScrollingFrame")
    Scroll.Size = UDim2.new(1, 0, 1, 0)
    Scroll.BackgroundTransparency = 1
    Scroll.ScrollBarThickness = 4
    Scroll.Visible = false
    Scroll.Parent = Content

    local List = Instance.new("UIListLayout")
    List.Padding = UDim.new(0, 6)
    List.Parent = Scroll

    Tabs[tabName] = Scroll

    local TabBtn = Instance.new("TextButton")
    TabBtn.Size = UDim2.new(1, 0, 0, 35)
    TabBtn.BackgroundColor3 = Themes[Settings.CurrentTheme].Button
    TabBtn.Text = tabName
    TabBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    TabBtn.Font = Enum.Font.SourceSansBold
    TabBtn.TextSize = 14
    TabBtn.Parent = Sidebar

    local TCorner = Instance.new("UICorner")
    TCorner.CornerRadius = UDim.new(0, 4)
    TCorner.Parent = TabBtn

    TabBtn.MouseButton1Click:Connect(function()
        for name, page in pairs(Tabs) do page.Visible = false end
        for _, btn in pairs(TabButtons) do btn.BackgroundColor3 = Themes[Settings.CurrentTheme].Button end
        Scroll.Visible = true
        TabBtn.BackgroundColor3 = Themes[Settings.CurrentTheme].TabActive
    end)

    table.insert(TabButtons, TabBtn)
    return Scroll
end

