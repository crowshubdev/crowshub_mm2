-- KNIFE THROW SILENT AIM (Аура летящего ножа)
-- Взято из SHITARO
-- Работает: подменяет точку приземления ножа на цель
-- ═══════════════════════════════════════════════════════════════

local KnifeSystem = {
    Silent = false,          -- Включить silent throw
    Predict = true,          -- Предикт движения цели
    InstaKill = false,       -- Мгновенный kill при пролёте (аура)
    ImpactRadius = 12,       -- Радиус "ауры" для инстакилла
    Range = 400,
    LeadScale = 1,           -- Множитель предикта
    LeadAdd = 0,
    AirScale = 0.35,
    ThrowSpeed = 96,
    Trackers = {},
    Pending = nil
}

-- ─── Поиск ножа у себя ─────────────────────────────────────
local function getKnife()
    local char = SafeGetCharacter(LocalPlayer)
    if char then
        local eq = char:FindFirstChild("Knife")
        if eq then return eq, true end
    end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        local stored = bp:FindFirstChild("Knife")
        if stored then return stored, false end
    end
    return nil, false
end

local function knife_events()
    local knife = getKnife()
    if not knife then return nil end
    return knife:FindFirstChild("Events")
end

-- ─── Мгновенный kill (главная фишка ауры) ──────────────────
local function direct_kill(part)
    if not part or not part.Parent then return false end
    local events = knife_events()
    if not events then return false end
    local stabbed = events:FindFirstChild("KnifeStabbed")
    local touched = events:FindFirstChild("HandleTouched")
    if not stabbed or not touched then return false end
    local ok = pcall(function()
        stabbed:FireServer()
        touched:FireServer(part)
    end)
    return ok
end

-- ─── Позиция снаряда (ножа в полёте) ───────────────────────
local function projectile_position(inst)
    if not inst or not inst.Parent then return nil end
    if inst:IsA("BasePart") then return inst.Position end
    local blade = inst:FindFirstChild("BladePosition")
    if blade and blade:IsA("BasePart") then return blade.Position end
    local ok, pivot = pcall(function() return inst:GetPivot() end)
    if ok and typeof(pivot) == "CFrame" then return pivot.Position end
    local first = inst:FindFirstChildWhichIsA("BasePart")
    if first then return first.Position end
    return nil
end

-- ─── Трекер для предикта движения цели ─────────────────────
local TRACKER_CAP = 20
local TRACKER_WINDOW = 0.13

local function new_tracker()
    return {
        t = table.create(TRACKER_CAP, 0),
        p = table.create(TRACKER_CAP, Vector3.zero),
        n = 0,
        i = 0,
        part = nil,
        pos = nil,
        time = 0,
        vel = Vector3.zero,
        gap = 0.05,
        ready = false,
    }
end

local function snap_push(tr, now, pos)
    tr.i = tr.i % TRACKER_CAP + 1
    tr.t[tr.i] = now
    tr.p[tr.i] = pos
    if tr.n < TRACKER_CAP then tr.n = tr.n + 1 end
end

local function snap_get(tr, k)
    local idx = (tr.i - k - 1) % TRACKER_CAP + 1
    return tr.t[idx], tr.p[idx]
end

local function fit_velocity(tr)
    if tr.n < 3 then return nil end
    local newest = snap_get(tr, 0)
    local used = 0
    local sum_d = 0
    for k = 0, tr.n - 1 do
        local t = snap_get(tr, k)
        if newest - t > TRACKER_WINDOW then break end
        used = used + 1
        sum_d = sum_d + (t - newest)
    end
    if used < 3 then return nil end
    local mean_d = sum_d / used
    local num = Vector3.zero
    local den = 0    for k = 0, used - 1 do
        local t, p = snap_get(tr, k)
        local d = (t - newest) - mean_d
        num = num + p * d
        den = den + d * d
    end
    if den < 1e-8 then return nil end
    return num / den
end

local function update_tracker(tr, char, part, now)
    local pos = part.Position
    if part ~= tr.part or not tr.pos then
        tr.part = part
        tr.pos = pos
        tr.time = now
        tr.vel = Vector3.zero
        tr.n = 0
        tr.i = 0
        snap_push(tr, now, pos)
        return
    end
    local dt = now - tr.time
    if dt > 0.75 or (pos - tr.pos).Magnitude > 140 then
        tr.part = part
        tr.pos = pos
        tr.time = now
        tr.n = 0
        tr.i = 0
        snap_push(tr, now, pos)
        return
    end
    if (pos - tr.pos).Magnitude < 0.004 or dt <= 0 then return end
    
    tr.gap = math.clamp(tr.gap * 0.8 + dt * 0.2, 0.012, 0.25)
    snap_push(tr, now, pos)
    tr.pos = pos
    tr.time = now
    
    local fit = fit_velocity(tr)
    if fit then
        if tr.ready then
            -- Плавное обновление
            tr.vel = tr.vel:Lerp(fit, 0.45)
        else
            tr.vel = fit
            tr.ready = true
        end
    end
end

local function get_tracker(plr)
    local tr = KnifeSystem.Trackers[plr]
    if not tr then
        tr = new_tracker()
        KnifeSystem.Trackers[plr] = tr
    end
    return tr
end

-- ─── Предикт позиции цели ──────────────────────────────────
local function lead_offset(tr, char, base, t)
    if not KnifeSystem.Predict or not tr or not tr.ready then
        return Vector3.zero
    end
    if t <= 0 then return Vector3.zero end
    local vel = tr.vel
    local off_x = vel.X * t * KnifeSystem.LeadScale
    local off_z = vel.Z * t * KnifeSystem.LeadScale
    local vy = vel.Y
    local off_y = 0
    
    -- Предикт гравитации для прыжка
    if math.abs(vy) > 3 then
        local tv = t * KnifeSystem.AirScale
        off_y = math.clamp(vy * tv - 0.5 * workspace.Gravity * tv * tv, -1.8, 1.8)
    end
    
    return Vector3.new(off_x, off_y, off_z)
end

-- ─── Выбор ближайшей цели ──────────────────────────────────
local function pick_target()
    local myChar = SafeGetCharacter(LocalPlayer)
    local root = SafeGetHRP(myChar)
    if not root then return nil, nil, nil end
    local origin = root.Position
    local best_char, best_part, best_tr = nil, nil, nil
    local best_dist = KnifeSystem.Range
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = SafeGetCharacter(plr)
        if not char then continue end
        local hum = SafeGetHumanoid(char)
        if not hum or hum.Health <= 0 then continue end
        local part = char:FindFirstChild("HumanoidRootPart")
            or char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("Torso")
        if not part then continue end
        local dist = (part.Position - origin).Magnitude
        if dist <= best_dist then
            best_dist = dist
            best_char = char
            best_part = part
            best_tr = get_tracker(plr)
        end
    end
    return best_char, best_part, best_tr
end

-- ─── Куда целиться ─────────────────────────────────────────
local function throw_aim(tr, char, part, origin)
    local base = part.Position
    local travel = 0
    local point = base
    for _ = 1, 3 do
        local ping = LocalPlayer:GetNetworkPing() or 0
        if ping > 1 then ping = ping / 1000 end
        local t = math.clamp(ping + KnifeSystem.LeadAdd + travel, 0, 1)
        point = base + lead_offset(tr, char, base, t)
        if not origin or KnifeSystem.ThrowSpeed <= 1 then break end
        travel = math.clamp((point - origin).Magnitude / KnifeSystem.ThrowSpeed, 0, 0.7)
    end
    return point
end

-- ─── ГЛАВНАЯ: перехват броска ножа ─────────────────────────
getgenv().KNIFE_AIM_RESOLVE = function()
    if not KnifeSystem.Silent then return nil end
    local char = SafeGetCharacter(LocalPlayer)
    if not char or not char:FindFirstChild("Knife") then return nil end
    
    local target_char, part, tr = pick_target()
    if not part then return nil end
    
    local root = SafeGetHRP(char)
    local origin = root and root.Position or nil
    local point = throw_aim(tr, target_char, part, origin)
    
    -- Регистрируем pending для инстакилла
    if KnifeSystem.InstaKill then
        KnifeSystem.Pending = {
            char = target_char,
            part = part,
            time = os.clock(),
            aim = point,
            knife = nil,
            last_pos = nil,
            gone_at = nil,
            fired = false,
        }
    else
        KnifeSystem.Pending = nil
    end
    
    return CFrame.new(point)
end

-- ─── Инстакилл при пролёте ножа рядом ──────────────────────
local function segment_gap(a, b, p)
    if not a then return (b - p).Magnitude end
    local ab = b - a
    local len2 = ab:Dot(ab)
    if len2 < 1e-6 then return (b - p).Magnitude end
    local t = math.clamp((p - a):Dot(ab) / len2, 0, 1)
    return (a + ab * t - p).Magnitude
end

local function target_still_alive()
    if not KnifeSystem.Pending then return false end
    local char = KnifeSystem.Pending.char
    if not char or not char.Parent then return false end
    local hum = SafeGetHumanoid(char)
    if not hum or hum.Health <= 0 then return false end
    return true
end

-- Ищем летящий нож через CollectionService
local function adopt_projectile()
    if not KnifeSystem.Pending or KnifeSystem.Pending.knife then return end
    local myChar = SafeGetCharacter(LocalPlayer)
    local root = SafeGetHRP(myChar)
    if not root then return end
    local cs = game:GetService("CollectionService")
    local ok, tagged = pcall(function() return cs:GetTagged("ThrowingKnife") end)
    if not ok or type(tagged) ~= "table" then return end
    local best, best_dist = nil, 24
    for k = 1, #tagged do
        local inst = tagged[k]
        if inst and inst.Parent then
            local pos = projectile_position(inst)
            if pos then
                local dist = (pos - root.Position).Magnitude
                if dist < best_dist then
                    best_dist = dist
                    best = inst
                end
            end
        end
    end
    if best then
        KnifeSystem.Pending.knife = best
        KnifeSystem.Pending.last_pos = projectile_position(best)
    end
end

-- Проверка что нож пролетает рядом с целью → мгновенный kill
local function try_flyby(pos)
    if not KnifeSystem.Pending or KnifeSystem.Pending.fired then return end
    local part = KnifeSystem.Pending.part
    if not part or not part.Parent then
        part = SafeGetHRP(KnifeSystem.Pending.char)
        KnifeSystem.Pending.part = part
    end
    if not part then return end
    
    -- Если нож пролетает в радиусе impact_radius от цели → kill
    if segment_gap(KnifeSystem.Pending.last_pos, pos, part.Position) > KnifeSystem.ImpactRadius then return end
    
    if direct_kill(part) then
        KnifeSystem.Pending.fired = true
    end
end

local function watch_pending(now)
    if not KnifeSystem.Pending then return end
    if now - KnifeSystem.Pending.time > 6 then
        KnifeSystem.Pending = nil
        return
    end
    if not target_still_alive() then
        KnifeSystem.Pending = nil
        return
    end
    
    adopt_projectile()
    local inst = KnifeSystem.Pending.knife
    if not inst then
        if now - KnifeSystem.Pending.time > 1 then KnifeSystem.Pending = nil end
        return
    end
    
    if inst.Parent then
        local pos = projectile_position(inst)
        if pos then
            try_flyby(pos)  -- ← ПРОВЕРКА АУРЫ
            KnifeSystem.Pending.last_pos = pos
        end
        KnifeSystem.Pending.gone_at = nil
        return
    end
    
    if not KnifeSystem.Pending.gone_at then
        KnifeSystem.Pending.gone_at = now
    end
end

-- ─── Главный loop ──────────────────────────────────────────
task.spawn(function()
    while true do
        local now = os.clock()
        
        if KnifeSystem.Silent or KnifeSystem.Pending then
            -- Обновляем трекеры целей
            for plr in pairs(KnifeSystem.Trackers) do
                if plr.Parent ~= Players then KnifeSystem.Trackers[plr] = nil end
            end
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr == LocalPlayer then continue end
                local char = SafeGetCharacter(plr)
                if char then
                    local hum = SafeGetHumanoid(char)
                    if hum and hum.Health > 0 then
                        local part = char:FindFirstChild("HumanoidRootPart")
                            or char:FindFirstChild("UpperTorso")
                            or char:FindFirstChild("Torso")
                        if part then
                            local tr = get_tracker(plr)
                            update_tracker(tr, char, part, now)
                        end
                    else
                        KnifeSystem.Trackers[plr] = nil
                    end
                end
            end
            
            watch_pending(now)
        end
        
        task.wait()
    end
end)

-- ─── Подключение к Silent Aim через WeaponService ──────────
-- KNIFE_AIM_RESOLVE вызывается из Silent Aim хука
-- Он уже установлен в Silent Aim системе выше

-- ─── Ручной бросок с аимом ─────────────────────────────────
local function throwKnifeAtNearest()
    local knife, equipped = getKnife()
    if not knife then
        Notify("Knife", "No knife!", nil, 3)
        return
    end
    
    if not equipped then
        local hum = SafeGetHumanoid(SafeGetCharacter(LocalPlayer))
        if hum then
            hum:EquipTool(knife)
            task.wait(0.2)
            knife = SafeGetCharacter(LocalPlayer):FindFirstChild("Knife")
        end
    end
    
    if not knife then return end
    
    local target_char, part, tr = pick_target()
    if not part then
        Notify("Knife", "No target!", nil, 3)
        return
    end
    
    local root = SafeGetHRP(SafeGetCharacter(LocalPlayer))
    local origin = root and root.Position or nil
    local point = throw_aim(tr, target_char, part, origin)
    
    -- Ищем RemoteEvent для броска
    local throw_event = knife:FindFirstChild("Throw")
    if not throw_event then
        local events = knife:FindFirstChild("Events")
        throw_event = events and events:FindFirstChild("Throw")
    end
    
    if throw_event and typeof(throw_event.FireServer) == "function" then
        local throwCF = CFrame.new(origin or Vector3.zero, point)
        pcall(function()
            throw_event:FireServer(throwCF, point)
        end)
        Notify("Knife", "Thrown at " .. (target_char and target_char.Name or "?"), nil, 3)
    else
        Notify("Knife", "No throw event found", nil, 3)
    end
end

