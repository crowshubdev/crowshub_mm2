local function ShootAtMurderer()
    local murderer = GetMurderer()
    if not murderer then
        Notify("Combat", "No murderer found!", nil, 3)
        return
    end
    local char = SafeGetCharacter(LocalPlayer)
    local hrp = SafeGetHRP(char)
    local mChar = SafeGetCharacter(murderer)
    local mHead = mChar and mChar:FindFirstChild("Head")
    if not hrp or not mHead then
        Notify("Combat", "Target not available!", nil, 3)
        return
    end

    Camera.CFrame = CFrame.new(Camera.CFrame.Position, mHead.Position)

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local charGun = char and char:FindFirstChild("Gun")
    local packGun = backpack and backpack:FindFirstChild("Gun")

    if charGun then
        task.wait(0.05)
        pcall(function() charGun:Activate() end)
        Notify("Combat", "Firing at " .. murderer.Name .. "!", nil, 3)
    elseif packGun then
        local hum = SafeGetHumanoid(char)
        if hum then
            hum:EquipTool(packGun)
            task.wait(0.3)
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, mHead.Position)
            task.wait(0.05)
            pcall(function() packGun:Activate() end)
            Notify("Combat", "Equipped and fired at " .. murderer.Name .. "!", nil, 3)
        end
    else
        Notify("Combat", "You don't have a gun!", "Wait for sheriff to die.", 4)
    end
end

