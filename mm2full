-- ═══════════════════════════════════════════════════════════════
-- DODGE THROW KNIFE (телепорт от летящего ножа)
-- ═══════════════════════════════════════════════════════════════
local DodgeKnife = {
    On = false, Distance = 40, Detect = 100, Cooldown = 0.5, Last = 0,
}

-- пул летящих ножей
local knifePool = {}
local knifeVelTrack = {}

local function tryAddKnife(inst)
    if inst and inst:IsA("BasePart") then
        local n = inst.Name:lower()
        if n:find("knife") or n:find("throw") or n:find("blade") then
            knifePool[inst] = true
        end
    end
end
for _, obj in ipairs(workspace:GetDescendants()) do tryAddKnife(obj) end
workspace.DescendantAdded:Connect(tryAddKnife)

local function getFlyingKnives()
    local list = {}
    for inst in pairs(knifePool) do
        if inst and inst.Parent then
            local inChar = false
            local p = inst
            while p and p ~= workspace do
                if p:IsA("Model") and Players:GetPlayerFromCharacter(p) then
                    inChar = true
                    break
                end
                p = p.Parent
            end
            if not inChar then
                table.insert(list, inst)
            else
                knifePool[inst] = nil
            end
        else
            knifePool[inst] = nil
        end
    end
    return list
end

local function knifePos(k)
    if not k or not k.Parent then return nil end
    if k:IsA("BasePart") then return k.Position end
    local ok, pv = pcall(function() return k:GetPivot() end)
    if ok and typeof(pv) == "CFrame" then return pv.Position end
    local f = k:FindFirstChildWhichIsA("BasePart")
    return f and f.Position
end

local function knifeVel(k)
    local part = k:IsA("BasePart") and k or k:FindFirstChildWhichIsA("BasePart")
    if part then
        local ok, v = pcall(function() return part.AssemblyLinearVelocity end)
        if ok and v and v.Magnitude >= 5 then return v end
    end
    -- фоллбэк: дельта позиций (CFrame-анимация)
    local pos = knifePos(k)
    if not pos then return Vector3.zero end
    local now = os.clock()
    local tr = knifeVelTrack[k]
    if tr then
        local dt = now - tr.t
        if dt > 0.01 then
            local v = (pos - tr.p) / dt
            knifeVelTrack[k] = { p = pos, t = now }
            if v.Magnitude >= 5 then return v end
        end
    else
        knifeVelTrack[k] = { p = pos, t = now }
    end
    return Vector3.zero
end

local function doDodgeKnife()
    local char = getChar(LocalPlayer)
    local hrp = getHRP(char)
    if not hrp then return false end

    local now = os.clock()
    if now - DodgeKnife.Last < DodgeKnife.Cooldown then return false end

    local myPos = hrp.Position

    for _, knife in ipairs(getFlyingKnives()) do
        local kPos = knifePos(knife)
        if kPos then
            local kVel = knifeVel(knife)
            if kVel.Magnitude >= 5 then
                local toMe = myPos - kPos
                local dist = toMe.Magnitude
                if dist > 3 and dist < DodgeKnife.Detect then
                    local kDir = kVel.Unit
                    local dot = kDir:Dot(toMe.Unit)
                    if dot > 0.7 then
                        -- нож летит в нас — уклоняемся
                        local perp = Vector3.new(-kDir.Z, 0, kDir.X)
                        if perp.Magnitude < 0.1 then perp = Vector3.new(1, 0, 0) end
                        perp = perp.Unit
                        -- случайная сторона + случайный сдвиг вдоль ножа
                        local side = math.random(0, 1) == 0 and 1 or -1
                        local along = (math.random() - 0.5) * DodgeKnife.Distance * 0.6
                        local dodge = perp * side * DodgeKnife.Distance
                            + kDir * along
                        local target = myPos + dodge
                        -- держим ту же высоту (не телепортируем в пол/небо)
                        target = Vector3.new(target.X, myPos.Y, target.Z)

                        hrp.CFrame = CFrame.new(target)
                        DodgeKnife.Last = now
                        Notify("Dodge", "🌀 Уклонение от ножа!", nil, 2)
                        return true
                    end
                end
            end
        end
    end
    return false
end

task.spawn(function()
    while task.wait(0.05) do
    if not getgenv().CWH_RUN then break end
        if DodgeKnife.On then
            pcall(doDodgeKnife)
        end
    end
end)

