do -- ═══ [CWH SCOPE] G9c: Система кейбиндов + кнопка Speed Glitch (телефон) ═══
-- ── [v1.6] КЕЙБИНДЫ: пишешь ОДНУ английскую букву (маленькую или большую)
-- или цифру. Понимает и полные имена клавиш (LeftShift, One и т.п.).
local KB_MAP = {}  -- KeyCode -> функция
local DIGIT_NAMES = { ["0"] = "Zero", ["1"] = "One", ["2"] = "Two", ["3"] = "Three",
    ["4"] = "Four", ["5"] = "Five", ["6"] = "Six", ["7"] = "Seven", ["8"] = "Eight", ["9"] = "Nine" }
getgenv().CWH_Keybinds = { SG = "нет", Dual = "нет", Invis = "нет", Shoot = "нет",
                           Fly = "нет", Spec = "нет", Coin = "нет", Fl = "нет" } -- [v1.12] +No Coin, [v1.18] +Touch Fling

local function kbResolve(txt)
    local s = tostring(txt or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if #s == 0 then return nil, "" end
    if #s == 1 then
        local up = s:upper()
        if up >= "A" and up <= "Z" then
            local ok, kc = pcall(function() return Enum.KeyCode[up] end)
            if ok and kc then return kc, up end
        end
        if DIGIT_NAMES[s] then
            local ok, kc = pcall(function() return Enum.KeyCode[DIGIT_NAMES[s]] end)
            if ok and kc then return kc, s end
        end
        return nil, nil
    end
    local ok, kc = pcall(function() return Enum.KeyCode[s] end)
    if ok and kc then return kc, s end
    return nil, nil
end

local KB_ITEMS = {
    { key = "SG",    title = "🏃 Speed Glitch",   fn = function() pcall(getgenv().CWH_ToggleSG) end },
    { key = "Dual",  title = "🗡 Dual Weapon",    fn = function() pcall(getgenv().CWH_ToggleDual) end },
    { key = "Invis", title = "👻 Invisibility",   fn = function() pcall(getgenv().CWH_ToggleInvis) end },
    { key = "Shoot", title = "🎯 Shoot Murderer", fn = function() pcall(getgenv().CWH_ShootMurderer) end },
    -- [v1.11] Fly: тоггл полёта; Spec: следить за мардером / вернуть камеру
    { key = "Fly",  title = "✈ Fly", fn = function() pcall(getgenv().CWH_ToggleFly) end },
    -- [v1.12] No Coin: монеты исчезают и не собираются (механика как Invis — тоггл по кейбинду)
    { key = "Coin", title = "🪙 No Coin", fn = function() pcall(getgenv().CWH_NoCoinToggle) end },
    { key = "Fl", title = "💥 Touch Fling", fn = function() pcall(getgenv().CWH_ToggleFl) end },
    { key = "Spec", title = "🎬 Spectate Murderer", fn = function()
        pcall(function()
            if getgenv().CWH_SpecOn and getgenv().CWH_SpecOn() then
                getgenv().CWH_SpecStop()
                Notify("Spectate", "Камера вернулась к тебе", nil, 2)
            elseif getgenv().CWH_SpecStart then
                getgenv().CWH_SpecStart(getMurderer())
            end
        end)
    end },
}

local function kbBind(item, txt)
    local kc, disp = kbResolve(txt)
    if disp == "" then
        getgenv().CWH_Keybinds[item.key] = "нет"
        for k, f in pairs(KB_MAP) do
            if f == item.fn then KB_MAP[k] = nil end
        end
        Notify("Кейбинды", item.title .. " — клавиша убрана", nil, 2)
        return
    end
    if not kc then
        Notify("Кейбинды", "Только английские буквы (a/A) и цифры (5)!", nil, 3)
        return
    end
    -- освобождаем клавишу: у предыдущего действия тоже сбрасываем надпись
    for k, f in pairs(KB_MAP) do
        if f == item.fn then KB_MAP[k] = nil end
        if k == kc then
            for _, other in ipairs(KB_ITEMS) do
                if other.fn == f then getgenv().CWH_Keybinds[other.key] = "нет" end
            end
            KB_MAP[k] = nil
        end
    end
    KB_MAP[kc] = item.fn
    getgenv().CWH_Keybinds[item.key] = disp
    Notify("Кейбинды", item.title .. " → клавиша " .. disp, nil, 3)
end

