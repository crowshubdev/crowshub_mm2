-- Fling в пустоту
local function doFlingToVoid(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return end
    
    local tChar = targetPlayer.Character
    local tHRP = SafeGetHRP(tChar)
    if not tHRP then return end
    
    local myChar = LocalPlayer.Character
    local myHRP = SafeGetHRP(myChar)
    if not myHRP then return end
    
    -- Отключаем FallenPartsDestroyHeight чтобы не упасть в пустоту
    local old_fdh = workspace.FallenPartsDestroyHeight
    pcall(function() workspace.FallenPartsDestroyHeight = 0/0 end)
    
    -- Крутимся вокруг цели
    for i = 1, 60 do
        if not tHRP.Parent or not tChar.Parent then break end
        
        myHRP.CFrame = CFrame.new(tHRP.Position) * CFrame.new(0, 1.5, 0) * CFrame.Angles(math.rad(i * 100), 0, 0)
        myHRP.AssemblyLinearVelocity = Vector3.new(9e7, 9e7 * 5, 9e7)
        myHRP.AssemblyAngularVelocity = Vector3.new(9e8, 9e8, 9e8)
        myChar:SetPrimaryPartCFrame(myHRP.CFrame)
        task.wait(0.03)
    end
    
    -- Отправляем вверх
    pcall(function()
        tHRP.AssemblyLinearVelocity = Vector3.new(0, 5000, 0)
    end)
    
    task.wait(2)
    pcall(function() workspace.FallenPartsDestroyHeight = old_fdh end)
end

