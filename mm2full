do -- ═══ [CWH SCOPE] G14: SKINCHANGER (база игры ReplicatedStorage.Database.Sync, механика Pulse) ═══
-- ═══════════════════════════════════════════════════════════════
-- [v1.16] Порт WeaponSkins/SkinModel/SkinCatalog из нового Pulse: база скинов —
-- родной модуль игры ReplicatedStorage.Database.Sync (тот же, что и у Pulse).
-- Скин строится из сериализованных нодов (h/d), приваривается к Handle
-- (grip из поля g), оригинал прячется и всегда восстанавливается.
-- Всё клиентское — видно только тебе. Сброс — кнопка «Сбросить».
local InsertService = game:GetService("InsertService")
local SK = { On = false, Sel = { Knife = nil, Gun = nil }, db = nil, list = {},
             tools = {}, meshCache = {}, meshLoading = {},
             RarityOrder = { Godly = 1, Ancient = 2, Chroma = 3, Unique = 4, Classic = 5,
                             Legendary = 6, Rare = 7, Uncommon = 8, Common = 9 },
             FilterRarity = "Any", map = { Knife = {}, Gun = {} } }

-- ── SkinModel.decode: сериализованные свойства ({V,C,F,NR,E,CS,NS}) ──
local function skDecode(value)
    if type(value) ~= "table" then return value end
    local kind = value[1]
    if kind == "V" then return Vector3.new(value[2], value[3], value[4]) end
    if kind == "C" then return Color3.new(value[2], value[3], value[4]) end
    if kind == "F" then return CFrame.new(table.unpack(value, 2, 13)) end
    if kind == "NR" then return NumberRange.new(value[2], value[3]) end
    if kind == "E" then
        local ok, item = pcall(function() return Enum[value[2]][value[3]] end)
        return ok and item or nil
    end
    if kind == "CS" then
        local points = {}
        for index = 2, #value do
            local point = value[index]
            points[#points + 1] = ColorSequenceKeypoint.new(point[1], Color3.new(point[2], point[3], point[4]))
        end
        local ok, seq = pcall(ColorSequence.new, points)
        return ok and seq or nil
    end
    if kind == "NS" then
        local points = {}
        for index = 2, #value do
            local point = value[index]
            points[#points + 1] = NumberSequenceKeypoint.new(point[1], point[2], point[3] or 0)
        end
        local ok, seq = pcall(NumberSequence.new, points)
        return ok and seq or nil
    end
    return nil
end

local function skFrame(values) return CFrame.new(table.unpack(values, 1, 12)) end

-- ── MeshPart по content-строке, кэш как SkinModel.mesh ──
local function skMesh(meshId)
    if meshId == "" then return nil end
    if SK.meshCache[meshId] then return SK.meshCache[meshId]:Clone() end
    while SK.meshLoading[meshId] do task.wait() end
    if SK.meshCache[meshId] then return SK.meshCache[meshId]:Clone() end
    SK.meshLoading[meshId] = true
    local ok, result = pcall(function()
        return InsertService:CreateMeshPartAsync(meshId, Enum.CollisionFidelity.Box, Enum.RenderFidelity.Automatic)
    end)
    SK.meshLoading[meshId] = nil
    if not ok or not result then return nil end
    SK.meshCache[meshId] = result
    return result:Clone()
end

-- ── SkinModel.node/build: дерево {c,n,p,k,i,r,a} с неразрешёнными ссылками {R,idx} ──
local function skNode(data, root, references, unresolved)
    if type(data) ~= "table" then return nil end
    local object
    if data.c == "MeshPart" then
        object = skMesh(data.p and data.p.MeshId or "")
        if not object then
            object = Instance.new("Part")
            object.Transparency = 1
        end
    end
    if not object then
        local ok, created = pcall(Instance.new, data.c)
        if not ok or not created then return nil end
        object = created
    end
    object.Name = data.n
    for property, value in pairs(data.p or {}) do
        if not (property == "MeshId" and data.c == "MeshPart") then
            if type(value) == "table" and value[1] == "R" then
                unresolved[#unresolved + 1] = { object, property, value[2] }
            else
                local decoded = skDecode(value)
                if decoded ~= nil then pcall(function() object[property] = decoded end) end
            end
        end
    end
    if data.i then references[data.i] = object end
    if object:IsA("BasePart") then
        object.Anchored, object.CanCollide, object.CanQuery, object.CanTouch, object.Massless =
            false, false, false, false, true
        if root and data.r then
            local weld = Instance.new("Weld")
            weld.Name, weld.Part0, weld.Part1, weld.C0, weld.Parent =
                "PW", root, object, skFrame(data.r), object
        end
    end
    for key, value in pairs(data.a or {}) do
        pcall(function() object:SetAttribute(key, skDecode(value)) end)
    end
    local parentRoot = root or object
    for _, child in ipairs(data.k or {}) do
        local built = skNode(child, parentRoot, references, unresolved)
        if built then built.Parent = object end
    end
    return object
end

local function skBuild(data)
    local references, unresolved = {}, {}
    local root = skNode(data, nil, references, unresolved)
    if not root then return nil end
    for _, ref in ipairs(unresolved) do
        local target = references[ref[3]]
        if target then pcall(function() ref[1][ref[2]] = target end) end
    end
    return root
end

-- ── загрузка базы + каталог ──
local function skEntryLooksSkin(entry)
    if type(entry) ~= "table" then return false end
    -- форма v1.17 (деревья h/d) ИЛИ форма MM2 Database.Sync (ItemID + ItemName)
    return (entry.h or entry.d or (entry.ItemID and (entry.ItemName or entry.Name))) and true or false
end
local function skImgParse(v)
    if type(v) ~= "string" or v == "" then return "" end
    if v:find("^rbxassetid://") or v:find("^rbxasset://") or v:find("^http") then return v end
    local id = v:match("assetId=(%d+)") or v:match("id=(%d+)") or v:match("rbxassetid://(%d+)")
    return id and ("rbxassetid://" .. id) or ""
end
-- [v1.20] сбор asset-строк из записи скина (mesh/текстура) для фолбэка MM2:
-- у MM2 скины часто — просто текстура/меш на том же ноже
local function skHarvest(t, acc, depth)
    if type(t) ~= "table" or depth > 4 then return end
    for k, v in pairs(t) do
        local kl = tostring(k):lower()
        local tv = type(v)
        if tv == "string" then
            local id = v:match("assetId=(%d+)") or v:match("^rbxassetid://(%d+)")
            if not id and v:match("^%d+$") and #v >= 5 then id = v end
            if id then
                if kl:find("mesh") then
                    if not acc.mesh then acc.mesh = id end
                -- [v1.21] БЕЗ img/image — это иконки каталога, они красят
                -- оружие в серый. Только настоящие текстурные поля
                elseif kl:find("tex") or kl:find("map") or kl:find("skin") then
                    if not acc.tex then acc.tex = id end
                else
                    if not acc.any then acc.any = id end
                end
            end
        elseif tv == "table" then
            skHarvest(v, acc, depth + 1)
        end
    end
end
local function skKindOf(entry, key, pkey)
    local k = entry.t or entry.Type or entry.type or entry.ItemType
    if k == "Knife" or k == "Gun" then return k end
    if k == "Pet" then return nil end
    local lk = (tostring(key) .. " " .. tostring(pkey or "")):lower()
    if lk:find("gun") then return "Gun" end
    if lk:find("knife") then return "Knife" end
    local nm = tostring(entry.ItemName or entry.nm or entry.Name or ""):lower()
    if nm:find("gun") or nm:find("pistol") or nm:find("revolver") then return "Gun" end
    if nm:find("knife") or nm:find("blade") or nm:find("sword") then return "Knife" end
    return nil
end
local function skScanTable(db, depth, pkey)
    local found = {}
    if type(db) ~= "table" or depth > 3 then return found end
    for key, entry in pairs(db) do
        if skEntryLooksSkin(entry) then
            local kind = skKindOf(entry, key, pkey)
            if kind then
                found[#found + 1] = {
                    key = key, data = entry, kind = kind,
                    name = entry.ItemName or entry.nm or entry.Name or tostring(key),
                    rarity = entry.r or entry.Rarity or "None",
                    img = skImgParse(entry.Image or entry.img or entry.Thumbnail),
                }
            end
        elseif type(entry) == "table" and depth < 3 then
            local sub = skScanTable(entry, depth + 1, tostring(key))
            for _, item in ipairs(sub) do found[#found + 1] = item end
        end
    end
    local mt = getmetatable(db)
    if #found == 0 and mt and type(mt.__index) == "table" then
        local sub = skScanTable(mt.__index, depth + 1, pkey)
        for _, item in ipairs(sub) do found[#found + 1] = item end
    end
    return found
end
local function skLoadDB()
    if SK.db then return true end
    -- [v1.18] ремонт-2: перебираем ВСЕ ModuleScript внутри ReplicatedStorage.Database
    -- (по F9-диагностике Database есть, а какой из его детей — база скинов, не знаем),
    -- плюс Sync-пути и папки моделей по всему ReplicatedStorage
    local candidates = {}
    local function tryReq(ms, srcName)
        local ok, r = pcall(require, ms)
        if ok then candidates[#candidates + 1] = { db = r, src = srcName } end
    end
    pcall(function()
        local dbObj = ReplicatedStorage:WaitForChild("Database", 8)
        if dbObj then
            if dbObj:IsA("ModuleScript") then tryReq(dbObj, "Database (сам модуль)") end
            local kids = {}
            for _, ch in ipairs(dbObj:GetChildren()) do kids[#kids + 1] = ch.Name end
            print("[CWH] SKINS дети Database: " .. table.concat(kids, ", "))
            for _, ms in ipairs(dbObj:GetDescendants()) do
                if ms:IsA("ModuleScript") then tryReq(ms, "Database/" .. ms.Name) end
            end
        end
    end)
    pcall(function()
        local ms = ReplicatedStorage:WaitForChild("Sync", 3)
        if ms then tryReq(ms, "ReplicatedStorage.Sync") end
    end)
    pcall(function()
        for _, ms in ipairs(ReplicatedStorage:GetDescendants()) do
            if ms:IsA("ModuleScript") and ms.Name == "Sync" then
                tryReq(ms, "RS-рекурсия/" .. ms:GetFullName())
            end
        end
    end)
    local results, notes = {}, {}
    for _, cand in ipairs(candidates) do
        local list = skScanTable(cand.db, 0)
        notes[#notes + 1] = cand.src .. " → " .. tostring(#list)
        if #list > #results then
            results = list
            SK.db = cand.db
        end
    end
    SK.list = results
    SK.byKey = {}
    for _, item in ipairs(SK.list) do
        if item.data then SK.byKey[item.key] = item end
    end
    print("[CWH] SKINS DB: " .. (#notes > 0 and table.concat(notes, "; ") or "кандидатов нет"))
    if #SK.list == 0 then
        -- фолбэк: папки моделей скинов по ВСЕМУ ReplicatedStorage
        SK._seenFolders = SK._seenFolders or {}
        pcall(function()
            for _, ch in ipairs(ReplicatedStorage:GetDescendants()) do
                if ch:IsA("Folder") and not SK._seenFolders[ch.Name] then
                    local lname = ch.Name:lower()
                    local kind = (lname:find("gun") and "Gun") or (lname:find("knife") and "Knife") or nil
                    if kind then
                        SK._seenFolders[ch.Name] = true
                        local n = 0
                        for _, m in ipairs(ch:GetChildren()) do
                            if m:IsA("Model") or m:IsA("Tool") then
                                SK.list[#SK.list + 1] = {
                                    key = "mdl:" .. ch.Name .. ":" .. m.Name,
                                    name = m.Name, kind = kind, rarity = "модель", img = "",
                                    src = "mdl", mdlFolder = ch.Name, mdlName = m.Name,
                                }
                                n = n + 1
                            end
                        end
                        if n > 0 then print("[CWH] SKINS модели: " .. ch.Name .. " → " .. tostring(n)) end
                    end
                end
            end
        end)
    end
    if #SK.list > 0 then
        table.sort(SK.list, function(a, b)
            local ra = (SK.RarityOrder[a.rarity] or 9) + (a.kind == "Knife" and 0.5 or 0)
            local rb = (SK.RarityOrder[b.rarity] or 9) + (b.kind == "Knife" and 0.5 or 0)
            if ra ~= rb then return ra < rb end
            return a.name:lower() < b.name:lower()
        end)
        print("[CWH] SKINS: всего в каталоге: " .. tostring(#SK.list))
        return true
    end
    warn("[CWH] SKINS: база не нашлась — пришли строку «SKINS дети Database» из F9")
    return false
end

-- ── скрытие оригинала (порт WeaponSkins.hide) ──
local function skHide(entry, object, keepHidden)
    if object:IsA("BasePart") then
        entry.restore[#entry.restore + 1] =
            { object, "LocalTransparencyModifier", object.LocalTransparencyModifier }
        object.LocalTransparencyModifier = 1
        if keepHidden then
            entry.connections[#entry.connections + 1] =
                object:GetPropertyChangedSignal("LocalTransparencyModifier"):Connect(function()
                    if object.LocalTransparencyModifier ~= 1 then object.LocalTransparencyModifier = 1 end
                end)
        end
    elseif object:IsA("Decal") or object:IsA("Texture") then
        entry.restore[#entry.restore + 1] = { object, "Transparency", object.Transparency }
        object.Transparency = 1
    elseif object:IsA("ParticleEmitter") or object:IsA("Fire") or object:IsA("Smoke")
        or object:IsA("Sparkles") or object:IsA("Light") or object:IsA("Trail")
        or object:IsA("Highlight") then
        entry.restore[#entry.restore + 1] = { object, "Enabled", object.Enabled }
        object.Enabled = false
    end
end

-- ── сброс скина: всё возвращается как было ──
local function skClear(tool)
    local entry = SK.tools[tool]
    if not entry then return end
    SK.tools[tool] = nil
    for _, conn in ipairs(entry.connections) do pcall(function() conn:Disconnect() end) end
    if entry.visual then pcall(function() entry.visual:Destroy() end) end
    for _, saved in ipairs(entry.restore) do
        pcall(function() saved[1][saved[2]] = saved[3] end)
    end
    if entry.handle then pcall(function() entry.handle.LocalTransparencyModifier = 0 end) end
    if entry.oldTexture and tool.Parent then
        pcall(function() tool.TextureId = entry.oldTexture end)
    end
end

-- ── применение скина (порт WeaponSkins.applyTool, упрощённый) ──
local function skApply(tool, kind)
    skClear(tool)
    if not SK.On then return end
    local texswap = nil -- [v1.20] подмена текстуры/меша (фолбэк MM2)
    local key = SK.Sel[kind]
    if not key then return end
    local handle = tool:FindFirstChild("Handle") or tool:WaitForChild("Handle", 5)
    if not handle or not tool.Parent then return end
    local visual = nil
    local skin = nil
    if key:sub(1, 4) == "mdl:" then
        -- [v1.17] скин из моделей ReplicatedStorage (фолбэк без Database.Sync)
        pcall(function()
            local fld, nm = key:match("^mdl:(.+):(.+)$")
            local folder = fld and ReplicatedStorage:FindFirstChild(fld)
            local model = folder and folder:FindFirstChild(nm)
            if model then
                skin = { nm = nm }
                visual = model:Clone()
                if visual:IsA("Tool") then
                    local h2 = visual:FindFirstChild("Handle")
                    if h2 then visual = h2 end
                end
                local function dephys(bp)
                    bp.Anchored, bp.CanCollide, bp.CanQuery, bp.CanTouch, bp.Massless =
                        false, false, false, false, true
                end
                for _, bp2 in ipairs(visual:GetDescendants()) do
                    if bp2:IsA("BasePart") then dephys(bp2) end
                end
                if visual:IsA("BasePart") then dephys(visual) end
            end
        end)
        if not visual then return end
    else
        -- [v1.19] база MM2 (Database.Sync): записи лежат в Weapons[id] —
        -- берём сохранённую ссылку из каталога, а не по верхнему ключу
        local cat = SK.byKey and SK.byKey[key]
        skin = cat and cat.data or (SK.db and SK.db[key])
        if type(skin) ~= "table" then return end
        local data = skin.h or skin.d
        if data then visual = skBuild(data) end
        -- [v1.20] если 3D-дерева нет — пробуем подмену текстуры/меша на рукоятке
        if not visual then
            local acc = {}
            skHarvest(skin, acc, 0)
            if acc.mesh or acc.tex then
                texswap = { mesh = acc.mesh, tex = acc.tex }
                visual = "TEXSWAP"
            end
        end
    end
    local entry = { tool = tool, handle = handle, visual = visual, restore = {}, connections = {} }
    SK.tools[tool] = entry
    if visual == "TEXSWAP" then
        local sm = handle:FindFirstChildOfClass("SpecialMesh")
        if sm then
            if texswap.tex then
                entry.restore[#entry.restore + 1] = { sm, "TextureId", sm.TextureId }
                pcall(function() sm.TextureId = "rbxassetid://" .. texswap.tex end)
            end
            if texswap.mesh then
                entry.restore[#entry.restore + 1] = { sm, "MeshId", sm.MeshId }
                pcall(function() sm.MeshId = "rbxassetid://" .. texswap.mesh end)
            end
            Notify("Skins", tostring(kind) .. " → " .. tostring(skin.nm or skin.ItemName or key), "скин применён (текстура/меш)", 4)
            return
        end
        visual = nil
    end
    local img = (SK.byKey and SK.byKey[key] and SK.byKey[key].img) or skin.img
    if img and img ~= "" and tool.TextureId ~= img then
        entry.oldTexture = tool.TextureId
        pcall(function() tool.TextureId = img end)
    end
    if visual then
        visual.Name = "CWHVisual"
        local offset = tool.Grip
        if skin.g then offset = tool.Grip * skFrame(skin.g):Inverse() end
        local weld = Instance.new("Weld")
        weld.Name, weld.Part0, weld.Part1, weld.C0, weld.Parent =
            "CWHGrip", handle, visual, offset, visual
        visual.CFrame = handle.CFrame * offset
        visual.Parent = handle
        -- оригинал под скином прячем
        skHide(entry, handle, true)
        for _, obj in ipairs(tool:GetDescendants()) do
            if obj ~= visual and not obj:IsDescendantOf(visual) then
                skHide(entry, obj, obj:IsA("BasePart"))
            end
        end
        Notify("Skins", tostring(kind) .. " → " .. tostring(skin.nm or skin.ItemName or skin.Name or key), "скин применён (клиентский)", 4)
    else
        -- [v1.20] диагностика: какие поля реально есть у записи скина — смотри F9
        local keys = {}
        for k, v in pairs(skin) do
            keys[#keys + 1] = tostring(k) .. "=" .. type(v)
        end
        print("[CWH] SKINS DEBUG '" .. tostring(skin.nm or skin.ItemName or skin.Name or key) .. "': " .. table.concat(keys, ", "))
        Notify("Skins", "не удалось построить скин", "надень ОБЫЧНЫЙ нож/пистолет и попробуй снова (поля записи в F9)", 4)
        SK.tools[tool] = nil
    end
end

