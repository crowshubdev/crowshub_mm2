-- ─── FORCE SHOOT / WALLBANG (GUN) ─────────────────────────────
local discoveredShotRemote = nil

local function scanGunRemote()
    local gun = getGun()
    if not gun then return nil end
    for _, d in ipairs(gun:GetDescendants()) do
        if d:IsA("RemoteEvent") then
            discoveredShotRemote = d
            return d
        end
    end
    local direct = gun:FindFirstChildWhichIsA("RemoteEvent")
    if direct then
        discoveredShotRemote = direct
        return direct
    end
    return nil
end

task.spawn(function()
    while not getgenv().CWH_Unloaded do
        local gun = getGun()
        if gun and (not discoveredShotRemote or discoveredShotRemote.Parent ~= gun) then
            scanGunRemote()
        end
        task.wait(1)
    end
end)

local ForceShoot = {
    Enabled = false,
    Offset = 6,
    UseMurdererBack = true,
    AutoFire = false,
    AutoRange = 100,
    LastShot = 0,
}

local function getBackOrigin(murHRP)
    local murPos = murHRP.Position
    if ForceShoot.UseMurdererBack then
        local look = murHRP.CFrame.LookVector
        local flatLook = Vector3.new(look.X, 0, look.Z)
        if flatLook.Magnitude < 0.05 then return murPos + Vector3.new(0, 2, 0) end
        return murPos - flatLook.Unit * ForceShoot.Offset + Vector3.new(0, 1.5, 0)
    else
        local myHRP = SafeGetHRP(SafeGetCharacter(LocalPlayer))
        if not myHRP then return murPos + Vector3.new(0, 2, 0) end
        local dir = (murPos - myHRP.Position)
        dir = Vector3.new(dir.X, 0, dir.Z)
        if dir.Magnitude < 0.05 then return murPos + Vector3.new(0, 2, 0) end
        return murPos + dir.Unit * ForceShoot.Offset + Vector3.new(0, 1.5, 0)
    end
end

local function doForceShoot()
    local gun, equipped = getGun()
    if not gun then
        Notify("Force Shoot", "No gun!", nil, 3)
        return false
    end
    local remote = discoveredShotRemote or scanGunRemote()
    if not remote then
        Notify("Force Shoot", "Ремоут выстрела не найден", nil, 4)
        return false
    end
    local mur = GetMurderer()
    local murHRP = mur and SafeGetHRP(SafeGetCharacter(mur))
    if not murHRP then
        Notify("Force Shoot", "Murderer не найден", nil, 3)
        return false
    end
    if not equipped then
        local hum = SafeGetHumanoid(SafeGetCharacter(LocalPlayer))
        if hum then
            pcall(function() hum:EquipTool(gun) end)
            task.wait(0.15)
        end
    end
    local origin = getBackOrigin(murHRP)
    local targetPos = murHRP.Position
    local direction = (targetPos - origin).Unit * 500
    local attempts = {
        function() remote:FireServer(origin, direction) end,
        function() remote:FireServer(CFrame.new(origin, targetPos), direction) end,
        function() remote:FireServer(origin, targetPos) end,
        function() remote:FireServer(direction, origin) end,
    }
    for _, attempt in ipairs(attempts) do
        if pcall(attempt) then
            ForceShoot.LastShot = os.clock()
            return true
        end
    end
    Notify("Force Shoot", "Формат не подошёл — нужен remote spy", nil, 5)
    return false
end

-- Silent Force Shoot: подмена аргументов твоего обычного выстрела.
-- Работает с ЛЮБЫМ ремоутом внутри Gun — не зависит от найденного remote.
if realHookNamecall then
    local oldNamecall
    oldNamecall = realHookNamecall(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" and ForceShoot.Enabled then
            local parent = self and self.Parent
            if parent and (parent.Name == "Events" or parent.Name == "Gun")
                and parent.Parent and parent.Parent.Name == "Gun" then
                local mur = GetMurderer()
                local murHRP = mur and SafeGetHRP(SafeGetCharacter(mur))
                if murHRP then
                    local origin = getBackOrigin(murHRP)
                    local targetPos = murHRP.Position
                    local direction = (targetPos - origin).Unit * 500
                    -- подмена: первый Vector3/CFrame = origin, второй = направление
                    local args = { ... }
                    local replaced = 0
                    for i = 1, #args do
                        local t = typeof(args[i])
                        if (t == "Vector3" or t == "CFrame") and replaced == 0 then
                            args[i] = (t == "CFrame") and CFrame.new(origin, targetPos) or origin
                            replaced = 1
                        elseif t == "Vector3" and replaced == 1 then
                            args[i] = direction
                            replaced = 2
                            break
                        end
                    end
                    if replaced == 0 then
                        return oldNamecall(self, origin, direction)
                    end
                    return oldNamecall(self, table.unpack(args))
                end
            end
        end
        return oldNamecall(self, ...)
    end)
end

task.spawn(function()
    while not getgenv().CWH_Unloaded do
        if ForceShoot.AutoFire and discoveredShotRemote then
            local mur = GetMurderer()
            local murHRP = mur and SafeGetHRP(SafeGetCharacter(mur))
            local myHRP = SafeGetHRP(SafeGetCharacter(LocalPlayer))
            if murHRP and myHRP then
                local dist = (murHRP.Position - myHRP.Position).Magnitude
                if dist <= ForceShoot.AutoRange and os.clock() - ForceShoot.LastShot > 1 then
                    doForceShoot()
                end
            end
        end
        task.wait(0.2)
    end
end)

