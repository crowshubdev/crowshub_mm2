-- DUAL WEAPON v2.3 (Исправлен возврат руки и зеркальный поворот)
local dualOn = true
local dualModel = nil

local originalLeftShoulderC0 = nil

local function resetLeftArmAnimation(char)
    if not char then return end
    local leftUpperArm = char:FindFirstChild("LeftUpperArm")
    local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    
    local shoulder = nil
    if leftUpperArm then
        shoulder = leftUpperArm:FindFirstChild("LeftShoulder")
    elseif torso then
        shoulder = torso:FindFirstChild("Left Shoulder")
    end

    if shoulder and originalLeftShoulderC0 then
        shoulder.C0 = originalLeftShoulderC0
        originalLeftShoulderC0 = nil -- Сбрасываем кэш, чтобы при следующем взятии зафиксировать чистый дефолт
    end
end

local function applyLeftArmAnimation(char)
    if not char then return end
    local leftUpperArm = char:FindFirstChild("LeftUpperArm")
    local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    
    local shoulder = nil
    if leftUpperArm then
        shoulder = leftUpperArm:FindFirstChild("LeftShoulder")
    elseif torso then
        shoulder = torso:FindFirstChild("Left Shoulder")
    end

    if shoulder then
        -- Сохраняем оригинал ТОЛЬКО если он ещё не сохранён
        if not originalLeftShoulderC0 then
            originalLeftShoulderC0 = shoulder.C0
        end
        
        -- Зеркальные углы для левой руки, чтобы она симметрично держала второй предмет
        -- Меняем знаки у углов, чтобы рука не выворачивалась назад
        shoulder.C0 = originalLeftShoulderC0 * CFrame.Angles(math.rad(90), 0, math.rad(10))
    end
end

local function removeDual()
    local char = LocalPlayer.Character
    if char then
        resetLeftArmAnimation(char)
    end
    if dualModel then
        pcall(function() dualModel:Destroy() end)
        dualModel = nil
    end
end

local function addDual()
    removeDual()
    local char = LocalPlayer.Character
    if not char then return end

    local myRole = getRole(LocalPlayer)
    local toolName = (myRole == "Murderer" and "Knife") or ((myRole == "Sheriff" or myRole == "Hero") and "Gun")
    if not toolName then return end

    local tool = char:FindFirstChild(toolName)
    if not tool then return end

    local leftArm = char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftHand") or char:FindFirstChild("LeftUpperArm")
    local rightArm = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightHand") or char:FindFirstChild("RightUpperArm")
    if not leftArm or not rightArm then return end

    local gripWeld = nil
    for _, w in ipairs(rightArm:GetDescendants()) do
        if (w:IsA("Weld") or w:IsA("Motor6D")) and w.Part1 and w.Part1:IsDescendantOf(tool) then
            gripWeld = w
            break
        end
    end

    local srcParts = {}
    local handleSrc = nil
    for _, c in ipairs(tool:GetDescendants()) do
        if c:IsA("BasePart") then
            srcParts[#srcParts + 1] = c
            if c.Name == "Handle" or handleSrc == nil then handleSrc = c end
        end
    end
    if not handleSrc then return end

    local holder = Instance.new("Model")
    holder.Name = "CWH_DualWeapon"
    local clones = {}
    for _, p in ipairs(srcParts) do
        local c = p:Clone()
        for _, d in ipairs(c:GetChildren()) do
            if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript")
                or d:IsA("Weld") or d:IsA("Motor6D") or d:IsA("WeldConstraint") then
                d:Destroy()
            end
        end
        c.CanCollide = false
        c.Massless = true
        c.Anchored = true
        c.Name = "CWH_Dual_" .. p.Name
        clones[p] = c
        c.Parent = holder
    end

    local newHandle = clones[handleSrc]
    if not newHandle then holder:Destroy() return end

    local gripC0 = gripWeld and gripWeld.C0 or tool.Grip
    local gripC1 = gripWeld and gripWeld.C1 or CFrame.new()
    local mirrorC0 = gripC0 * CFrame.Angles(0, math.rad(180), 0)

    local targetArmPart = char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftHand")
    if not targetArmPart then targetArmPart = leftArm end

    local handleCF = targetArmPart.CFrame * mirrorC0 * gripC1:Inverse()

    newHandle.CFrame = handleCF
    for src, c in pairs(clones) do
        if src ~= handleSrc then
            c.CFrame = handleCF * handleSrc.CFrame:ToObjectSpace(src.CFrame)
        end
    end

    holder.Parent = char

    for src, c in pairs(clones) do
        c.Anchored = false
        local w = Instance.new("Weld")
        if src == handleSrc then
            w.Part0 = targetArmPart
            w.Part1 = c
            w.C0 = mirrorC0
            w.C1 = gripC1
        else
            w.Part0 = newHandle
            w.Part1 = c
            w.C0 = handleSrc.CFrame:ToObjectSpace(src.CFrame)
        end
        w.Parent = c
    end

    applyLeftArmAnimation(char)
    dualModel = holder
end

-- Цикл проверки состояния оружия
