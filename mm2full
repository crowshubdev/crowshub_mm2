    Settings.CurrentTheme = themeName

    for _, obj in ipairs(Themeable.MainFrameBg) do obj.BackgroundColor3 = theme.Background end
    for _, obj in ipairs(Themeable.MainFrameStroke) do obj.Color = theme.Stroke end
    for _, obj in ipairs(Themeable.Titles) do obj.TextColor3 = theme.Title end
    for _, obj in ipairs(Themeable.Buttons) do
        if not obj:GetAttribute("IsToggleActive") then
            obj.BackgroundColor3 = theme.Button
