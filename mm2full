----------------------------------------------------------------
-- TAB 1: MAIN (FOV & Movement)
----------------------------------------------------------------
local DefaultFOV = Camera.FieldOfView
local TargetFOV = 120
local FOVEnabled = false

local FOVToggle = Tabs.Main:AddToggle("FOVToggle", { Title = "Enable FOV Changer", Default = false })
FOVToggle:OnChanged(function(Value)
    FOVEnabled = Value
    if not Value then Camera.FieldOfView = DefaultFOV end
end)

Tabs.Main:AddInput("FOVInput", {
    Title = "FOV Value",
    Default = "120",
    Numeric = true,
    Finished = true,
    Callback = function(Value)
        local Num = tonumber(Value)
        if Num and Num >= 30 and Num <= 140 then
            TargetFOV = Num
            if FOVEnabled then Camera.FieldOfView = TargetFOV end
        end
    end
})

RunService.RenderStepped:Connect(function()
    if FOVEnabled and Camera.FieldOfView ~= TargetFOV then
        Camera.FieldOfView = TargetFOV
    end
end)

----------------------------------------------------------------
-- TAB 2: VISUALS (ESP Player, Gun, Traps)
----------------------------------------------------------------
local ESP_Players = false
local ESP_Gun = false
local ESP_Traps = false

local Highlights = {}

local function CreateHighlight(plr)
    if plr == LocalPlayer or not plr.Character then return end
    
    local char = plr.Character
    if not char:FindFirstChild("CrowsHighlight") then
        local hl = Instance.new("Highlight")
        hl.Name = "CrowsHighlight"
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
        
        -- Роли в MM2
        local backpack = plr:FindFirstChild("Backpack")
        if (backpack and backpack:FindFirstChild("Knife")) or char:FindFirstChild("Knife") then
            hl.FillColor = Color3.fromRGB(255, 50, 50) -- Murderer (Красный)
        elseif (backpack and backpack:FindFirstChild("Gun")) or char:FindFirstChild("Gun") then
            hl.FillColor = Color3.fromRGB(50, 100, 255) -- Sheriff (Синий)
        else
            hl.FillColor = Color3.fromRGB(50, 255, 50) -- Innocent (Зеленый)
        end
        
        hl.Parent = char
    end
end

local function ClearHighlights()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Character and plr.Character:FindFirstChild("CrowsHighlight") then
            plr.Character.CrowsHighlight:Destroy()
        end
    end
end

local PlayerESPToggle = Tabs.Visuals:AddToggle("PlayerESP", { Title = "Player ESP (Roles Highlight)", Default = false })
PlayerESPToggle:OnChanged(function(Value)
    ESP_Players = Value
    if not Value then ClearHighlights() end
end)

local GunESPToggle = Tabs.Visuals:AddToggle("GunESP", { Title = "Dropped Gun ESP", Default = false })
GunESPToggle:OnChanged(function(Value)
    ESP_Gun = Value
end)

-- Loop ESP Updates
RunService.Stepped:Connect(function()
    if ESP_Players then
        for _, plr in pairs(Players:GetPlayers()) do
            CreateHighlight(plr)
        end
    end
    
    -- Gun ESP & Traps ESP
    if ESP_Gun then
        local gun = workspace:FindFirstChild("GunDrop", true)
        if gun and not gun:FindFirstChild("GunHighlight") then
            local hl = Instance.new("Highlight")
            hl.Name = "GunHighlight"
            hl.FillColor = Color3.fromRGB(255, 215, 0) -- Золотой цвет
            hl.Parent = gun
        end
    end
end)

----------------------------------------------------------------
-- TAB 3: WORLD & GAME NOTIFICATIONS
----------------------------------------------------------------
local function PullGunToPlayer()
    local gun = workspace:FindFirstChild("GunDrop", true) or workspace:FindFirstChild("Gun", true)
    if gun and gun:IsA("BasePart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        gun.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame
        Fluent:Notify({
            Title = "World Action",
            Content = "Attempted to bring Gun to you!",
            Duration = 4
        })
    end
end

Tabs.World:AddButton({
    Title = "Grab Gun Now",
    Description = "Teleports dropped gun to your position",
    Callback = PullGunToPlayer
})

-- Отслеживание выпадения пистолета и уведомление на 6 секунд
workspace.ChildAdded:Connect(function(child)
    if child.Name:lower():find("gun") then
        Fluent:Notify({
            Title = "MM2 Event",
            Content = "Gun dropped on the map!",
            SubContent = "Pick it up quickly!",
            Duration = 6
        })
    end
end)

