-- ═══════════════════════════════════════════════════════════════
-- DODGE MURDER (телепорт от убийцы при опасной дистанции)
-- ═══════════════════════════════════════════════════════════════
local DodgeMurder = {
    On = false, TriggerDist = 25, TeleportDist = 70, Cooldown = 2, Last = 0,
}

local function doDodgeMurder()
    local char = getChar(LocalPlayer)
    local hrp = getHRP(char)
    local hum = getHum(char)
    if not (hrp and hum and hum.Health > 0) then return false end

    local now = os.clock()
    if now - DodgeMurder.Last < DodgeMurder.Cooldown then return false end

    local mur = getMurderer()
    local mHRP = mur and getHRP(getChar(mur))
    if not mHRP then return false end

    local dist = (mHRP.Position - hrp.Position).Magnitude
    if dist > DodgeMurder.TriggerDist then return false end

    -- телепорт на случайную точку на окружности TeleportDist от меня
    local angle = math.random() * math.pi * 2
    local r = DodgeMurder.TeleportDist
    local target = hrp.Position + Vector3.new(
        math.cos(angle) * r,
        0,
        math.sin(angle) * r
    )

    -- если murder оказался ближе к новой точке чем мы — разворачиваем на 180
    if (target - mHRP.Position).Magnitude < (hrp.Position - mHRP.Position).Magnitude then
        target = hrp.Position - Vector3.new(
            math.cos(angle) * r,
            0,
            math.sin(angle) * r
        )
    end

    hrp.CFrame = CFrame.new(target)
    DodgeMurder.Last = now
    Notify("Dodge Murder", "💨 Телепорт от " .. mur.Name .. "!", nil, 2)
    return true
end

