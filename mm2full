local ESPConfig = {
    Players = false,
    Names = false,
    Distance = false,
    Health = false
}

local roleCache = {}
local roleCacheTime = 0

local function getCachedRole(plr)
    local now = os.clock()
    if now - roleCacheTime > 0.5 then
        roleCache = {}
        roleCacheTime = now
    end
    if not roleCache[plr] then roleCache[plr] = GetRole(plr) end
    return roleCache[plr]
end

local function createPlayerHighlight(player)
    local char = SafeGetCharacter(player)
    if not char then return end
    if char:FindFirstChild("CrowsESP_HL") then return end
    local hl = Instance.new("Highlight")
    hl.Name = "CrowsESP_HL"
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillTransparency = 0.6
    hl.OutlineTransparency = 0.2
