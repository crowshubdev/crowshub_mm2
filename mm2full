    Names = false,
    Distance = false,
    Health = false,
    Mode = "Highlight"
}

local ESPObjects = {}
local GunESPObject = nil

local function ClearPlayerESP(player)
    local data = ESPObjects[player]
    if not data then return end
    if data.Highlight and data.Highlight.Parent then data.Highlight:Destroy() end
    if data.NameTag and data.NameTag.Parent then data.NameTag:Destroy() end
    if data.HealthBar and data.HealthBar.Parent then data.HealthBar:Destroy() end
    ESPObjects[player] = nil
end

local function ClearAllESP()
    for player, _ in pairs(ESPObjects) do ClearPlayerESP(player) end
    ESPObjects = {}
    if GunESPObject then
        if GunESPObject.Highlight and GunESPObject.Highlight.Parent then GunESPObject.Highlight:Destroy() end
        if GunESPObject.NameTag and GunESPObject.NameTag.Parent then GunESPObject.NameTag:Destroy() end
        GunESPObject = nil
    end
end

