-- Murderer Helper Function
local function GetMurderer()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local backpack = player:FindFirstChild("Backpack")
            local char = player.Character
            if (backpack and backpack:FindFirstChild("Knife")) or (char and char:FindFirstChild("Knife")) then
                return player
            end
        end
    end
    return nil
end

-- Shoot Logic Function
local function ShootMurderer()
    local character = LocalPlayer.Character
    if not character then return end
    
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local gun = (backpack and backpack:FindFirstChild("Gun")) or (character:FindFirstChild("Gun"))
    
    if not gun then
        return
    end

    -- Equip gun if in backpack
    if gun.Parent == backpack then
        gun.Parent = character
    end

    local murderer = GetMurderer()
    if murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart") then
        local targetHrp = murderer.Character.HumanoidRootPart
        local gunShootRemote = gun:FindFirstChild("Shoot") or gun:FindFirstChild("ShootRemote") or game:GetService("ReplicatedStorage"):FindFirstChild("Shoot", true)
        
        if gunShootRemote then
            local targetPos = targetHrp.Position + (targetHrp.Velocity * 0.1)
            if gunShootRemote:IsA("RemoteEvent") then
                gunShootRemote:FireServer(CFrame.new(character.HumanoidRootPart.Position, targetPos), targetPos)
            elseif gunShootRemote:IsA("RemoteFunction") then
                gunShootRemote:InvokeServer(CFrame.new(character.HumanoidRootPart.Position, targetPos), targetPos)
            end
        end
    end
end

