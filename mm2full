-- Auto Farm Loop
task.spawn(function()
    while true do
        if AutoFarm.Enabled then
            local hrp = SafeGetHRP(SafeGetCharacter(LocalPlayer))
            if hrp then
                if AutoFarm.CollectedCoins >= AutoFarm.MaxCoins then
                    if AutoFarm.AfterTeleport == "Void" then
                        hrp.CFrame = CFrame.new(0, -500, 0)
                    elseif AutoFarm.AfterTeleport == "Lobby" then
                        local lobby = workspace:FindFirstChild("Lobby") or workspace:FindFirstChild("lobby")
                        if lobby and lobby:IsA("BasePart") then
                            hrp.CFrame = lobby.CFrame + Vector3.new(0, 5, 0)
                        else
                            hrp.CFrame = CFrame.new(0, 100, 0)
                        end
                    elseif AutoFarm.AfterTeleport == "Map" then
                        local spawns = {}
                        for _, obj in pairs(workspace:GetDescendants()) do
                            if obj:IsA("SpawnLocation") then table.insert(spawns, obj) end
                        end
                        if #spawns > 0 then
                            hrp.CFrame = spawns[math.random(1, #spawns)].CFrame + Vector3.new(0, 5, 0)
                        end
                    end
                    AutoFarm.Enabled = false
                    Notify("Auto Farm", "Max coins reached! (" .. AutoFarm.MaxCoins .. ")", "Teleported to " .. AutoFarm.AfterTeleport, 5)
                else
                    local coins = GetCoins()
                    local murderer = GetMurderer()
                    local mHRP = murderer and SafeGetHRP(SafeGetCharacter(murderer))
                    local bestCoin = nil
                    local bestDist = math.huge

                    for _, coin in pairs(coins) do
                        if coin and coin.Parent then
                            local coinPos = coin.Position
                            local dist = (hrp.Position - coinPos).Magnitude

                            if AutoFarm.AvoidMurder and mHRP then
                                local murderDist = (mHRP.Position - coinPos).Magnitude
                                if murderDist < AutoFarm.AvoidRange then
                                    continue
                                end
                            end

                            if dist < bestDist then
                                bestDist = dist
                                bestCoin = coin
                            end
                        end
                    end

                    if bestCoin then
                        if AutoFarm.CoinAura and bestDist <= AutoFarm.AuraRange then
                            hrp.CFrame = CFrame.new(bestCoin.Position.X, hrp.Position.Y, bestCoin.Position.Z)
                            AutoFarm.CollectedCoins = AutoFarm.CollectedCoins + 1
                            if AutoFarm.Delay > 0 then task.wait(AutoFarm.Delay) end
                        else
                            local targetPos = bestCoin.Position
                            if AutoFarm.Mode == "UnderMap" then
                                targetPos = Vector3.new(bestCoin.Position.X, AutoFarm.UnderMapY, bestCoin.Position.Z)
                            end
                            local direction = (targetPos - hrp.Position).Unit
                            hrp.CFrame = hrp.CFrame + direction * AutoFarm.Speed * 0.03

                            if (hrp.Position - bestCoin.Position).Magnitude < 5 then
                                AutoFarm.CollectedCoins = AutoFarm.CollectedCoins + 1
                                if AutoFarm.Delay > 0 then task.wait(AutoFarm.Delay) end
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.03)
    end
end)
