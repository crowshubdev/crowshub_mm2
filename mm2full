----------------------------------------------------------------
-- Smart Auto Farm Core Logic (With 75 Studs Avoidance)
----------------------------------------------------------------
task.spawn(function()
    while task.wait(0.2) do
        if Settings.AutoFarm and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = LocalPlayer.Character.HumanoidRootPart
            local coinContainer = workspace:FindFirstChild("CoinContainer", true)
            
            local coinData = LocalPlayer:FindFirstChild("CoinData") or LocalPlayer:FindFirstChild("leaderstats")
            local currentCoins = coinData and coinData:FindFirstChild("Coins") and coinData.Coins.Value or 0
            
            -- Check Murderer Proximity
            local murderer = GetMurderer()
            local isMurdererNear = false
            if Settings.AvoidMurderer and murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart") then
                local mHrp = murderer.Character.HumanoidRootPart
                if (hrp.Position - mHrp.Position).Magnitude <= Settings.AvoidDistance then
                    isMurdererNear = true
                end
            end

            if isMurdererNear then
                -- Drop below floor dynamically to avoid getting killed
                hrp.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y - 12, hrp.Position.Z)
                task.wait(0.5)
            elseif currentCoins >= Settings.MaxCoins then
                local hasKnife = LocalPlayer.Backpack:FindFirstChild("Knife") or LocalPlayer.Character:FindFirstChild("Knife")
                if hasKnife and Settings.AutoKill then
                    for _, v in pairs(Players:GetPlayers()) do
                        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                            hrp.CFrame = v.Character.HumanoidRootPart.CFrame
                            task.wait(0.2)
                        end
                    end
                elseif Settings.SafeVoid then
                    hrp.CFrame = CFrame.new(0, -300, 0)
                end
            elseif coinContainer then
                -- Find coin furthest from murderer if murderer exists
                local bestCoin = nil
                local maxDistFromMurderer = -1
                
                local coinsList = coinContainer:GetChildren()
                for _, coin in pairs(coinsList) do
                    if coin:IsA("BasePart") and coin.Name == "Coin" then
                        if murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart") then
                            local distToM = (coin.Position - murderer.Character.HumanoidRootPart.Position).Magnitude
                            if distToM > maxDistFromMurderer then
                                maxDistFromMurderer = distToM
                                bestCoin = coin
                            end
                        else
                            bestCoin = coin
                            break
                        end
                    end
                end

                if bestCoin then
                    local targetPos = bestCoin.Position
                    if Settings.Underground then
                        targetPos = targetPos - Vector3.new(0, 7, 0)
                    end
                    
                    local dist = (hrp.Position - targetPos).Magnitude
                    local tween = TweenService:Create(hrp, TweenInfo.new(dist / Settings.TweenSpeed, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
                    tween:Play()
                    
                    -- Dynamic cancel if murderer gets too close during tween
                    while tween.PlaybackState == Enum.PlaybackState.Playing do
                        if Settings.AvoidMurderer and murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart") then
                            if (hrp.Position - murderer.Character.HumanoidRootPart.Position).Magnitude <= Settings.AvoidDistance then
                                tween:Cancel()
                                break
                            end
                        end
                        task.wait(0.05)
                    end
                    
                    if Settings.CoinAura then
                        firetouchinterest(hrp, bestCoin, 0)
                        task.wait()
                        firetouchinterest(hrp, bestCoin, 1)
                    end
                    
                    if Settings.TweenDelay > 0 then task.wait(Settings.TweenDelay) end
                end
            end
        end
    end
end)

