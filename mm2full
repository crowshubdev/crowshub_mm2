do -- ═══ [CWH SCOPE] G17: KNIFE AURA (порт из Overdrive) ═══
-- ═══════════════════════════════════════════════════════════════
-- [v1.17] Механика Overdrive (Reworked Knife Aura): нож в руках сам «касается»
-- жертвы (firetouch Handle ↔ HRP) + прямой ремоут Stab:FireServer(позиция) —
-- попадание засчитывается, даже если махнул мимо. Только когда у тебя нож.
local KA = { On = false, Radius = 12, Target = "Все", Last = 0 }
task.spawn(function()
    while task.wait(0.05) do
        if not getgenv().CWH_RUN then break end
        pcall(function()
            if not KA.On then return end
            if os.clock() - KA.Last < 0.15 then return end
            local c = getChar(LocalPlayer)
            if not c then return end
            if getRole(LocalPlayer) ~= "Murderer" then return end
            local knife = c:FindFirstChild("Knife")
            if not knife then
                local bp = LocalPlayer:FindFirstChild("Backpack")
                local bk = bp and bp:FindFirstChild("Knife")
                local hum = getHum(c)
                if bk and hum then pcall(function() hum:EquipTool(bk) end) end
                return
            end
            local handle = knife:FindFirstChild("Handle")
            local stab = knife:FindFirstChild("Stab")
            local myHRP = getHRP(c)
            if not (handle and myHRP) then return end
            local best, bd = nil, math.huge
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    local role = getRole(p)
                    local want = (KA.Target ~= "Только шериф") or (role == "Sheriff")
                    local h = getHum(getChar(p))
                    local eHRP = getHRP(getChar(p))
                    if want and h and h.Health > 0 and eHRP then
                        local d = (eHRP.Position - myHRP.Position).Magnitude
                        if d <= KA.Radius and d < bd then best = eHRP bd = d end
                    end
                end
            end
            if best then
                KA.Last = os.clock()
                if realFireTouch then
                    realFireTouch(handle, best, 1)
                    realFireTouch(handle, best, 0)
                end
                if stab and type(stab.FireServer) == "function" then
                    pcall(function() stab:FireServer(best.Position) end)
                end
            end
        end)
    end
end)
