-- ═══════════════════════════════════════════════════════════════
-- FLING v2 (ИСПРАВЛЕННЫЙ + Stop Fling)
-- ═══════════════════════════════════════════════════════════════

local FlingSystem = {
    Murderer = false,
    Sheriff = false,
    SelectedPlayer = nil,
    IsActive = false
}

local fling_original_pos = nil
local fling_should_stop = false

-- ─── Главная функция fling ─────────────────────────────────
local function doFling(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return end
    if FlingSystem.IsActive then return end

    local myChar = SafeGetCharacter(LocalPlayer)
    local myHRP = SafeGetHRP(myChar)
    local myHum = SafeGetHumanoid(myChar)

    local tChar = targetPlayer.Character
    local tHRP = SafeGetHRP(tChar)
    local tHum = SafeGetHumanoid(tChar)

    if not myHRP or not myHum or not tHRP or not tHum then return end
    if tHum.Sit then return end

    FlingSystem.IsActive = true
    fling_should_stop = false
    getgenv().FLING_ACTIVE = (getgenv().FLING_ACTIVE or 0) + 1

    -- Сохраняем позицию
    if myHRP.Velocity.Magnitude < 50 then
        fling_original_pos = myHRP.CFrame
        getgenv().OldPos = myHRP.CFrame
    end

    local old_fdh = workspace.FallenPartsDestroyHeight
    local camera = workspace.CurrentCamera
    
    -- Переключаем камеру на цель
    if camera then
        camera.CameraSubject = tHRP
    end
    
    pcall(function() workspace.FallenPartsDestroyHeight = 0/0 end)

    -- BodyVelocity
    local bv = Instance.new("BodyVelocity")
    bv.Parent = myHRP
    bv.Velocity = Vector3.zero
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)

    local se = myHum:GetStateEnabled(Enum.HumanoidStateType.Seated)
    myHum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

    local ang = 0
    local start_time = tick()
    local MAX_TIME = 5  -- максимум 5 секунд флинга

    repeat
        -- Проверка на Stop
        if fling_should_stop then
            break
        end
        
        -- Проверка таймаута
        if tick() - start_time > MAX_TIME then
            break
        end

        if myHRP and myHRP.Parent and tHRP and tHRP.Parent then
            local tv = tHRP.Velocity

            if tv.Magnitude < 50 then
                ang = ang + 100

                -- Позиция 1: сверху
                myHRP.CFrame = CFrame.new(tHRP.Position) 
                    * CFrame.new(0, 1.5, 0) 
                    + tHum.MoveDirection * tv.Magnitude / 1.25
                myHRP.CFrame = myHRP.CFrame * CFrame.Angles(math.rad(ang), 0, 0)
                myChar:SetPrimaryPartCFrame(myHRP.CFrame)
                myHRP.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
                myHRP.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
                task.wait()

                -- Позиция 2: снизу
                myHRP.CFrame = CFrame.new(tHRP.Position)
                    * CFrame.new(0, -1.5, 0)
                    + tHum.MoveDirection * tv.Magnitude / 1.25
                myHRP.CFrame = myHRP.CFrame * CFrame.Angles(math.rad(ang), 0, 0)
                myChar:SetPrimaryPartCFrame(myHRP.CFrame)
                myHRP.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
                myHRP.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
                task.wait()

                -- Позиция 3: диагональ 1
                myHRP.CFrame = CFrame.new(tHRP.Position)
                    * CFrame.new(2.25, 1.5, -2.25)
                    + tHum.MoveDirection * tv.Magnitude / 1.25
                myHRP.CFrame = myHRP.CFrame * CFrame.Angles(math.rad(ang), 0, 0)
                myChar:SetPrimaryPartCFrame(myHRP.CFrame)
                myHRP.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
                myHRP.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
                task.wait()

                -- Позиция 4: диагональ 2
                myHRP.CFrame = CFrame.new(tHRP.Position)
                    * CFrame.new(-2.25, -1.5, 2.25)
                    + tHum.MoveDirection * tv.Magnitude / 1.25
                myHRP.CFrame = myHRP.CFrame * CFrame.Angles(math.rad(ang), 0, 0)
                myChar:SetPrimaryPartCFrame(myHRP.CFrame)
                myHRP.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
                myHRP.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
                task.wait()

                -- Позиция 5: короткая
                myHRP.CFrame = CFrame.new(tHRP.Position) * CFrame.new(0, 1.5, 0) + tHum.MoveDirection
                myHRP.CFrame = myHRP.CFrame * CFrame.Angles(math.rad(ang), 0, 0)
                myChar:SetPrimaryPartCFrame(myHRP.CFrame)
                myHRP.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
                myHRP.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
                task.wait()

                -- Позиция 6: короткая снизу
                myHRP.CFrame = CFrame.new(tHRP.Position) * CFrame.new(0, -1.5, 0) + tHum.MoveDirection
                myHRP.CFrame = myHRP.CFrame * CFrame.Angles(math.rad(ang), 0, 0)
                myChar:SetPrimaryPartCFrame(myHRP.CFrame)
                myHRP.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
                myHRP.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
                task.wait()
            else
                -- Быстрый режим (когда цель движется)
                myHRP.CFrame = CFrame.new(tHRP.Position) * CFrame.new(0, 1.5, tHum.WalkSpeed)
                myHRP.CFrame = myHRP.CFrame * CFrame.Angles(math.rad(90), 0, 0)
                myChar:SetPrimaryPartCFrame(myHRP.CFrame)
                myHRP.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
                myHRP.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
                task.wait()

                myHRP.CFrame = CFrame.new(tHRP.Position) * CFrame.new(0, -1.5, -tHum.WalkSpeed)
                myHRP.CFrame = myHRP.CFrame * CFrame.Angles(0, 0, 0)
                myChar:SetPrimaryPartCFrame(myHRP.CFrame)
                myHRP.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
                myHRP.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
                task.wait()
            end
        end
    until false

    -- Очистка
    if bv then bv:Destroy() end
    myHum:SetStateEnabled(Enum.HumanoidStateType.Seated, se)
    if camera and myHum then
        camera.CameraSubject = myHum
    end
    pcall(function() workspace.FallenPartsDestroyHeight = old_fdh end)

    -- Возвращаемся на позицию
    if fling_original_pos and myHRP then
        local target_pos = fling_original_pos.p
        local attempts = 0
        repeat
            attempts = attempts + 1
            myHRP.CFrame = fling_original_pos * CFrame.new(0, 0.5, 0)
            myChar:SetPrimaryPartCFrame(fling_original_pos * CFrame.new(0, 0.5, 0))
            myHum:ChangeState(Enum.HumanoidStateType.GettingUp)
            for _, x in ipairs(myChar:GetChildren()) do
                if x:IsA("BasePart") then
                    x.Velocity = Vector3.zero
                    x.RotVelocity = Vector3.zero
                end
            end
            task.wait()
        until not fling_original_pos 
            or not myHRP.Parent 
            or (myHRP.Position - target_pos).Magnitude < 25
            or attempts > 50
    end

    getgenv().FLING_ACTIVE = math.max(0, (getgenv().FLING_ACTIVE or 1) - 1)
    FlingSystem.IsActive = false
    fling_original_pos = nil
end

-- ─── Функция Stop Fling ────────────────────────────────────
