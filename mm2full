local function Notify(Title, Content, SubContent, Duration)
    Fluent:Notify({
        Title = Title or "Crows Hub",
        Content = Content or "",
        SubContent = SubContent or "",
        Duration = Duration or 4
    })
end

local function SafeGetCharacter(player)
    return player and player.Character
end

local function SafeGetHumanoid(char)
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function SafeGetHRP(char)
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function GetRole(player)
    local char = SafeGetCharacter(player)
    if not char then return "Unknown" end
    local backpack = player:FindFirstChild("Backpack")
    local hasKnife = (backpack and backpack:FindFirstChild("Knife")) or char:FindFirstChild("Knife")
    local hasGun = (backpack and backpack:FindFirstChild("Gun")) or char:FindFirstChild("Gun")
    if hasKnife then return "Murderer" end
    if hasGun then return "Sheriff" end
    return "Innocent"
end

local function GetRoleColor(role)
    local colors = {
        Murderer = Color3.fromRGB(255, 0, 0),
        Sheriff = Color3.fromRGB(0, 100, 255),
        Innocent = Color3.fromRGB(0, 255, 0),
        Unknown = Color3.fromRGB(150, 150, 150)
    }
    return colors[role] or colors.Unknown
end

local function GetMurderer()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and GetRole(plr) == "Murderer" then return plr end
    end
    return nil
end

local function GetSheriff()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and GetRole(plr) == "Sheriff" then return plr end
    end
    return nil
end

local function GetCoins()
    local coins = {}
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name:lower():find("coin") or obj.Name:lower():find("collectible")) then
            table.insert(coins, obj)
        end
    end
    return coins
end

