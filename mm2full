local AutoGrabGun = false
local originalBrightness = Lighting.Brightness

local function hookMap(model)
    if model:GetAttribute("CWHHooked") then return end
    model:SetAttribute("CWHHooked", true)
    model.ChildAdded:Connect(function(child)
        if child.Name == "GunDrop" then
            GunDropSound:Play()
            Notify("🔫 Gun Dropped!", "Sheriff died!", nil, 5)
            if AutoGrabGun then
                task.defer(function()
                    local drop = model:FindFirstChild("GunDrop")
                    local root = SafeGetHRP(SafeGetCharacter(LocalPlayer))
                    if drop and root then
                        local part = drop:IsA("BasePart") and drop or drop:FindFirstChildWhichIsA("BasePart", true)
                        if part then touchGrab(part, root) end
                    end
                end)
            end
        end
