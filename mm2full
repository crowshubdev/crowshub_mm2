do -- ═══ [CWH SCOPE] G15: CAMERA NOCLIP (следящая камера сквозь стены) ═══
-- ═══════════════════════════════════════════════════════════════
-- [v1.17] НЕ свободная камера: обычное слежение за своим персонажем, но у
-- стены камера НЕ прижимается к персонажу — проходит насквозь, а стена между
-- камерой и тобой становится прозрачной. ПКМ — поворот, колесо — зум,
-- персонаж ходит как обычно (WASD относительно камеры).
local FC = { On = false, yaw = 0, pitch = 0, zoom = 14, conn = nil,
             wheelConn = nil, dragConn = nil, faded = {} }

local function fcUnfade()
    for obj, lm in pairs(FC.faded) do
        pcall(function() obj.LocalTransparencyModifier = lm end)
    end
    FC.faded = {}
end

local function fcStop()
    if FC.conn then pcall(function() FC.conn:Disconnect() end) FC.conn = nil end
    if FC.wheelConn then pcall(function() FC.wheelConn:Disconnect() end) FC.wheelConn = nil end
    if FC.dragConn then pcall(function() FC.dragConn:Disconnect() end) FC.dragConn = nil end
    fcUnfade()
    local cam = workspace.CurrentCamera
    if cam then
        cam.CameraType = Enum.CameraType.Custom
        local hum = getHum(getChar(LocalPlayer))
        if hum then cam.CameraSubject = hum end
    end
    FC.On = false
end

local function fcStart()
    local cam = workspace.CurrentCamera
    if not cam then return end
    local hrp = getHRP(getChar(LocalPlayer))
    local lv = cam.CFrame.LookVector
    FC.yaw = math.atan2(-lv.X, -lv.Z)
    FC.pitch = math.clamp(math.asin(math.clamp(lv.Y, -1, 1)), -1.2, 1.2)
    if hrp then
        FC.zoom = math.clamp((cam.CFrame.Position - hrp.Position).Magnitude, 6, 40)
    end
    cam.CameraType = Enum.CameraType.Scriptable
    FC.conn = RunService.RenderStepped:Connect(function()
        local cam2 = workspace.CurrentCamera
        if not cam2 then return end
        local char = getChar(LocalPlayer)
        local root = getHRP(char)
        if not root then return end
        local focus = root.Position + Vector3.new(0, 1.8, 0)
        local cf = CFrame.new(focus) * CFrame.fromEulerAnglesYXZ(FC.pitch, FC.yaw, 0)
        local camPos = focus - cf.LookVector * FC.zoom
        cam2.CFrame = CFrame.new(camPos, focus)
        -- стена между камерой и персонажем → прозрачная (видим себя сквозь стену)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { char }
        local result = workspace:Raycast(focus, camPos - focus, params)
        local hit = result and result.Instance
        for obj, lm in pairs(FC.faded) do
            if not (hit and (obj == hit or obj:IsDescendantOf(hit))) then
                pcall(function() obj.LocalTransparencyModifier = lm end)
                FC.faded[obj] = nil
            end
        end
        if hit and hit:IsA("BasePart") and not FC.faded[hit] then
            FC.faded[hit] = hit.LocalTransparencyModifier
            pcall(function() hit.LocalTransparencyModifier = 0.85 end)
        end
    end)
    FC.dragConn = UserInputService.InputChanged:Connect(function(input)
        local it = input.UserInputType
        local anyBtn = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
            or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
        if it == Enum.UserInputType.MouseMovement and anyBtn then
            FC.yaw = FC.yaw - input.Delta.X * 0.005
            FC.pitch = math.clamp(FC.pitch - input.Delta.Y * 0.005, -1.2, 1.2)
        elseif it == Enum.UserInputType.Touch then
            -- [v1.20] телефон: палец на ПРАВОЙ половине экрана крутит камеру
            -- (левая половина — джойстик ходьбы, его не трогаем)
            local cam = workspace.CurrentCamera
            local vw = cam and cam.ViewportSize.X or 400
            if input.Position.X > vw * 0.45 then
                FC.yaw = FC.yaw - input.Delta.X * 0.006
                FC.pitch = math.clamp(FC.pitch - input.Delta.Y * 0.006, -1.2, 1.2)
            end
        end
    end)
    FC.wheelConn = UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseWheel then
            FC.zoom = math.clamp(FC.zoom - input.Delta.Z, 5, 60)
        end
    end)
    FC.On = true
end

Tabs.Farm:AddSection("📹 Камера ноклип (следящая)")
Tabs.Farm:AddToggle("CWHCamNoclip", {
    Title = "📹 Camera Noclip (сквозь стены)",
    Description = "[v1.21] Слежение сквозь стены: зажми ЛКМ или ПКМ и веди мышью — камера крутится (ПК); палец на ПРАВОЙ половине экрана — поворот (телефон); колесо — зум. Стена между тобой и камерой становится прозрачной",
    Default = false
}):OnChanged(function(v)
    if v then fcStart() else fcStop() end
end)
print("[CWH] INIT G15 OK (Camera Noclip следящая)")
end -- [CWH SCOPE] G15


do -- ═══ [CWH SCOPE] G16: SNOW (снег в Visual 2) ═══
-- ═══════════════════════════════════════════════════════════════
-- [v1.17] Снег: эмиттер летит над персонажем. Скорость — от «очень медленного»
-- до «урагана». Падение — прямо сверху вниз или под наклоном (влево/вправо
-- относительно того, куда смотришь).
local SN = { On = false, Part = nil, Emit = nil, Conn = nil,
             Speed = "Средний", Wind = "Прямо",
             Size = 0.6, Bright = 3, Color = "Белый", Glow = true, Radius = 50 }
local SN_COLORS = {
    ["Белый"] = Color3.fromRGB(255, 255, 255),
    ["Голубой"] = Color3.fromRGB(150, 220, 255),
    ["Синий"] = Color3.fromRGB(90, 160, 255),
    ["Розовый"] = Color3.fromRGB(255, 170, 220),
    ["Золотой"] = Color3.fromRGB(255, 220, 120),
    ["Красный"] = Color3.fromRGB(255, 90, 90),
    ["Зелёный"] = Color3.fromRGB(120, 255, 150),
}
local SN_SPEED = {
    ["Очень медленный"] = { rate = 50,  speed = 2.5, life = 12 },
    ["Средний"]         = { rate = 130, speed = 6,   life = 8 },
    ["Быстрый"]         = { rate = 260, speed = 12,  life = 6 },
    ["Очень быстрый"]   = { rate = 450, speed = 22,  life = 4 },
    ["Ураган"]          = { rate = 750, speed = 45,  life = 3 },
}
local SN_WIND = {
    ["Прямо"]          = 0,
    ["Наклон влево"]   = -7,
    ["Наклон вправо"]  = 7,
}
local function snApply()
    if not SN.Emit then return end
    local sp = SN_SPEED[SN.Speed] or SN_SPEED["Средний"]
    SN.Emit.Rate = sp.rate
    SN.Emit.Speed = NumberRange.new(sp.speed * 0.7, sp.speed)
    SN.Emit.Lifetime = NumberRange.new(sp.life * 0.6, sp.life)
    -- [v1.20] размер снежинок
    SN.Emit.Size = NumberSequence.new(SN.Size or 0.6)
    -- яркость: 1 = почти прозрачные … 5 = полностью яркие
    local b = math.clamp(SN.Bright or 3, 1, 5)
    local startT = 0.85 - (b - 1) * 0.21
    SN.Emit.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, startT),
        NumberSequenceKeypoint.new(0.8, math.min(startT + 0.15, 1)),
        NumberSequenceKeypoint.new(1, 1),
    })
    -- свет: светящиеся или матовые
    SN.Emit.LightEmission = (SN.Glow == true) and 1 or 0.3
    SN.Emit.LightInfluence = 0
    -- цвет (Радуга крутится в heartbeat)
    if SN.Color ~= "Радуга" then
        local c = SN_COLORS[SN.Color] or SN_COLORS["Белый"]
        SN.Emit.Color = ColorSequence.new(c)
    end
    -- радиус зоны снега вокруг нас
    local r = math.clamp(SN.Radius or 50, 5, 80)
    if SN.Part then
        SN.Part.Size = Vector3.new(r * 1.6, 2, r * 1.6)
    end
end
local function snStop()
    if SN.Conn then pcall(function() SN.Conn:Disconnect() end) SN.Conn = nil end
    if SN.Part then pcall(function() SN.Part:Destroy() end) end
    SN.Part, SN.Emit = nil, nil
    SN.On = false
end
local function snStart()
    snStop()
    local part = Instance.new("Part")
    part.Name = "CWH_SnowZone"
    part.Size = Vector3.new(50, 2, 50)
    part.Transparency = 1
    part.Anchored = true
    part.CanCollide = false
    part.CanQuery = false
    part.CastShadow = false
    local emit = Instance.new("ParticleEmitter")
    emit.Name = "CWH_Snow"
    emit.Texture = "rbxasset://textures/particles/smoke_main.dds"
    emit.Color = ColorSequence.new(Color3.new(1, 1, 1))
    emit.Size = NumberSequence.new(0.6)
    emit.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.35),
        NumberSequenceKeypoint.new(0.8, 0.5),
        NumberSequenceKeypoint.new(1, 1),
    })
    emit.EmissionDirection = Enum.NormalId.Bottom
    emit.SpreadAngle = Vector2.new(6, 6)
    emit.Rotation = NumberRange.new(0, 360)
    emit.RotSpeed = NumberRange.new(-80, 80)
    emit.LightEmission = 0.75
    emit.LightInfluence = 0
    emit.Shape = Enum.ParticleEmitterShape.Box
    emit.Parent = part
    part.Parent = workspace
    SN.Part, SN.Emit = part, emit
    snApply()
    SN.Conn = RunService.Heartbeat:Connect(function()
        local root = getHRP(getChar(LocalPlayer))
        if not (root and SN.Part and SN.Emit) then return end
        SN.Part.CFrame = CFrame.new(root.Position + Vector3.new(0, 22, 0))
        -- наклон падения относительно того, куда смотрим
        local wind = SN_WIND[SN.Wind] or 0
        local lv = workspace.CurrentCamera and workspace.CurrentCamera.CFrame.LookVector
            or Vector3.new(0, 0, -1)
        local flat = Vector3.new(lv.X, 0, lv.Z)
        local right = Vector3.new(1, 0, 0)
        if flat.Magnitude > 0.1 then right = Vector3.new(-flat.Z, 0, flat.X).Unit end
        SN.Emit.Acceleration = right * wind + Vector3.new(0, -9, 0)
        if SN.Color == "Радуга" then
            SN.Emit.Color = ColorSequence.new(Color3.fromHSV((tick() % 8) / 8, 0.7, 1))
        end
    end)
    SN.On = true
end

