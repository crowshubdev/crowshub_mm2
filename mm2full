do -- ═══ [CWH SCOPE] G18: TOUCH FLING v3 (SkidFling из Overdrive) ═══
-- ═══════════════════════════════════════════════════════════════
-- [v1.21] SkidFling — точный порт из Overdrive: телепорты вращением вокруг
-- части жертвы (голова, если оторвана) со скоростью 9e8, BodyVelocity 9e8,
-- FallenPartsDestroyHeight = NaN. Возврат — циклом Overdrive: каждый кадр
-- позиция + обнуление скорости всех частей, пока не вернёмся (±25 студов).
-- Триггер — касание, кейбинд Fl, тоггл в Other.
local FL = { On = false, Conn = nil, Last = 0, Busy = false, OldPos = nil }
local function flOne(victimPlayer)
    if FL.Busy then return end
    local char = getChar(LocalPlayer)
    local hum = getHum(char)
    local hrp = getHRP(char)
    if not (char and hum and hrp and hum.Health > 0) then return end
    local c2 = getChar(victimPlayer)
    local hum2 = c2 and getHum(c2)
    local hrp2 = c2 and getHRP(c2)
    if not (c2 and hum2 and hrp2) then return end
    if hum2.Sit then return end
    if not c2:FindFirstChildWhichIsA("BasePart") then return end
    FL.Busy = true
    task.spawn(function()
        pcall(function()
            -- выбор части жертвы как в Overdrive: голова, если оторвана от корня
            local cam = workspace.CurrentCamera
            local oldSubject = cam.CameraSubject
            local tHum2 = hum2
            local tHead = c2:FindFirstChild("Head")
            local tAcc = c2:FindFirstChildOfClass("Accessory")
            local tHandle = tAcc and tAcc:FindFirstChild("Handle") or nil
            local target = hrp2
            if hrp2 and tHead and (hrp2.Position - tHead.Position).Magnitude > 5 then
                target = tHead
            elseif not hrp2 and tHead then
                target = tHead
            elseif not hrp2 and not tHead and tHandle then
                target = tHandle
            end
            if not target then return end
            if hrp.AssemblyLinearVelocity.Magnitude < 50 then FL.OldPos = hrp.CFrame end
            pcall(function() cam.CameraSubject = tHead or tHandle or hum2 end)
            pcall(function() workspace.FallenPartsDestroyHeight = 0 / 0 end)

            -- FPos/SFBasePart — точный порт SkidFling из Overdrive
            local function FPos(base, off, ang)
                hrp.CFrame = CFrame.new(base.Position) * off * ang
                pcall(function() char:SetPrimaryPartCFrame(CFrame.new(base.Position) * off * ang) end)
                hrp.Velocity = Vector3.new(9e7, 9e8, 9e7)
                hrp.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
            end
            local function SFBasePart(base)
                local t0 = tick()
                local angle = 0
                repeat
                    if hrp and hrp.Parent and tHum2 then
                        if base.Velocity.Magnitude < 50 then
                            angle += 100
                            FPos(base, CFrame.new(0, 1.5, 0) + tHum2.MoveDirection * base.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(angle), 0, 0))
                            task.wait()
                            FPos(base, CFrame.new(0, -1.5, 0) + tHum2.MoveDirection * base.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(angle), 0, 0))
                            task.wait()
                            FPos(base, CFrame.new(2.25, 1.5, -2.25) + tHum2.MoveDirection * base.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(angle), 0, 0))
                            task.wait()
                            FPos(base, CFrame.new(-2.25, -1.5, 2.25) + tHum2.MoveDirection * base.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(angle), 0, 0))
                            task.wait()
                            FPos(base, CFrame.new(0, 1.5, 0) + tHum2.MoveDirection, CFrame.Angles(math.rad(angle), 0, 0))
                            task.wait()
                            FPos(base, CFrame.new(0, -1.5, 0) + tHum2.MoveDirection, CFrame.Angles(math.rad(angle), 0, 0))
                            task.wait()
                        else
                            FPos(base, CFrame.new(0, 1.5, tHum2.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0))
                            task.wait()
                            FPos(base, CFrame.new(0, -1.5, -tHum2.WalkSpeed), CFrame.Angles(0, 0, 0))
                            task.wait()
                            FPos(base, CFrame.new(0, 1.5, tHum2.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0))
                            task.wait()
                            FPos(base, CFrame.new(0, 1.5, hrp2 and hrp2.Velocity.Magnitude / 1.25 or 0), CFrame.Angles(math.rad(90), 0, 0))
                            task.wait()
                            FPos(base, CFrame.new(0, -1.5, -(hrp2 and hrp2.Velocity.Magnitude / 1.25 or 0)), CFrame.Angles(0, 0, 0))
                            task.wait()
                            FPos(base, CFrame.new(0, 1.5, hrp2 and hrp2.Velocity.Magnitude / 1.25 or 0), CFrame.Angles(math.rad(90), 0, 0))
                            task.wait()
                            FPos(base, CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(90), 0, 0))
                            task.wait()
                            FPos(base, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
                            task.wait()
                            FPos(base, CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(-90), 0, 0))
                            task.wait()
                            FPos(base, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
                            task.wait()
                        end
                    else
                        break
                    end
                until base.Velocity.Magnitude > 500 or base.Parent ~= c2 or c2.Parent ~= Players
                    or (tHum2 and tHum2.Sit) or (hum and hum.Health <= 0) or tick() > t0 + 2
            end
            local bv = Instance.new("BodyVelocity")
            bv.Name = "CWH_FlingVel"
            bv.Velocity = Vector3.new(9e8, 9e8, 9e8)
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Parent = hrp
            pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false) end)
            SFBasePart(target)
            if bv and bv.Parent then pcall(function() bv:Destroy() end) end
            pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true) end)
            pcall(function() cam.CameraSubject = oldSubject or hum end)
            -- ВОССТАНОВЛЕНИЕ как в Overdrive: каждый кадр возвращаем позицию и
            -- обнуляем скорость ВСЕХ частей, пока не вернёмся на место (±25 студов).
            -- Именно этот цикл — фикс «меня отбрасывает после флинга»
            if FL.OldPos and hum.Health > 0 then
                local recT = tick()
                repeat
                    pcall(function()
                        hrp.CFrame = FL.OldPos * CFrame.new(0, 0.5, 0)
                        pcall(function() char:SetPrimaryPartCFrame(FL.OldPos * CFrame.new(0, 0.5, 0)) end)
                    end)
                    pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
                    for _, x in ipairs(char:GetChildren()) do
                        if x:IsA("BasePart") then
                            pcall(function()
                                x.Velocity, x.RotVelocity = Vector3.new(), Vector3.new()
                            end)
                        end
                    end
                    task.wait()
                until not hrp.Parent or not FL.OldPos
                    or (hrp.Position - FL.OldPos.Position).Magnitude < 25
                    or tick() > recT + 3
            end
        end)
        FL.Busy = false
    end)
end
local function flStop()
    if FL.Conn then pcall(function() FL.Conn:Disconnect() end) FL.Conn = nil end
end
local function flStart()
    flStop()
    local char = getChar(LocalPlayer)
    local hrp = getHRP(char)
    if not hrp then return false end
    FL.Conn = hrp.Touched:Connect(function(hit)
        if not FL.On or FL.Busy then return end
        if os.clock() - FL.Last < 1.5 then return end
        local other = hit and hit:FindFirstAncestorOfClass("Model")
        if not other or other == char then return end
        local pl = Players:GetPlayerFromCharacter(other)
        if not pl then return end
        FL.Last = os.clock()
        Notify("Touch Fling", "Флинг: " .. pl.Name, nil, 2)
        flOne(pl)
    end)
    return true
end
getgenv().CWH_ToggleFl = function()
    FL.On = not FL.On
    if FL.On then
        local okk = flStart()
        Notify("Touch Fling", okk and "ВКЛ (v3, SkidFling из Overdrive) — кто коснётся, улетит в небо" or "Персонажа нет — включится при спавне", nil, 3)
    else
        flStop()
        Notify("Touch Fling", "ВЫКЛ", nil, 2)
    end
end
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    if FL.On then flStart() end
end)
Tabs.Other:AddSection("💥 Touch Fling")
Tabs.Other:AddToggle("CWHFling", {
    Title = "💥 Touch Fling (v3 — SkidFling из Overdrive)",
    Description = "[v1.21] SkidFling из Overdrive: 2 секунды врубаешься в жертву с вращением на скорости 9e8 — она улетает в небо. Возврат — циклом с обнулением скорости всех частей, как в Overdrive: тебя больше не отбрасывает. Кейбинд — Fl",
    Default = false
}):OnChanged(function(v)
    if v ~= FL.On then pcall(getgenv().CWH_ToggleFl) end
end)
print("[CWH] INIT G18 OK (Touch Fling v2)")
end -- [CWH SCOPE] G18

do -- ═══ [CWH SCOPE] G19: THROW KNIFE AURA (аура летящего ножа) ═══
-- ═══════════════════════════════════════════════════════════════
-- [v1.18] Как в Overdrive: у ЛЕТЯЩЕГО ножа огромная зона касания (синяя
-- аура с твоего скрина) — пока нож летит, все игроки в радиусе от него
-- «касаются» ножа, и убой засчитывается, даже если бросил мимо.
local TA = { On = false, Radius = 16, Glow = true, Last = 0 }
task.spawn(function()
    while task.wait(0.05) do
        if not getgenv().CWH_RUN then break end
        pcall(function()
            if not TA.On then return end
            if getRole(LocalPlayer) ~= "Murderer" then return end
            local myChar = getChar(LocalPlayer)
            if not myChar then return end
            -- летящий нож ищем в workspace и в Debris
            local lists = { workspace:GetChildren() }
            local deb = workspace:FindFirstChild("Debris")
            if deb then lists[#lists + 1] = deb:GetChildren() end
            for _, list in ipairs(lists) do
                for _, obj in ipairs(list) do
                    local lname = obj.Name:lower()
                    if lname:find("knife") or lname:find("throw") then
                        local handle = obj:IsA("Tool") and obj:FindFirstChild("Handle")
                            or (obj:IsA("BasePart") and obj) or obj:FindFirstChild("Handle")
                        if handle and handle:IsA("BasePart") and not obj:IsDescendantOf(myChar) then
                            local vel = handle.AssemblyLinearVelocity
                            if vel.Magnitude > 4 then
                                -- синее свечение ауры (как на скрине)
                                if TA.Glow and not obj:FindFirstChild("CWH_TAura") then
                                    pcall(function()
                                        local hl = Instance.new("Highlight")
                                        hl.Name = "CWH_TAura"
                                        hl.FillColor = Color3.fromRGB(60, 120, 255)
                                        hl.OutlineColor = Color3.fromRGB(150, 200, 255)
                                        hl.FillTransparency = 0.5
                                        hl.Parent = obj
                                    end)
                                end
                                -- касания: все игроки в радиусе от летящего ножа
                                if os.clock() - TA.Last >= 0.12 then
                                    for _, p in ipairs(Players:GetPlayers()) do
                                        if p ~= LocalPlayer then
                                            local c2 = getChar(p)
                                            local eHRP = c2 and getHRP(c2)
                                            local h2 = c2 and getHum(c2)
                                            if eHRP and h2 and h2.Health > 0
                                                and (eHRP.Position - handle.Position).Magnitude <= TA.Radius then
                                                if realFireTouch then
                                                    realFireTouch(handle, eHRP, 1)
                                                    realFireTouch(handle, eHRP, 0)
                                                end
                                            end
                                        end
                                    end
                                    TA.Last = os.clock()
                                end
                            else
                                local hl = obj:FindFirstChild("CWH_TAura")
                                if hl then pcall(function() hl:Destroy() end) end
                            end
                        end
                    end
                end
            end
        end)
    end
end)
