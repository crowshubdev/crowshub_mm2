getgenv().CWH_InvisConn = RunService.Heartbeat:Connect(function()
    if not invisOn or not getgenv().CWH_RUN then return end
    local ch = getChar(LocalPlayer)
    local hum = getHum(ch)
    local root = getHRP(ch)
    if not (hum and root and root.Parent) or hum.Health <= 0 then return end
    pcall(function()
        -- ферма двигает персонажа сама — не воюем с ней
        local farmRef = getgenv().CWH_FarmRef
        if farmRef and farmRef.Enabled then return end
        -- рейкаст "стоишь ли на земле" (для чередования глубины, как в Pulse)
        if not invRC then
            invRC = RaycastParams.new()
            invRC.FilterType = Enum.RaycastFilterType.Exclude
        end
        if invRCChar ~= ch then
            invRCChar = ch
            invRC.FilterDescendantsInstances = { ch }
        end
        local grounded = workspace:Raycast(root.Position, Vector3.new(0, -5, 0), invRC) ~= nil
        local moving = hum.MoveDirection.Magnitude > 0.01
        local cf = root.CFrame
        local targetY = invVoidY
        if grounded and not moving then
            invFlip = not invFlip
            if invFlip then targetY = invVoidY + 0.5 end
        end
        invRealCF = cf
        invRealHRP = root
        root.CFrame = cf * CFrame.new(0, targetY - cf.Y, 0)
        invDownPos = root.Position
        invNeedsRestore = true
    end)
end)

pcall(function() RunService:UnbindFromRenderStep("CWH_InvisRestore") end)
pcall(function() RunService:UnbindFromRenderStep("CWH_InvisGhost") end)
RunService:BindToRenderStep("CWH_InvisRestore", Enum.RenderPriority.Camera.Value - 1, function()
    if not invisOn or not getgenv().CWH_RUN or not invNeedsRestore then return end
    local root = getHRP(getChar(LocalPlayer))
    if root and root.Parent then
        if not invDownPos or (root.Position - invDownPos).Magnitude < 2 then
            pcall(function() root.CFrame = invRealCF end)
        end
    end
    invNeedsRestore = false
end)
RunService:BindToRenderStep("CWH_InvisGhost", Enum.RenderPriority.Camera.Value + 1, function()
    if not invisOn or not getgenv().CWH_RUN then return end
    local fp, camPos = invFirstPerson()
    pcall(function()
        for _, u in ipairs(invParts) do
            local p = u.p
            if p and p.Parent then
                local alpha = 0.5
                if fp then
                    if u.near then
                        alpha = 1
                    else
                        local d = camPos and (p.Position - camPos).Magnitude or 99
                        if d < 1.2 then
                            alpha = 1
                        elseif d < 2.4 then
                            alpha = math.max(0.5, 1 - (d - 1.2) / 1.2)
                        end
                    end
                end
                p.LocalTransparencyModifier = alpha
            end
        end
    end)
end)

