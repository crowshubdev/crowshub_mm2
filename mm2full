local animApply = {}
local function restartAnimate(char)
    local animate = char and char:FindFirstChild("Animate")
    if animate then
        pcall(function()
            animate.Disabled = true
            task.wait(0.05)
            animate.Disabled = false
        end)
    end
end

local function applyAnimateId(kind, id)
    local char = getChar(LocalPlayer)
    local animate = char and char:FindFirstChild("Animate")
    local folder = animate and animate:FindFirstChild(kind)
    local a = folder and folder:FindFirstChildOfClass("Animation")
    if not a then return false end
    if not animApply[a] then
        animApply[a] = a.AnimationId
    end
    a.AnimationId = "rbxassetid://" .. id
    restartAnimate(char)
    return true
end

