            end
        end
        Lighting.Brightness = originalBrightness
        Lighting.GlobalShadows = true
        Camera.FieldOfView = DefaultFOV
        pcall(function() Window:Destroy() end)
        SoundGui:Destroy()
        ScreenGui:Destroy()
    end
})

