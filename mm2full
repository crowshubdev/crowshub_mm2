local CleanupSystem = {
    AutoCleanup = false,
    Interval = 60
}

local function runCleanup()
    local cleaned = 0
    -- мёртвые персонажи: снимаем наши ESP-объекты
    for _, plr in ipairs(Players:GetPlayers()) do
        local char = SafeGetCharacter(plr)
        if char then
            local hum = SafeGetHumanoid(char)
            if hum and hum.Health <= 0 then
                removeESPFromChar(char)
                cleaned = cleaned + 1
            end
        end
    end
    -- осиротевшие подсветки GunDrop
    local map = getMap()
    local drop = map and map:FindFirstChild("GunDrop", true)
    if not drop or not drop:IsA("BasePart") then
        for _, d in ipairs(workspace:GetDescendants()) do
            if d.Name == "CrowsGunHL" then
                d:Destroy()
                cleaned = cleaned + 1
            end
        end
    end
    -- сброс кэшей
    roleCache = {}
    roleCacheTime = 0
    NotifiedRoles = {}
    -- мусор GC
    pcall(collectgarbage, "collect")
    return cleaned
end

