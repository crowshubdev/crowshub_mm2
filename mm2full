            -- ожидание кадра ~ (1000/fps), лишнее = сетевой джиттер
            local expected = 1000 / math.max(fpsLast, 10)
            local extra = frame - expected
            if extra > 0 then
                measured = math.clamp(extra, 0, 2000)
            else
                measured = 0
            end
        end

        pingSmooth = pingSmooth * 0.7 + (measured or pingSmooth) * 0.3

        if pingLabel.Parent then
            pingLabel.Text = string.format("📶 %d ms", math.floor(pingSmooth))
