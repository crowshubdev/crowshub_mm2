-- ─── SILENT AIM (KNIFE) — из mm2full: трекеры + предикт ───────
local KnifeSystem = {
    Silent = false,
    Predict = true,
    Range = 400,
    LeadScale = 1,
    ThrowSpeed = 96,
    Trackers = {},
}

local TRACKER_CAP = 20
local TRACKER_WINDOW = 0.13

local function new_tracker()
    return {
        t = table.create(TRACKER_CAP, 0),
        p = table.create(TRACKER_CAP, Vector3.zero),
        n = 0, i = 0,
        part = nil, pos = nil, time = 0,
        vel = Vector3.zero, ready = false,
    }
end

local function snap_push(tr, now, pos)
    tr.i = tr.i % TRACKER_CAP + 1
    tr.t[tr.i] = now
    tr.p[tr.i] = pos
    if tr.n < TRACKER_CAP then tr.n = tr.n + 1 end
end

local function snap_get(tr, k)
    local idx = (tr.i - k - 1) % TRACKER_CAP + 1
    return tr.t[idx], tr.p[idx]
end

local function fit_velocity(tr)
    if tr.n < 3 then return nil end
    local newest = snap_get(tr, 0)
    local used, sum_d = 0, 0
    for k = 0, tr.n - 1 do
        local t = snap_get(tr, k)
        if newest - t > TRACKER_WINDOW then break end
        used = used + 1
        sum_d = sum_d + (t - newest)
    end
    if used < 3 then return nil end
    local mean_d = sum_d / used
    local num, den = Vector3.zero, 0
    for k = 0, used - 1 do
        local t, p = snap_get(tr, k)
        local d = (t - newest) - mean_d
        num = num + p * d
        den = den + d * d
    end
    if den < 1e-8 then return nil end
    return num / den
end

local function update_tracker(tr, part, now)
    local pos = part.Position
    if part ~= tr.part or not tr.pos then
        tr.part, tr.pos, tr.time = part, pos, now
        tr.vel = Vector3.zero
        tr.n, tr.i = 0, 0
        snap_push(tr, now, pos)
        return
    end
    local dt = now - tr.time
    if dt > 0.75 or (pos - tr.pos).Magnitude > 140 then
        tr.part, tr.pos, tr.time = part, pos, now
        tr.n, tr.i = 0, 0
        snap_push(tr, now, pos)
        return
    end
    if (pos - tr.pos).Magnitude < 0.004 or dt <= 0 then return end
    snap_push(tr, now, pos)
    tr.pos, tr.time = pos, now
    local fit = fit_velocity(tr)
    if fit then
        tr.vel = tr.ready and tr.vel:Lerp(fit, 0.45) or fit
        tr.ready = true
    end
end

local function get_tracker(plr)
    if not KnifeSystem.Trackers[plr] then
        KnifeSystem.Trackers[plr] = new_tracker()
    end
    return KnifeSystem.Trackers[plr]
end

local function pick_target()
    local root = SafeGetHRP(SafeGetCharacter(LocalPlayer))
    if not root then return nil, nil, nil end
    local origin = root.Position
    local best_char, best_part, best_tr = nil, nil, nil
    local best_dist = KnifeSystem.Range
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = SafeGetCharacter(plr)
        if not char then continue end
        local hum = SafeGetHumanoid(char)
        if not hum or hum.Health <= 0 then continue end
        local part = char:FindFirstChild("HumanoidRootPart")
            or char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("Torso")
        if part then
            local dist = (part.Position - origin).Magnitude
            if dist <= best_dist then
                best_dist = dist
                best_char = char
                best_part = part
                best_tr = get_tracker(plr)
            end
        end
    end
    return best_char, best_part, best_tr
end

local function lead_offset(tr, t)
    if not KnifeSystem.Predict or not tr or not tr.ready or t <= 0 then
        return Vector3.zero
    end
    local vel = tr.vel
    local off_y = 0
    if math.abs(vel.Y) > 3 then
        local tv = t * 0.35
        off_y = math.clamp(vel.Y * tv - 0.5 * workspace.Gravity * tv * tv, -1.8, 1.8)
    end
    return Vector3.new(vel.X * t * KnifeSystem.LeadScale, off_y, vel.Z * t * KnifeSystem.LeadScale)
end

local function throw_aim(tr, part, origin)
    local base = part.Position
    local travel = 0
    local point = base
    for _ = 1, 3 do
        local ping = LocalPlayer:GetNetworkPing() or 0
        if ping > 1 then ping = ping / 1000 end
        local t = math.clamp(ping + travel, 0, 1)
        point = base + lead_offset(tr, t)
        if not origin or KnifeSystem.ThrowSpeed <= 1 then break end
        travel = math.clamp((point - origin).Magnitude / KnifeSystem.ThrowSpeed, 0, 0.7)
    end
    return point
end

-- Silent Aim resolver — используется хуком
getgenv().KNIFE_AIM_RESOLVE = function()
    if not KnifeSystem.Silent then return nil end
    local char = SafeGetCharacter(LocalPlayer)
    if not char or not char:FindFirstChild("Knife") then return nil end
    local target_char, part, tr = pick_target()
    if not part then return nil end
    local root = SafeGetHRP(char)
    local origin = root and root.Position or nil
    return CFrame.new(throw_aim(tr, part, origin))
end

-- Хук: перехват FireServer ремоутов внутри Knife — подмена CFrame броска
if realHookNamecall then
    local oldNamecall
    oldNamecall = realHookNamecall(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" and KnifeSystem.Silent then
