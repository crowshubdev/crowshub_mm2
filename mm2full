    pcall(function()
        local snd = Instance.new("Sound")
        snd.SoundId = id
        snd.Volume = (tonumber(volPct) or 60) / 100 * 3
        snd.Parent = game:GetService("SoundService")
        snd:Play()
        game:GetService("Debris"):AddItem(snd, 8)
    end)
end

local function ksPlay(id, force)
