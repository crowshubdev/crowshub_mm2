-- точка прицела v4 (перехват из shitaro-new + центр массы из нового Pulse)
local function sa3AimPos(targetPlayer)
    local t = targetPlayer or pickSA()
    local c = t and t.Character
    if not c then return nil end
    local hum = getHum(c)
    if not (hum and hum.Health > 0) then return nil end
    local my = getHRP(getChar(LocalPlayer))
    if not my then return nil end
    -- [v1.22] v4: ТОЛЬКО крупные части. В v3 рандом-пул из 11 частей содержал
    -- 8 конечностей — отсюда «мисает / еле попадает / чаще в руку».
    -- Конечности (кисти, стопы, нижние руки/ноги) больше не рассматриваются
    local head = c:FindFirstChild("Head")
    local torso = c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso")
    local lower = c:FindFirstChild("LowerTorso")
    local root = c:FindFirstChild("HumanoidRootPart")
    local base = torso or root
    if not base then return nil end
    if (base.Position - my.Position).Magnitude > SA3.Range then return nil end
    -- [v1.22] перехват-цикл (shitaro-new resolve): пуля летит в точку, где
    -- цель БУДЕТ в момент прилёта: t = дист/скорость пули → предикт → пересчёт t
    local function predictAt(p0)
        local pos = p0
        local spd = math.max(50, SA3.BulletSpeed or 300)
        local dt = (p0 - my.Position).Magnitude / spd
        for _ = 1, 3 do
            if SA3.Predict then
                local v = root and root.AssemblyLinearVelocity or Vector3.zero
                if SA3.Smart and Vector3.new(v.X, 0, v.Z).Magnitude < 2 then
                    pos = p0 -- стоит на месте — точно в выбранную зону
                elseif SA3.V4 then
                    -- [v1.13] смесь V4-истории и мгновенной скорости —
                    -- резкая смена направления отрабатывает быстрее
                    pos = pred4Pos(t, p0, dt):Lerp(p0 + v * dt, 0.35)
                else
                    pos = p0 + v * dt
                end
                -- анти-джамперы: цель в воздухе — предикт с гравитацией
                if SA3.Ballistic and math.abs(v.Y) > 4 then
                    local g = workspace.Gravity
                    pos = Vector3.new(pos.X + v.X * dt, pos.Y + v.Y * dt - 0.5 * g * dt * dt, pos.Z + v.Z * dt)
                end
            end
            local nd = (pos - my.Position).Magnitude / spd
            if math.abs(nd - dt) < 0.01 then break end
            dt = nd
        end
        return pos
    end
    -- [v1.22] взвешенный рандом зоны: торс 45% / голова 20% / низ торса 15% /
    -- верх ног 12% / верх рук 8% — непредсказуемо, но только крупные хитбоксы
    local weighted = {
        { torso, 45 },
        { head, 20 },
        { lower or root, 15 },
        { c:FindFirstChild("LeftUpperLeg") or c:FindFirstChild("Left Leg"), 6 },
        { c:FindFirstChild("RightUpperLeg") or c:FindFirstChild("Right Leg"), 6 },
        { c:FindFirstChild("LeftUpperArm") or c:FindFirstChild("Left Arm"), 4 },
        { c:FindFirstChild("RightUpperArm") or c:FindFirstChild("Right Arm"), 4 },
    }
    local function weightedPick()
        local pool, total = {}, 0
        for _, w in ipairs(weighted) do
            if w[1] and w[1].Parent then pool[#pool + 1] = w total = total + w[2] end
        end
        if total <= 0 then return base.Position end
        local roll = math.random() * total
        for _, w in ipairs(pool) do
            roll = roll - w[2]
            if roll <= 0 then return w[1].Position end
        end
        return base.Position
    end
    -- выбор зоны: Случайная зона > центр хитбокса > Aim Part
    local desired
    if SA3.BodyMode == "Случайная зона (взвешенно)" then
        desired = weightedPick()
    elseif SA3.Center then
        pcall(function()
            local cf = c:GetBoundingBox()
            if cf then desired = cf.Position end
        end)
    end
    if not desired then
        local ap = (SA3.AimPart == "Head" and head) or base
        desired = ap and ap.Position or base.Position
    end
    -- [v1.22] перебор кандидатов с проверкой видимости (shitaro-new):
    -- пуля летит ОТ НАС (origin «От меня»/«Смесь») — стена на линии = промах.
    -- Спускаемся по кандидатам голова→торс→низ торса, берём первый видимый
    if SA3.OriginMode ~= "Возле жертвы (магия)" then
        local cands = { desired, base.Position }
        if head then cands[#cands + 1] = head.Position end
        if lower then cands[#cands + 1] = lower.Position end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { getChar(LocalPlayer), c }
        for _, cpos in ipairs(cands) do
            local hit = workspace:Raycast(my.Position, cpos - my.Position, params)
            if not hit then desired = cpos break end
        end
    end
    local pos = predictAt(desired)
    return pos
end

-- [v1.23] Magic-подлёт v4: ТОЛЬКО над головой / со спины / в лицо (по запросу:
-- «оставить только над головой и со спины или в лицо, типо в торс»).
-- Прицел всегда в выбранную часть (по умолчанию торс) — миссов нет
local function sa3MagicOrigin(pos, tgt, myHRP)
    local roll
    if SA3.MagicStyle == "Над головой" then
        roll = 1
    elseif SA3.MagicStyle == "Со спины или в лицо" then
        roll = math.random(2, 3)
    else
        roll = math.random(1, 3) -- Смесь: любое из трёх
    end
    if roll == 1 then
        return Vector3.new(pos.X, pos.Y + 6, pos.Z) -- над головой, сверху вниз
    end
    local toMe = myHRP and (myHRP.Position - pos) or Vector3.new(0, 0, 1)
    local toMeU = toMe.Magnitude > 0.1 and toMe.Unit or Vector3.new(0, 0, 1)
    if roll == 2 then
        return pos - toMeU * 12 + Vector3.new(0, 1.5, 0) -- со спины
    end
    local head = tgt and tgt.Character and tgt.Character:FindFirstChild("Head")
    local face = head and head.CFrame.LookVector
    return pos + (face and face * 9 or -toMeU * 9) + Vector3.new(0, 0.5, 0) -- в лицо
end

-- ручной выстрел ремоутом Shoot (метод Pulse Hub) — работает ЧЕРЕЗ СТЕНЫ
function sa3FireShot(targetPlayer, fromAbove)
    local myChar = getChar(LocalPlayer)
    local myHRP = myChar and getHRP(myChar)
    local gun = myChar and myChar:FindFirstChild("Gun")
    if not gun then
        local bp = LocalPlayer:FindFirstChild("Backpack")
        gun = bp and bp:FindFirstChild("Gun")
        if gun then
            local hum = getHum(myChar)
            if hum then
                pcall(function() hum:EquipTool(gun) end)
                task.wait(0.2)
                myChar = getChar(LocalPlayer)
                gun = myChar and myChar:FindFirstChild("Gun")
            end
        end
    end
    local shoot = gun and (gun:FindFirstChild("Shoot") or gun:FindFirstChild("Shoot", true))
    -- [v1.18] стрельба без гана (например, из лобби): ищем Shoot-ремоут глобально
    if not (myHRP and shoot) and myHRP and SA3.NoGun then
        pcall(function()
            local rem = ReplicatedStorage:FindFirstChild("Remotes")
            local cand = rem and (rem:FindFirstChild("Shoot") or rem:FindFirstChild("Shoot", true))
            if cand and cand:IsA("RemoteEvent") then shoot = cand end
        end)
    end
    if not (myHRP and shoot) then return false end
    -- [v1.23] цель резолвим сразу: авто-режим (без аргумента) тоже должен знать
    -- жертву — иначе origin улетает к нам (в лобби) и пуля не долетает до цели
    local tgt = targetPlayer or pickSA()
    local pos = sa3AimPos(tgt)
    if not pos then return false end
    local origin
    if SA3.Magic then
        -- [v1.23] Magic: только Над головой / Со спины / в лицо / Смесь;
        -- из-под ног, косо и 360° сфера убраны (просил оставить два стиля)
        origin = sa3MagicOrigin(pos, tgt, myHRP)
    elseif fromAbove then
        -- классика Shoot Murderer: пуля НАД ГОЛОВОЙ цели, летит сверху вниз
        origin = Vector3.new(pos.X, pos.Y + 6, pos.Z)
    elseif SA3.Spoof and tgt then
        -- [v1.8] SPOOF из нового Pulse (AimEngine.spoofPlan): origin по ВЕКТОРУ
        -- СКОРОСТИ жертвы — пуля летит вдоль траектории жертвы и проходит сквозь
        -- неё. Дистанция = скорость * 0.1с (клампим 80..300, как в Pulse).
        local vc = getChar(tgt)
        local vhrp = getHRP(vc)
        local vel = vhrp and vhrp.AssemblyLinearVelocity or Vector3.zero
        local hv = Vector3.new(vel.X, 0, vel.Z)
        local speed = hv.Magnitude
        if speed > 2 then
            local dist = math.clamp(speed * 0.1, 80, 300)
            origin = pos + hv.Unit * dist
        else
            local d = myHRP.Position - pos
            local away = d.Magnitude > 0.1 and d.Unit or Vector3.new(0, 0, 1)
            origin = pos + away * (SA3.ForceOffset or 15)
        end
    elseif SA3.Wallbang or tgt or SA3.OriginMode == "Возле жертвы (магия)" then
        -- [v1.23] origin возле жертвы В НАШУ СТОРОНУ — теперь и для авто-режима:
        -- стреляет сквозь стены и ДАЖЕ ИЗ ЛОББИ (пуля стартует у жертвы, не у нас)
        local d = myHRP.Position - pos
        local away = d.Magnitude > 0.1 and d.Unit or Vector3.new(0, 0, 1)
        origin = pos + away * (SA3.ForceOffset or 15)
    else
        origin = myHRP.Position
    end
    -- [v1.23] «Откуда летит пуля»: возле жертвы (по умолчанию — работает из
    -- лобби), от меня (обычный вид; через стены может не пробиться) или смесь
    if SA3.OriginMode == "От меня (обычный вид)"
        or (SA3.OriginMode == "Смесь" and math.random(1, 2) == 2) then
        local cam = workspace.CurrentCamera
        origin = cam and cam.CFrame.Position or myHRP.Position + Vector3.new(0, 1.5, 0)
    end
    -- [v1.18] не задеть невиновных: игрок вплотную к жертве или на пути пули → отмена
    if SA3.NoInnocent then
        local blocked = false
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p ~= targetPlayer then
                local eHRP = getHRP(getChar(p))
                local h = getHum(getChar(p))
                if eHRP and h and h.Health > 0 then
                    if (eHRP.Position - pos).Magnitude < 4.5 then
                        blocked = true
                    else
                        local seg = pos - origin
                        local m2 = seg:Dot(seg)
                        if m2 > 0.01 then
                            local t = math.clamp((eHRP.Position - origin):Dot(seg) / m2, 0, 1)
                            if (origin + seg * t - eHRP.Position).Magnitude < 3.5 then
                                blocked = true
                            end
                        end
                    end
                end
            end
        end
        if blocked then
            Notify("Silent Aim", "Выстрел отменён — рядом игрок (не задеть невиновных)", nil, 2)
            return false
        end
    end
    SA3Bypass = true
    local ok = pcall(function()
        local cf = (pos - origin).Magnitude < 0.1 and CFrame.new(origin) or CFrame.new(origin, pos)
        shoot:FireServer(cf, CFrame.new(pos))
    end)
    SA3Bypass = false
    if ok then cwhTracer(origin, pos) end -- [v1.10] след пули
    -- [v1.18] мульти-выстрел: «Мгновенно ×3» — 3 пули сразу с разбросом;
    -- «Серия ×3» — после каждого выстрела ждём перезарядку (~3с) и заново
    -- целимся в живую цель (MM2 даёт КД после выстрела, мгновенные №2-№3 отбрасывались)
    if ok and SA3.Multi and SA3.Multi ~= "Выкл" then
        if SA3.Multi == "Мгновенно ×3" then
            local ray = pos - origin
            local perp = Vector3.new(-ray.Z, 0, ray.X)
            if perp.Magnitude > 0.1 then
                perp = perp.Unit
                local offs = { perp * 2.2 + Vector3.new(0, 1.4, 0), -perp * 2.2 - Vector3.new(0, 1.4, 0) }
                for _, off in ipairs(offs) do
                    pcall(function()
                        SA3Bypass = true
                        shoot:FireServer(CFrame.new(origin, pos + off), CFrame.new(pos + off))
                        SA3Bypass = false
                    end)
                end
                cwhTracer(origin, pos + offs[1])
                cwhTracer(origin, pos + offs[2])
            end
        else
            local delay = math.max(0.05, SA3.MultiDelay or 3.2)
            for i = 1, 2 do
                task.delay(delay * i, function()
                    pcall(function()
                        if not getgenv().CWH_RUN then return end
                        local tgt = targetPlayer or pickSA()
                        local c2 = tgt and getChar(tgt)
                        local h2 = c2 and getHum(c2)
                        if not (c2 and h2 and h2.Health > 0) then return end
                        if not shoot then return end
                        local p2 = sa3AimPos(tgt)
                        if not p2 then return end
                        local o2 = origin
                        if SA3.Magic then
                            o2 = sa3MagicOrigin(p2, tgt, myHRP)
                        end
                        SA3Bypass = true
                        shoot:FireServer(CFrame.new(o2, p2), CFrame.new(p2))
                        SA3Bypass = false
                        cwhTracer(o2, p2)
                    end)
                end)
            end
        end
    end
    return ok
end

local function installHooks()
    local m = getWS()
    if not m then return false end
    if hooked3 then return true end
    pcall(function() setreadonly(m, false) end)
    if type(m.GetMouseTargetCFrame) == "function" then
        origM3 = m.GetMouseTargetCFrame
        m.GetMouseTargetCFrame = function(s, ...)
            if SA3.On and not SA3Bypass then
                local pos = sa3AimPos()
                if pos then return CFrame.new(pos) end
            end
            return origM3(s, ...)
        end
    end
    if type(m.GetTargetPosition) == "function" then
        origT3 = m.GetTargetPosition
        m.GetTargetPosition = function(s, ...)
            if SA3.On and not SA3Bypass then
                local pos = sa3AimPos()
                if pos then return pos end
            end
            return origT3(s, ...)
        end
    end
    hooked3 = true
    return true
end

local function removeHooks()
    if WS3 and hooked3 then
        pcall(function() setreadonly(WS3, false) end)
        if origM3 then pcall(function() WS3.GetMouseTargetCFrame = origM3 end) end
        if origT3 then pcall(function() WS3.GetTargetPosition = origT3 end) end
    end
    hooked3 = false
end

