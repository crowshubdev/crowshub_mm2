}

local ESPObjects = {}
local GunESPObject = nil

-- Cleanup function
local function ClearAllESP()
    for _, obj in pairs(ESPObjects) do
        if obj.Highlight then obj.Highlight:Destroy() end
        if obj.NameTag then obj.NameTag:Destroy() end
        if obj.Box then obj.Box:Destroy() end
        if obj.Tracer then obj.Tracer:Destroy() end
        if obj.HealthBar then obj.HealthBar:Destroy() end
    end
    ESPObjects = {}
    
    if GunESPObject then
        if GunESPObject.Highlight then GunESPObject.Highlight:Destroy() end
        if GunESPObject.NameTag then GunESPObject.NameTag:Destroy() end
        GunESPObject = nil
    end
end

-- Create Billboard GUI for name/distance/health
local function CreateBillboard(parent, size)
    local billboard = Instance.new("BillboardGui")
    billboard.Size = size or UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = parent
    return billboard
end

local function CreatePlayerESP(player)
    if player == LocalPlayer then return end
    if ESPObjects[player] then return end
    
    local char = SafeGetCharacter(player)
    if not char then return end
    
    local espData = {}
    
    -- Highlight
    local hl = Instance.new("Highlight")
    hl.Name = "CrowsESP_Highlight"
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillTransparency = 0.6
    hl.OutlineTransparency = 0.2
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.Parent = char
    espData.Highlight = hl
    
    -- Name Tag
    local nameBillboard = CreateBillboard(char, UDim2.new(0, 200, 0, 30))
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 1, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextStrokeTransparency = 0.5
    nameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 14
    nameLabel.Parent = nameBillboard
    espData.NameTag = nameBillboard
    espData.NameLabel = nameLabel
    
    -- Health Bar
    local healthBillboard = CreateBillboard(char, UDim2.new(0, 100, 0, 6))
    healthBillboard.StudsOffset = Vector3.new(0, 2.5, 0)
    local healthBg = Instance.new("Frame")
    healthBg.Size = UDim2.new(1, 0, 1, 0)
    healthBg.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    healthBg.BorderSizePixel = 0
    healthBg.Parent = healthBillboard
    local healthFill = Instance.new("Frame")
    healthFill.Size = UDim2.new(1, 0, 1, 0)
    healthFill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    healthFill.BorderSizePixel = 0
    healthFill.Parent = healthBg
    espData.HealthBar = healthBillboard
    espData.HealthFill = healthFill
    
    ESPObjects[player] = espData
end

local function UpdatePlayerESP(player)
    local espData = ESPObjects[player]
    if not espData then return end
    
    local char = SafeGetCharacter(player)
    if not char then
        if espData.Highlight then espData.Highlight:Destroy() end
        if espData.NameTag then espData.NameTag:Destroy() end
        if espData.HealthBar then espData.HealthBar:Destroy() end
        ESPObjects[player] = nil
        return
    end
    
    local role = GetRole(player)
    local roleColor = GetRoleColor(role)
    local hum = SafeGetHumanoid(char)
    local hrp = SafeGetHRP(char)
    local localHRP = SafeGetHRP(SafeGetCharacter(LocalPlayer))
    
    -- Update highlight
    if espData.Highlight then
        espData.Highlight.FillColor = roleColor
        espData.Highlight.Enabled = ESP.Players
    end
    
    -- Update name tag
    if espData.NameTag and espData.NameLabel then
        espData.NameTag.Enabled = ESP.Names or ESP.Distance
        local text = ""
        if ESP.Names then
            text = player.Name .. " [" .. role .. "]"
        end
        if ESP.Distance and localHRP and hrp then
            local dist = math.floor((localHRP.Position - hrp.Position).Magnitude)
            text = text .. "\n" .. dist .. " studs"
        end
        espData.NameLabel.Text = text
        espData.NameLabel.TextColor3 = roleColor
    end
    
    -- Update health bar
    if espData.HealthBar and espData.HealthFill then
        espData.HealthBar.Enabled = ESP.Health and hum ~= nil
        if hum then
            local healthPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            espData.HealthFill.Size = UDim2.new(healthPercent, 0, 1, 0)
            espData.HealthFill.BackgroundColor3 = Color3.fromRGB(
                255 * (1 - healthPercent),
                255 * healthPercent,
                0
            )
        end
    end
end

-- Gun ESP
local function UpdateGunESP()
    local gun = workspace:FindFirstChild("GunDrop", true)
    
    if not gun or not ESP.Gun then
        if GunESPObject then
            if GunESPObject.Highlight then GunESPObject.Highlight:Destroy() end
            if GunESPObject.NameTag then GunESPObject.NameTag:Destroy() end
            GunESPObject = nil
        end
        return
    end
    
    if not GunESPObject then
        GunESPObject = {}
        
        local hl = Instance.new("Highlight")
        hl.Name = "CrowsESP_Gun"
        hl.FillColor = Color3.fromRGB(255, 215, 0)
        hl.OutlineColor = Color3.fromRGB(255, 255, 0)
        hl.FillTransparency = 0.3
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = gun
        GunESPObject.Highlight = hl
        
        local billboard = CreateBillboard(gun, UDim2.new(0, 150, 0, 25))
        billboard.StudsOffset = Vector3.new(0, 1, 0)
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = "🔫 GUN DROP"
        label.TextColor3 = Color3.fromRGB(255, 215, 0)
        label.TextStrokeTransparency = 0.3
        label.Font = Enum.Font.GothamBold
        label.TextSize = 16
        label.Parent = billboard
        GunESPObject.NameTag = billboard
    end
end

