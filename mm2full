-- [v1.4] Твой звук (hitsound_431f0.mp3, 0.9 сек) зашит прямо в скрипт как base64 —
-- никаких ссылок и хостинга. При старте: декод → writefile("cwh_hitsound.mp3") в папку
-- экзекьютора → getcustomasset → rbx-ассет. Играется в Kill Sound / Shot Sound / Перезарядке.
getgenv().CWH_CustomHitsId = nil
local B64 = ""
task.spawn(function()
    local ok, err = pcall(function()
        local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
        local lookup = {}
        for i = 1, #chars do lookup[string.sub(chars, i, i)] = i - 1 end
        local data = string.gsub(B64, "=+$", "")
        local out, buf, bits = {}, 0, 0
        for i = 1, #data do
            local v = lookup[string.sub(data, i, i)]
            if v then
                buf = buf * 64 + v
                bits = bits + 6
                if bits >= 8 then
                    bits = bits - 8
                    out[#out + 1] = string.char(math.floor(buf / 2 ^ bits) % 256)
                    buf = buf % 2 ^ bits
                end
            end
        end
        writefile("cwh_hitsound.mp3", table.concat(out))
        local fn = getcustomasset or getsynasset
        if not fn then error("getcustomasset не поддерживается этим экзекьютором") end
        local id = fn("cwh_hitsound.mp3")
        if type(id) == "string" and id ~= "" then
            getgenv().CWH_CustomHitsId = id
            print("[CWH] MP3-хитсаунд готов: cwh_hitsound.mp3 → " .. id)
        else
            error("getcustomasset вернул пустой результат")
        end
    end)
    if not ok then
        print("[CWH] MP3-хитсаунд НЕ загрузился (" .. tostring(err) .. ") — выбери звук из списка")
    end
end)
