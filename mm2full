task.spawn(function()
    local Stats = game:GetService("Stats")
    local RunService = game:GetService("RunService")
    while perfGui.Parent do
        local measured = nil

        -- способ 1: серверная статистика
        pcall(function()
            local nw = Stats.Network
            local lat = nw and nw.ServerLatency
            if type(lat) == "number" and lat > 0 then
                measured = lat
            end
        end)

        -- способ 2:hearbeat-джиттер (работает всегда)
        if not measured then
            local t0 = os.clock()
            RunService.Heartbeat:Wait()
            local t1 = os.clock()
            local frame = (t1 - t0) * 1000
            -- ожидание кадра ~ (1000/fps), лишнее = сетевой джиттер
            local expected = 1000 / math.max(fpsLast, 10)
            local extra = frame - expected
            if extra > 0 then
                measured = math.clamp(extra, 0, 2000)
            else
                measured = 0
            end
        end

        pingSmooth = pingSmooth * 0.7 + (measured or pingSmooth) * 0.3

        if pingLabel.Parent then
            pingLabel.Text = string.format("📶 %d ms", math.floor(pingSmooth))
            pingLabel.TextColor3 = pingSmooth <= 100 and Color3.fromRGB(80, 255, 120)
