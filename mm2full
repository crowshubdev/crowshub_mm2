do -- ═══ [CWH SCOPE] G6: Shoot Murderer v4 + Keybind — техн. обёртка (лимит 200 регистров Luau) ═══
-- ═══════════════════════════════════════════════════════════════
local smbGui = Instance.new("ScreenGui")
