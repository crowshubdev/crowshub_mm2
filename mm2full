    Hero     = Color3.fromRGB(255, 210, 60),
    Innocent = Color3.fromRGB(90, 230, 130),
    Unknown  = Color3.fromRGB(176, 182, 204),
}
local ESP_INFO_C = Color3.fromRGB(230, 232, 240)

-- роль для ESP (механика наша): пистолет у НЕ-шерифа = HERO (шериф умер, кто-то поднял пушку)
local espCache, espCacheT = {}, 0
local function espRoleOf(plr)
    local now = os.clock()
    if now - espCacheT > 0.3 then espCache = {} espCacheT = now end
    if not espCache[plr] then
        local role = "Unknown"
        local c = plr and plr.Character
        local bp = plr and plr:FindFirstChild("Backpack")
        local hasKnife = (c and c:FindFirstChild("Knife")) or (bp and bp:FindFirstChild("Knife"))
        local hasGun = (c and c:FindFirstChild("Gun")) or (bp and bp:FindFirstChild("Gun"))
        local sd = ServerRoles[plr.Name]
        if hasKnife then
            role = "Murderer"
        elseif hasGun then
            local isSheriff = type(sd) == "table" and sd.Role == "Sheriff" and not sd.Dead and not sd.Killed
            role = isSheriff and "Sheriff" or "Hero"
        elseif type(sd) == "table" and sd.Role then
            if sd.Role == "Murderer" then
                role = "Murderer"
            elseif sd.Role == "Sheriff" and not sd.Dead and not sd.Killed then
                role = "Sheriff"
            else
                role = "Innocent"
            end
        elseif c then
            role = "Innocent"
        end
        espCache[plr] = role
    end
    return espCache[plr]
end

local function espWeaponOf(plr)
    local c = plr and plr.Character
    local bp = plr and plr:FindFirstChild("Backpack")
    if (c and c:FindFirstChild("Knife")) or (bp and bp:FindFirstChild("Knife")) then return "🔪" end
    if (c and c:FindFirstChild("Gun")) or (bp and bp:FindFirstChild("Gun")) then return "🔫" end
    return ""
end

