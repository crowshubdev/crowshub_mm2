local NotifiedRoles = {}
local LastMapName = nil

local function ResetRoleNotifications()
    NotifiedRoles = {}
end

local function DetectRoles()
    local map = getMap()
    if map and map.Name ~= LastMapName then
        LastMapName = map.Name
        ResetRoleNotifications()
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local role = GetRole(player)
        if role == "Murderer" and NotifiedRoles[player] ~= "Murderer" then
            NotifiedRoles[player] = "Murderer"
            RoleDetectSound:Play()
            Notify("🩸 Murderer", player.Name .. " is the Murderer!", nil, 8)
        elseif role == "Sheriff" and NotifiedRoles[player] ~= "Sheriff" then
            NotifiedRoles[player] = "Sheriff"
            RoleDetectSound:Play()
            Notify("🔫 Sheriff", player.Name .. " is the Sheriff!", nil, 8)
        end
    end
end

task.spawn(function()
    while not getgenv().CWH_Unloaded do
        pcall(DetectRoles)
        task.wait(0.5)
    end
end)

