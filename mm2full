-- ═══════════════════════════════════════════════════════════════
local ESPConfig = {
    Players = false,
    Names = false,
    Distance = false,
    Health = false
}

local roleCache = {}
local roleCacheTime = 0

local function getCachedRole(plr)
    local now = os.clock()
    if now - roleCacheTime > 0.5 then
        roleCache = {}
        roleCacheTime = now
    end
    if not roleCache[plr] then roleCache[plr] = GetRole(plr) end
    return roleCache[plr]
end

local function createPlayerHighlight(player)
    local char = SafeGetCharacter(player)
    if not char then return end
    if char:FindFirstChild("CrowsESP_HL") then return end
    local hl = Instance.new("Highlight")
    hl.Name = "CrowsESP_HL"
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillTransparency = 0.6
    hl.OutlineTransparency = 0.2
    hl.Parent = char
end

local function createPlayerNameTag(player)
    local char = SafeGetCharacter(player)
    if not char then return end
    local hrp = SafeGetHRP(char)
    if not hrp then return end
    if hrp:FindFirstChild("CrowsNameESP") then return end

    local bg = Instance.new("BillboardGui")
    bg.Name = "CrowsNameESP"
    bg.Adornee = hrp
    bg.Size = UDim2.new(0, 200, 0, 60)
    bg.StudsOffset = Vector3.new(0, 3, 0)
    bg.AlwaysOnTop = true
    bg.Parent = hrp

    local text = Instance.new("TextLabel")
    text.Name = "Label"
    text.BackgroundTransparency = 1
    text.Size = UDim2.new(1, 0, 1, 0)
    text.TextSize = 14
    text.Font = Enum.Font.GothamBold
    text.TextColor3 = Color3.fromRGB(255, 255, 255)
    text.TextStrokeTransparency = 0
    text.TextStrokeColor3 = Color3.new(0, 0, 0)
    text.Text = ""
    text.Parent = bg
end

local function updateESP()
    local myHRP = SafeGetHRP(SafeGetCharacter(LocalPlayer))
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = SafeGetCharacter(plr)
        if not char then continue end

        local role = getCachedRole(plr)
        local roleColor = GetRoleColor(role)

        if ESPConfig.Players then
            createPlayerHighlight(plr)
            local hl = char:FindFirstChild("CrowsESP_HL")
            if hl then
                hl.FillColor = roleColor
                hl.OutlineColor = roleColor
                hl.Enabled = true
            end
        else
            local hl = char:FindFirstChild("CrowsESP_HL")
            if hl then hl.Enabled = false end
        end

        if ESPConfig.Names or ESPConfig.Distance or ESPConfig.Health then
            createPlayerNameTag(plr)
            local hrp = SafeGetHRP(char)
            local bg = hrp and hrp:FindFirstChild("CrowsNameESP")
            if bg then
                bg.Enabled = true
                local label = bg:FindFirstChild("Label")
                if label then
                    local lines = {}
                    if ESPConfig.Names then
                        table.insert(lines, plr.Name .. " [" .. role .. "]")
                    end
                    if ESPConfig.Health then
                        local hum = SafeGetHumanoid(char)
                        if hum then
                            table.insert(lines, "HP: " .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth))
                        end
                    end
                    if ESPConfig.Distance and myHRP and hrp then
                        local dist = math.floor((myHRP.Position - hrp.Position).Magnitude)
                        table.insert(lines, dist .. " studs")
                    end
                    label.Text = table.concat(lines, "\n")
                    label.TextColor3 = roleColor
                end
            end
        else
            local hrp = SafeGetHRP(char)
            local bg = hrp and hrp:FindFirstChild("CrowsNameESP")
            if bg then bg.Enabled = false end
        end
    end
end

task.spawn(function()
    while not getgenv().CWH_Unloaded do
        if ESPConfig.Players or ESPConfig.Names or ESPConfig.Distance or ESPConfig.Health then
            pcall(updateESP)
        end
        task.wait(0.2)
    end
end)

