local function GetMurderer()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local backpack = player:FindFirstChild("Backpack")
            local char = player.Character
            if (backpack and backpack:FindFirstChild("Knife")) or (char and char:FindFirstChild("Knife")) then
                return player
            end
        end
    end
    return nil
end

local function ShootMurdererAction()
    local char = LocalPlayer.Character
    if not char then return end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local gun = (backpack and backpack:FindFirstChild("Gun")) or (char:FindFirstChild("Gun"))
    if not gun then return end
    
    if gun.Parent == backpack then gun.Parent = char end
    
    local murderer = GetMurderer()
    if murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart") then
        local targetHrp = murderer.Character.HumanoidRootPart
        local remote = gun:FindFirstChild("Shoot") or gun:FindFirstChild("ShootRemote") or game:GetService("ReplicatedStorage"):FindFirstChild("Shoot", true)
        if remote then
            local targetPos = targetHrp.Position + (targetHrp.Velocity * 0.1)
            if remote:IsA("RemoteEvent") then
                remote:FireServer(CFrame.new(char.HumanoidRootPart.Position, targetPos), targetPos)
            elseif remote:IsA("RemoteFunction") then
                remote:InvokeServer(CFrame.new(char.HumanoidRootPart.Position, targetPos), targetPos)
            end
        end
    end
end

ShootBtn.MouseButton1Click:Connect(ShootMurdererAction)

