do -- ═══ [CWH SCOPE] G9g: POTATO MODE (мыльная графика, оптимизация) ═══
-- [v1.8] Минимальное качество рендера, убираем текстуры/декали/частицы,
-- гасим лишний свет и пост-эффекты. В отличие от FPS Booster — ВСЁ
-- восстанавливается при выключении (сохраняем оригинальные значения).
local POT = { On = false, saved = {}, conn = nil, qual = nil }

local function potSave(obj, prop, val)
    if POT.saved[obj] == nil then POT.saved[obj] = {} end
    if POT.saved[obj][prop] == nil then
        POT.saved[obj][prop] = val
    end
end

local function potApplyNew(o)
    pcall(function()
        if o:IsA("ParticleEmitter") or o:IsA("Smoke") or o:IsA("Fire")
            or o:IsA("Sparkles") or o:IsA("Beam") or o:IsA("Trail") then
            if o.Enabled then potSave(o, "Enabled", true) o.Enabled = false end
        elseif o:IsA("Decal") or o:IsA("Texture") then
            if o.Transparency < 1 then potSave(o, "Transparency", o.Transparency) o.Transparency = 1 end
        elseif o:IsA("PointLight") or o:IsA("SpotLight") or o:IsA("SurfaceLight") then
            if o.Enabled then potSave(o, "Enabled", true) o.Enabled = false end
        end
    end)
end

local function potLightingOn()
    local L = game:GetService("Lighting")
    pcall(function()
        potSave(L, "GlobalShadows", L.GlobalShadows)
        L.GlobalShadows = false
        potSave(L, "FogEnd", L.FogEnd)
        L.FogEnd = 800
        potSave(L, "Brightness", L.Brightness)
        L.Brightness = 2
    end)
    for _, e in ipairs(L:GetChildren()) do
        pcall(function()
            if e:IsA("PostEffect") and e.Enabled then
                potSave(e, "Enabled", true)
                e.Enabled = false
            end
        end)
    end
    pcall(function()
        local ok, q = pcall(function() return settings().Rendering.QualityLevel end)
        if ok then POT.qual = q end
        settings().Rendering.QualityLevel = 1 -- мыльный рендер
    end)
end

local function potOn()
    for _, o in ipairs(workspace:GetDescendants()) do potApplyNew(o) end
    -- "мыло": карта в SmoothPlastic (персонажи не трогаем)
    for _, o in ipairs(workspace:GetDescendants()) do
        pcall(function()
            if o:IsA("BasePart") then
                local m = o:FindFirstAncestorOfClass("Model")
                local isChar = m and Players:GetPlayerFromCharacter(m)
                if not isChar and o.Material ~= Enum.Material.SmoothPlastic then
                    potSave(o, "Material", o.Material)
                    o.Material = Enum.Material.SmoothPlastic
                end
            end
        end)
    end
    pcall(function()
        local T = workspace.Terrain
        potSave(T, "Decoration", T.Decoration)
        T.Decoration = false
        potSave(T, "WaterReflect", T.WaterReflect)
        T.WaterReflect = false
        potSave(T, "WaterWave", T.WaterWave)
        T.WaterWave = false
    end)
    potLightingOn()
    POT.conn = workspace.DescendantAdded:Connect(potApplyNew)
    Notify("Potato Mode", "🥔 ВКЛ — мыльная графика. Выключи, чтобы вернуть всё", nil, 3)
end

local function potOff()
    if POT.conn then
        pcall(function() POT.conn:Disconnect() end)
        POT.conn = nil
    end
    for obj, props in pairs(POT.saved) do
        for prop, val in pairs(props) do
            pcall(function() obj[prop] = val end)
        end
    end
    POT.saved = {}
    if POT.qual then
        pcall(function() settings().Rendering.QualityLevel = POT.qual end)
        POT.qual = nil
    end
    Notify("Potato Mode", "Графика восстановлена", nil, 2)
end

Tabs.World:AddSection("Potato Mode")
Tabs.World:AddToggle("PotatoMode", {
    Title = "🥔 Potato Mode",
    Description = "[v1.8] Мыльная графика: минимальный рендер, без текстур/частиц/лишнего света. Выключение возвращает всё",
    Default = false
}):OnChanged(function(v)
    POT.On = v
    if v then
        task.spawn(potOn)
    else
        task.spawn(potOff)
    end
end)

print("[CWH] INIT G9g OK (Potato Mode)")
end -- [CWH SCOPE] G9g

