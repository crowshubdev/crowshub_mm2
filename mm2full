-- ═══ [v1.12] NO COIN ═══
-- Монеты для ТЕБЯ исчезают (Transparency=1) и их нельзя взять (CanTouch=false):
-- спид-глитч по всей карте без сбора монет → нет «неверной позиции» от анти-чита.
-- Текущая цель фермы НЕ трогается — фарм продолжает собирать. Кейбинд — в Other.
local noCoinOn = false
local noCoinCache = {} -- [part] = {t = исходная Transparency}
local function noCoinScan()
    local seen = {}
    local farmRef = getgenv().CWH_FarmRef
    local exempt = farmRef and farmRef.Target or nil
    local list = {}
    local okTag, tagged = pcall(function()
        return game:GetService("CollectionService"):GetTagged("CoinVisual")
    end)
    if okTag and tagged then
        for _, v in ipairs(tagged) do
            if v and v:IsA("BasePart") and v.Parent then list[#list + 1] = v end
        end
    end
    local map = getMap()
    local cont = map and map:FindFirstChild("CoinContainer")
    if cont then
        for _, c in ipairs(cont:GetChildren()) do
            local p = c:IsA("BasePart") and c or c:FindFirstChildWhichIsA("BasePart", true)
            if p then list[#list + 1] = p end
        end
    end
    for _, p in ipairs(list) do
        if not seen[p] and p.Parent and p ~= exempt then
            seen[p] = true
            if noCoinCache[p] == nil then
                noCoinCache[p] = { t = p.Transparency }
            end
            pcall(function()
                p.Transparency = 1
                p.CanTouch = false
            end)
        end
    end
end
local function noCoinRestore()
    for p, v in pairs(noCoinCache) do
        if p and p.Parent then
            pcall(function()
                p.Transparency = v.t
                p.CanTouch = true
            end)
        end
    end
    noCoinCache = {}
end
local function noCoinToggle()
    noCoinOn = not noCoinOn
    pcall(function()
        local T = OBS.Toggles
        if T and T["NoCoinOn"] then T["NoCoinOn"]:SetValue(noCoinOn) end
    end)
    if not noCoinOn then noCoinRestore() end
    Notify("No Coin", noCoinOn
        and "🪙 ВКЛ: монеты для тебя исчезли и не собираются (цель фермы не тронута)"
        or "ВЫКЛ: монеты видны и собираются снова", nil, 3)
end
getgenv().CWH_NoCoinToggle = noCoinToggle
getgenv().CWH_NoCoinOn = function() return noCoinOn end

task.spawn(function()
