-- FIXED: Silent Aim with proper shooting
local oldFireServer = nil
pcall(function()
    local mt = getrawmetatable(game)
    if mt then
        oldFireServer = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" and self:IsA("RemoteEvent") and SilentAimEnabled then
                local name = self.Name:lower()
                if name:find("shoot") or name:find("fire") or name:find("gun") or name:find("bullet") then
                    local target = nil
                    if SilentAimTarget == "Murderer" then target = GetMurderer()
                    elseif SilentAimTarget == "Sheriff" then target = GetSheriff()
                    else
                        local closest = nil
                        local minDist = math.huge
                        local myHRP = SafeGetHRP(SafeGetCharacter(LocalPlayer))
                        for _, p in pairs(Players:GetPlayers()) do
                            if p ~= LocalPlayer then
                                local pHRP = SafeGetHRP(SafeGetCharacter(p))
                                if pHRP and myHRP then
                                    local d = (pHRP.Position - myHRP.Position).Magnitude
                                    if d < minDist then minDist = d closest = p end
                                end
                            end
                        end
                        target = closest
                    end
                    if target then
                        local tChar = SafeGetCharacter(target)
                        local tPart = tChar and (tChar:FindFirstChild("Head") or tChar:FindFirstChild("UpperTorso") or tChar:FindFirstChild("HumanoidRootPart"))
                        if tPart then
                            local args = {...}
                            if #args > 0 and typeof(args[1]) == "Vector3" then
                                args[1] = tPart.Position
                                return oldFireServer(self, unpack(args))
                            end
                        end
                    end
                end
            end
            return oldFireServer(self, ...)
        end)
        setreadonly(mt, true)
    end
end)

