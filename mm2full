local sa3FireShot -- [CWH] форвард-декларация (определение в Silent Aim, вызов в Shoot Murderer)
do -- ═══ [CWH SCOPE] G3: Silent Aim v3 + Wallbang — техн. обёртка (лимит 200 регистров Luau) ═══
-- ═══════════════════════════════════════════════════════════════
local SA3 = { On = false, Target = "Murderer", Predict = true, Range = 500,
              AimPart = "Torso", Wallbang = false, AutoShoot = false, Interval = 1.5, Last = 0 }
local WS3, origM3, origT3, hooked3 = nil, nil, nil, false
local SA3Bypass = false -- true: хук отдаёт настоящую мышь, чтобы не мешать нашему выстрелу

local function getWS()
    if WS3 then return WS3 end
    local ok, m = pcall(function()
        return require(ReplicatedStorage:WaitForChild("ClientServices", 10):WaitForChild("WeaponService", 10))
    end)
    if ok and type(m) == "table" then WS3 = m end
    return WS3
end

local function pickSA()
    if SA3.Target == "Murderer" then return getMurderer() end
    if SA3.Target == "Sheriff" then return getSheriff() end
    local my = getHRP(getChar(LocalPlayer))
    if not my then return end
    local best, bd = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local h = getHum(getChar(p))
            local hrp = getChar(p) and getHRP(getChar(p))
            if h and h.Health > 0 and hrp then
                local d = (hrp.Position - my.Position).Magnitude
                if d < bd then bd = d best = p end
            end
        end
    end
    return best
end

-- точка прицела (с предсказанием по скорости цели)
local function sa3AimPos(targetPlayer)
    local t = targetPlayer or pickSA()
    local c = t and t.Character
    if not c then return nil end
    local hum = getHum(c)
    if not (hum and hum.Health > 0) then return nil end
    local part = (SA3.AimPart == "Head" and c:FindFirstChild("Head")) or c:FindFirstChild("UpperTorso")
        or c:FindFirstChild("Torso") or c:FindFirstChild("HumanoidRootPart")
    local my = getHRP(getChar(LocalPlayer))
    if not (part and my) then return nil end
    if (part.Position - my.Position).Magnitude > SA3.Range then return nil end
    local pos = part.Position
    if SA3.Predict then
        local root = getHRP(c)
        if root then
            local vel = root.AssemblyLinearVelocity or Vector3.zero
            local ping = 0
            pcall(function() ping = LocalPlayer:GetNetworkPing() or 0 end)
            if ping > 1 then ping = ping / 1000 end
            pos = pos + vel * (ping + 0.05)
        end
    end
    return pos
end

-- ручной выстрел ремоутом Shoot (метод Pulse Hub) — работает ЧЕРЕЗ СТЕНЫ
function sa3FireShot(targetPlayer)
    local myChar = getChar(LocalPlayer)
    local myHRP = myChar and getHRP(myChar)
    local gun = myChar and myChar:FindFirstChild("Gun")
    if not gun then
        local bp = LocalPlayer:FindFirstChild("Backpack")
        gun = bp and bp:FindFirstChild("Gun")
        if gun then
            local hum = getHum(myChar)
            if hum then
                pcall(function() hum:EquipTool(gun) end)
                task.wait(0.2)
                myChar = getChar(LocalPlayer)
                gun = myChar and myChar:FindFirstChild("Gun")
            end
        end
    end
    local shoot = gun and (gun:FindFirstChild("Shoot") or gun:FindFirstChild("Shoot", true))
    if not (myHRP and gun and shoot) then return false end
    local pos = sa3AimPos(targetPlayer)
    if not pos then return false end
    local origin
    if SA3.Wallbang or targetPlayer then
        -- точка в 3 студах от жертвы В НАШУ СТОРОНУ = сразу за стеной (трюк Pulse)
        local d = myHRP.Position - pos
        local away = d.Magnitude > 0.1 and d.Unit or Vector3.new(0, 0, 1)
        origin = pos + away * 3
    else
        origin = myHRP.Position
    end
    SA3Bypass = true
    local ok = pcall(function()
        local cf = (pos - origin).Magnitude < 0.1 and CFrame.new(origin) or CFrame.new(origin, pos)
        shoot:FireServer(cf, CFrame.new(pos))
    end)
    SA3Bypass = false
    return ok
end

local function installHooks()
    local m = getWS()
    if not m then return false end
    if hooked3 then return true end
    pcall(function() setreadonly(m, false) end)
    if type(m.GetMouseTargetCFrame) == "function" then
        origM3 = m.GetMouseTargetCFrame
        m.GetMouseTargetCFrame = function(s, ...)
            if SA3.On and not SA3Bypass then
                local pos = sa3AimPos()
                if pos then return CFrame.new(pos) end
            end
            return origM3(s, ...)
        end
    end
    if type(m.GetTargetPosition) == "function" then
        origT3 = m.GetTargetPosition
        m.GetTargetPosition = function(s, ...)
            if SA3.On and not SA3Bypass then
                local pos = sa3AimPos()
                if pos then return pos end
            end
            return origT3(s, ...)
        end
    end
    hooked3 = true
    return true
end

local function removeHooks()
    if WS3 and hooked3 then
        pcall(function() setreadonly(WS3, false) end)
        if origM3 then pcall(function() WS3.GetMouseTargetCFrame = origM3 end) end
        if origT3 then pcall(function() WS3.GetTargetPosition = origT3 end) end
    end
    hooked3 = false
end

-- Wallbang-выстрел по клику мыши / тапу (если включён тоггл Wallbang)
UserInputService.InputBegan:Connect(function(i, gp)
    if gp then return end
    if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
        if SA3.On and SA3.Wallbang then
            task.spawn(function() sa3FireShot() end)
        end
    end
end)

-- Auto Shoot: сам стреляет по цели (без Wallbang — только при прямой видимости)
task.spawn(function()
    while task.wait(0.2) do
        if not getgenv().CWH_RUN then break end
        if SA3.On and SA3.AutoShoot then
            local now = os.clock()
            if now - SA3.Last >= SA3.Interval then
                local canShoot = SA3.Wallbang
                if not canShoot then
                    local t = pickSA()
                    local tc = t and t.Character
                    local thrp = tc and getHRP(tc)
                    local my = getHRP(getChar(LocalPlayer))
                    if thrp and my then
                        local params = RaycastParams.new()
                        params.FilterType = Enum.RaycastFilterType.Exclude
                        params.FilterDescendantsInstances = { getChar(LocalPlayer) }
                        local hit = workspace:Raycast(my.Position, thrp.Position - my.Position, params)
                        canShoot = (not hit) or (hit.Instance and tc and hit.Instance:IsDescendantOf(tc))
                    end
                end
                if canShoot then
                    SA3.Last = now
                    sa3FireShot()
                end
            end
        end
    end
end)

