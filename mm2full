RunService.RenderStepped:Connect(function()
    if not Crosshair.Enabled then return end
    local vp = Camera.ViewportSize
    local cx, cy = vp.X / 2, vp.Y / 2
    local len, gap, th = Crosshair.Size, Crosshair.Gap, Crosshair.Thickness

    CHTop.Size = UDim2.fromOffset(th, len)
    CHTop.Position = UDim2.fromOffset(cx - th / 2, cy - gap - len)
    CHBottom.Size = UDim2.fromOffset(th, len)
    CHBottom.Position = UDim2.fromOffset(cx - th / 2, cy + gap)
    CHLeft.Size = UDim2.fromOffset(len, th)
    CHLeft.Position = UDim2.fromOffset(cx - gap - len, cy - th / 2)
    CHRight.Size = UDim2.fromOffset(len, th)
    CHRight.Position = UDim2.fromOffset(cx + gap, cy - th / 2)

    CHDot.Size = UDim2.fromOffset(th, th)
    CHDot.Position = UDim2.fromOffset(cx - th / 2, cy - th / 2)
    CHDot.Visible = Crosshair.Dot
end)

