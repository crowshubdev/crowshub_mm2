-- GOD MODE (из Vision Hub)
-- ═══════════════════════════════════════════════════════════════
local _godConn = nil
local function protectHumanoid(h)
    if not h then return end
    task.spawn(function()
        while GodModeEnabled and h and h.Parent do
            if h.Health < h.MaxHealth then
                h.Health = h.MaxHealth
            end
            if h:GetState() == Enum.HumanoidStateType.Dead then
                h:ChangeState(Enum.HumanoidStateType.GettingUp)
                h.Health = h.MaxHealth
            end
            task.wait(0.2)
        end
    end)
end

local GodToggle = Tabs.Main:AddToggle("GodMode", { Title = "God Mode", Default = false })
GodToggle:OnChanged(function(Value)
    GodModeEnabled = Value
    if Value then
        protectHumanoid(SafeGetHumanoid(SafeGetCharacter(LocalPlayer)))
        if _godConn then _godConn:Disconnect() end
        _godConn = LocalPlayer.CharacterAdded:Connect(function(character)
            local hum = character:WaitForChild("Humanoid", 5)
            if hum and GodModeEnabled then
                task.wait(0.5)
                protectHumanoid(hum)
            end
        end)
    elseif _godConn then
        _godConn:Disconnect()
        _godConn = nil
    end
end)

