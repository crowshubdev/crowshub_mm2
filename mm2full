local function createPlayerHighlight(player)
    local char = SafeGetCharacter(player)
    if not char then return end
    if char:FindFirstChild("CrowsESP_HL") then return end
    local hl = Instance.new("Highlight")
    hl.Name = "CrowsESP_HL"
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillTransparency = 0.6
    hl.OutlineTransparency = 0.2
    hl.Parent = char
end

local function createPlayerNameTag(player)
    local char = SafeGetCharacter(player)
    if not char then return end
    local hrp = SafeGetHRP(char)
    if not hrp then return end
    if hrp:FindFirstChild("CrowsNameESP") then return end

    local bg = Instance.new("BillboardGui")
    bg.Name = "CrowsNameESP"
    bg.Adornee = hrp
    bg.Size = UDim2.new(0, 200, 0, 60)
    bg.StudsOffset = Vector3.new(0, 3, 0)
    bg.AlwaysOnTop = true
    bg.Parent = hrp

    local text = Instance.new("TextLabel")
    text.Name = "Label"
    text.BackgroundTransparency = 1
    text.Size = UDim2.new(1, 0, 1, 0)
    text.TextSize = 14
    text.Font = Enum.Font.GothamBold
    text.TextColor3 = Color3.fromRGB(255, 255, 255)
    text.TextStrokeTransparency = 0
    text.TextStrokeColor3 = Color3.new(0, 0, 0)
    text.Text = ""
    text.Parent = bg
