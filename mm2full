-- KILL AURA (взято из SHITARO, адаптировано под Fluent)
-- ═══════════════════════════════════════════════════════════════

local KillAuraSystem = {
    Enabled = false,
    Range = 50,
    Target = "All",  -- All, Sheriff, Innocent
    UseFireTouch = true,  -- Использовать firetouchinterest вместо телепорта
    LastKill = 0
}

-- Проверка что я Murderer
local function amIMurderer()
    local char = SafeGetCharacter(LocalPlayer)
    if not char then return false end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local hasKnife = (backpack and backpack:FindFirstChild("Knife")) or char:FindFirstChild("Knife")
    return hasKnife
end

-- Получить нож
local function getKnife()
    local char = SafeGetCharacter(LocalPlayer)
    if char then
        local equipped = char:FindFirstChild("Knife")
        if equipped then return equipped, true end
    end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        local stored = backpack:FindFirstChild("Knife")
        if stored then return stored, false end
    end
    return nil, false
end

-- Экипировать нож
local function ensureKnifeEquipped()
    local knife, equipped = getKnife()
    if not knife then return nil end
    if not equipped then
        local hum = SafeGetHumanoid(SafeGetCharacter(LocalPlayer))
        if hum then
            pcall(function() hum:EquipTool(knife) end)
            task.wait(0.2)
            return getKnife()
        end
        return nil
    end
    return knife
end

-- Ударить ножом (2 способа, оба работают)
local function knifeStab(knife)
    local events = knife:FindFirstChild("Events")
    local stabbed = events and events:FindFirstChild("KnifeStabbed")
    if stabbed then
        pcall(function() stabbed:FireServer() end)
    end
end

local function knifeTouch(knife, part)
    -- Способ 1: через Events.HandleTouched
    local events = knife:FindFirstChild("Events")
    local touched = events and events:FindFirstChild("HandleTouched")
    if touched then
        pcall(function() touched:FireServer(part) end)
    end
    
    -- Способ 2: через firetouchinterest (более надёжный)
    local handle = knife:FindFirstChild("Handle")
    if handle and firetouchinterest then
        pcall(function()
            firetouchinterest(handle, part, 1)  -- touch begin
            firetouchinterest(handle, part, 0)  -- touch end
        end)
    end
end

-- Получить список целей
local function getKillTargets()
    local targets = {}
    local myChar = SafeGetCharacter(LocalPlayer)
    local myHRP = SafeGetHRP(myChar)
    if not myHRP then return targets end
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        
        local pChar = SafeGetCharacter(plr)
        if not pChar then continue end
        
        local pHum = SafeGetHumanoid(pChar)
        if not pHum or pHum.Health <= 0 then continue end
        
        local pHRP = SafeGetHRP(pChar)
        if not pHRP then continue end
        
        -- Проверка фильтра по роли
        local role = GetRole(plr)
        if KillAuraSystem.Target == "Sheriff" and role ~= "Sheriff" then continue end
        if KillAuraSystem.Target == "Innocent" and role ~= "Innocent" then continue end
        
        -- Проверка дистанции
        local dist = (myHRP.Position - pHRP.Position).Magnitude
        if dist <= KillAuraSystem.Range then
            table.insert(targets, { player = plr, part = pHRP, dist = dist })
        end
    end
    
    -- Сортировка по дистанции
    table.sort(targets, function(a, b) return a.dist < b.dist end)
    return targets
end

-- Главный цикл
task.spawn(function()
    while true do
        if KillAuraSystem.Enabled then
            if amIMurderer() then
                local knife = ensureKnifeEquipped()
                if knife then
                    local targets = getKillTargets()
                    
                    if #targets > 0 and os.clock() - KillAuraSystem.LastKill > 0.1 then
                        KillAuraSystem.LastKill = os.clock()
                        
                        -- Stab для всех сразу
                        knifeStab(knife)
                        
                        -- Touch каждого
                        for _, t in ipairs(targets) do
                            knifeTouch(knife, t.part)
                            task.wait(0.02)
                        end
                    end
                end
            end
        end
        task.wait(0.1)
    end
end)

