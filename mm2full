    local nv = not SG.On
    local ok = SGToggle and pcall(function() SGToggle:SetValue(nv) end)
    if not ok then sgApply(nv) end
end
Tabs.World:AddSlider("SGlitchMax", {
    Title = "Скорость глитча", Default = 120, Min = 30, Max = 300, Rounding = 0,
    Callback = function(v) SG.Max = v end
})
Tabs.World:AddSlider("SGlitchAccel", {
