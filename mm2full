local function ShootMurderer()
    local murderer = GetMurderer()
    if not murderer then
        Notify("Shoot", "No murderer found!", nil, 3)
        return
    end
    
    local char = SafeGetCharacter(LocalPlayer)
    local gun = char and char:FindFirstChild("Gun")
    if not gun then
        local bp = LocalPlayer:FindFirstChild("Backpack")
        gun = bp and bp:FindFirstChild("Gun")
        if gun then
            local hum = SafeGetHumanoid(char)
            if hum then hum:EquipTool(gun) end
            task.wait(0.2)
            gun = char and char:FindFirstChild("Gun")
        end
    end
    
    if not gun then
        Notify("Shoot", "No gun! Wait for Sheriff to die.", nil, 4)
        return
    end
    
    local mChar = SafeGetCharacter(murderer)
    local mPart = mChar and (mChar:FindFirstChild("Head") or mChar:FindFirstChild("UpperTorso"))
    if not mPart then
        Notify("Shoot", "Target not found!", nil, 3)
        return
    end
    
    -- Aim at target
