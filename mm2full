-- ═══════════════════════════════════════════════════════════════
-- DUAL WEAPON v3.0 — механика из Overdrive (пользователь просил взять её оттуда):
--   1) клонируем ПРАВЫЙ грип-велд RightGrip (его создаёт сам движок при экипировке)
--      в ЛЕВУЮ руку: Part0 = LeftHand, Part1 = клон Handle → оружие появляется в
--      левой руке в правильном положении, ничего вручную считать не нужно;
--   2) играем анимацию Overdrive 2464917949 на гуманоиде — ЛЕВАЯ РУКА ПОДНИМАЕТСЯ
--      (приоритет Action и Loop ставим сами, чтобы поза держалась);
--   3) убрал нож/пистолет из рук → клон, велд и анимация убираются, рука опускается;
--      взял в руки → всё появляется снова (наша проверка в цикле ниже, шаг 0.1с).
-- Зеркало Motor6D из G9b больше не нужно — флаг CWH_DualMirrorOn остаётся false.
-- ═══════════════════════════════════════════════════════════════
local dualOn = true
local dualHandle, dualGrip = nil, nil
local dualTrack = nil

local dualAnim = Instance.new("Animation")
dualAnim.AnimationId = "rbxassetid://2464917949" -- анимация Overdrive: поднятая левая рука

local function removeDual()
    if dualGrip then pcall(function() dualGrip:Destroy() end) end
    if dualHandle then pcall(function() dualHandle:Destroy() end) end
    dualGrip, dualHandle = nil, nil
    if dualTrack then
        pcall(function() dualTrack:Stop(0.1) end)
        dualTrack = nil
    end
    getgenv().CWH_DualMirrorOn = false
end

local function dualPlayTrack()
    if dualTrack then
        local playing = true
        pcall(function() playing = dualTrack.IsPlaying end)
        if not playing then
            pcall(function() dualTrack:Play(0.15) end)
        end
        return
    end
    local hum = getHum(getChar(LocalPlayer))
    if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator") or hum
    local ok, tr = pcall(function() return animator:LoadAnimation(dualAnim) end)
    if not ok or not tr then
        Notify("Dual", "Анимация руки не загрузилась (клип недоступен)", nil, 3)
        return
    end
    pcall(function() tr.Priority = Enum.AnimationPriority.Action end)
    pcall(function() tr.Looped = true end)
    dualTrack = tr
    pcall(function() tr:Play(0.15) end)
end

local function dualToolName()
    local r = getRole(LocalPlayer)
    if r == "Murderer" then return "Knife" end
    if r == "Sheriff" or r == "Hero" then return "Gun" end
    return nil
end

local function addDual()
    removeDual()
    local char = getChar(LocalPlayer)
    if not char then return end

    local toolName = dualToolName()
    if not toolName then return end

    local tool = char:FindFirstChild(toolName)
    if not tool or not tool:IsA("Tool") then return end

    local handle = tool:FindFirstChild("Handle")
    if not handle then return end

    local rightHand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
    local leftHand = char:FindFirstChild("LeftHand") or char:FindFirstChild("Left Arm")
    if not (rightHand and leftHand) then return end

    -- RightGrip создаёт сам движок при экипировке; если ещё не успел появиться —
    -- просто выходим, цикл повторит попытку через 0.1с
    local rightGrip = rightHand:FindFirstChild("RightGrip")
    if not rightGrip or not (rightGrip:IsA("Weld") or rightGrip:IsA("Motor6D")) then return end

    -- [Overdrive] клон Handle кладём прямо В ТУЛ (как в оригинале), грип-клон — в левую руку
    local handleClone = handle:Clone()
    handleClone.Name = "Handle1"
    handleClone.CanCollide = false
    handleClone.Massless = true
    for _, d in ipairs(handleClone:GetChildren()) do
        if d:IsA("TouchTransmitter") or d:IsA("Script") or d:IsA("LocalScript") then
            d:Destroy()
        end
    end
    handleClone.Parent = tool

    local gripClone = rightGrip:Clone()
    gripClone.Name = "LeftGrip"
    gripClone.Part0 = leftHand
    gripClone.Part1 = handleClone
    gripClone.Parent = leftHand

    dualHandle, dualGrip = handleClone, gripClone
    dualPlayTrack()
end

-- Цикл проверки состояния оружия (наша часть: взял ли я в руку нож/пистолет?)
task.spawn(function()
    while task.wait(0.1) do
        if dualOn then
            local char = getChar(LocalPlayer)
            local toolName = char and dualToolName()
            local inHands = toolName and char:FindFirstChild(toolName)
            if inHands then
                local alive = dualHandle and dualHandle.Parent and dualGrip and dualGrip.Parent
                if not alive then
                    pcall(addDual)
                elseif dualTrack then
                    -- страховка: пока оружие в руках, левая рука должна оставаться поднятой
                    local playing = true
                    pcall(function() playing = dualTrack.IsPlaying end)
                    if not playing then
                        pcall(function() dualTrack:Play(0.15) end)
                    end
                end
            else
                if dualHandle or dualGrip or dualTrack then
                    removeDual()
                end
            end
        else
            if dualHandle or dualGrip or dualTrack then
                removeDual()
            end
        end
    end
end)

