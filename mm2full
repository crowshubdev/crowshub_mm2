local function getLobby()
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:FindFirstChild("Lobby") then return obj.Lobby end
        if obj.Name:lower() == "lobby" then return obj end
    end
    return nil
end

local function segment_gap(a, b, p)
    if not a then return (b - p).Magnitude end
    local ab = b - a
    local len2 = ab:Dot(ab)
    if len2 < 1e-6 then return (b - p).Magnitude end
    local t = math.clamp((p - a):Dot(ab) / len2, 0, 1)
    return (a + ab * t - p).Magnitude
end

local function touchGrab(part, root)
    if not realFireTouch or not part or not root then return false end
    pcall(function()
        realFireTouch(part, root, 1)
        realFireTouch(part, root, 0)
    end)
    return true
end

