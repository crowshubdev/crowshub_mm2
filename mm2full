function Fluent:CreateWindow(cfg)
    local win = OBS:CreateWindow({
        Title = cfg.Title or "Crows Hub",
        Footer = (cfg.SubTitle or "Remastered MM2") .. " | v1.12 | Obsidian",
        ToggleKeybind = cfg.MinimizeKey or Enum.KeyCode.LeftAlt, -- [v1.9] дефолт LeftAlt, меняется в Settings
        MobileButtonsSide = "Left", -- [v1.9] кнопки ЛОК + ТОГГЛ на телефоне
        NotifySide = "Right",
    })
    local W = { _win = win }
    function W:Minimize()
        pcall(function() win:Toggle() end)
    end
    function W:AddTab(info)
        local tab = win:AddTab(info.Title or "Tab", info.Icon or "package")
        local T = { _tab = tab, _cur = nil, _side = "Left" }
        function T:_box()
            if not self._cur then
                self._cur = self._tab:AddGroupbox({ Name = "Crows Hub", Side = self._side })
            end
            return self._cur
        end
        -- AddSection = новый groupbox, стороны чередуем Left/Right (как две колонки)
        function T:AddSection(name)
            self._side = (self._side == "Left") and "Right" or "Left"
            self._cur = self._tab:AddGroupbox({ Name = name, Side = self._side })
            return self
        end
        function T:AddToggle(id, o)
            return self:_box():AddToggle(id, {
                Text = o.Title or id,
                Tooltip = o.Description,
                Default = o.Default,
                Callback = o.Callback,
            })
        end
        function T:AddSlider(id, o)
            return self:_box():AddSlider(id, {
                Text = o.Title or id,
                Tooltip = o.Description,
                Default = o.Default or 0,
                Min = o.Min or 0,
                Max = o.Max or 100,
                Rounding = o.Rounding or 0,
                Callback = o.Callback,
            })
        end
        function T:AddDropdown(id, o)
            return self:_box():AddDropdown(id, {
                Text = o.Title or id,
                Tooltip = o.Description,
                Values = o.Values or {},
                Default = o.Default,
                Multi = false,
                Searchable = (o.Values and #o.Values > 8) or false,
                Callback = o.Callback,
            })
        end
        function T:AddInput(id, o)
            return self:_box():AddInput(id, {
                Text = o.Title or id,
                Tooltip = o.Description,
                Default = o.Default or "",
                Placeholder = o.Placeholder or "",
                Finished = false,
                Callback = o.Callback,
            })
        end
        function T:AddButton(o)
            return self:_box():AddButton({
                Text = o.Title or "Button",
                Tooltip = o.Description,
                Func = o.Callback,
            })
        end
        return T
    end
    return W
end
