local function auraDestroyAll()
    for _, t in ipairs({auraFloor, auraBody}) do
        for _, p in pairs(t) do pcall(function() p:Destroy() end) end
    end
    auraFloor, auraBody = {}, {}
end

local function auraHost(store, name, suffix)
    local p = store[name]
    if p and p.Parent then return p end
    p = Instance.new("Part")
    p.Name = "CWH_Aura_" .. name .. suffix
    p.Anchored = true
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.CastShadow = false
    p.Transparency = 1
    p.Size = Vector3.new(4, 4, 4)
    p.Parent = workspace
    store[name] = p
    return p
end

local function auraBuild(name)
    for _, cfg in ipairs(CWH_PULSE_AURAS[name] or {}) do
        pcall(function()
            local isFloor = tostring(cfg.Name):lower():find("floor") ~= nil
            local host = isFloor and auraHost(auraFloor, name, "_F") or auraHost(auraBody, name, "_B")
            local e = Instance.new("ParticleEmitter")
            for k, v in pairs(cfg) do
                if k ~= "Name" then e[k] = v end
            end
            e.Parent = host
        end)
    end
    if not auraFollowConn then
        auraFollowConn = RunService.Heartbeat:Connect(function()
            for _, t in ipairs({auraFloor, auraBody}) do
                for _, p in pairs(t) do
                    pcall(function()
                        local hrp = getHRP(getChar(LocalPlayer))
                        if hrp and p and p.Parent then
                            -- Floor-ауры стоят у ног, остальные — на корпусе
                            if tostring(p.Name):find("_F") then
                                p.CFrame = hrp.CFrame - Vector3.new(0, 3, 0)
                            else
                                p.CFrame = hrp.CFrame
                            end
                        end
                    end)
                end
            end
        end)
    end
end

local function auraSet(name, on)
    if on then
        auraBuild(name)
        Notify("Visual 2", "Аура включена: " .. name, nil, 2)
    else
        for _, t in ipairs({auraFloor, auraBody}) do
            for n, p in pairs(t) do
                if n == name then pcall(function() p:Destroy() end) t[n] = nil end
            end
        end
    end
end

