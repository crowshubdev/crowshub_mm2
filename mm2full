            -- вернуть громкость звукам, которые ушли из нашего гана/выключили глушение
            for snd, vol in pairs(mutedSndCache) do
                if (not snd.Parent) or (not muteNativeOn) or (not gun) or (not snd:IsDescendantOf(gun)) then
                    if snd.Parent then pcall(function() snd.Volume = vol end) end
                    mutedSndCache[snd] = nil
                end
            end
            if not muteNativeOn or not gun then return end
            for _, d in ipairs(gun:GetDescendants()) do
                if d:IsA("Sound") and nativeIsGunSnd(d) then
                    if not mutedSndCache[d] then
                        mutedSndCache[d] = d.Volume
                    end
                    if d.Volume ~= 0 then d.Volume = 0 end
                end
            end
        end)
    end
end)

