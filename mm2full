-- ── SkyFX из Pulse ──
local TEX = { dot = "rbxassetid://16512006463", soft = "rbxassetid://1075864321",
              spark = "rbxassetid://14590086212", sharp = "rbxassetid://17391818367" }
local TINTS = {
    Natural = { Color3.fromRGB(232, 240, 255), Color3.fromRGB(170, 200, 255), Color3.fromRGB(255, 226, 190) },
    Cold = { Color3.fromRGB(205, 225, 255), Color3.fromRGB(140, 185, 255), Color3.fromRGB(190, 240, 255) },
    Warm = { Color3.fromRGB(255, 238, 214), Color3.fromRGB(255, 205, 150), Color3.fromRGB(255, 180, 140) },
    Pastel = { Color3.fromRGB(255, 205, 236), Color3.fromRGB(195, 255, 232), Color3.fromRGB(214, 196, 255) },
}
local DUST = {
    Gold = { Color3.fromRGB(255, 220, 130), Color3.fromRGB(255, 190, 90) },
    Silver = { Color3.fromRGB(235, 242, 255), Color3.fromRGB(190, 210, 255) },
    Pink = { Color3.fromRGB(255, 170, 220), Color3.fromRGB(255, 120, 190) },
    Aqua = { Color3.fromRGB(140, 255, 235), Color3.fromRGB(110, 200, 255) },
}
local SKY = { Stars = false, StarDensity = 60, StarTint = "Natural",
              Meteors = false, Comets = false, Dust = false, DustSet = "Gold" }

local skyHost, emStars, emMeteors, emComets = nil, nil, nil, nil
local dustPart, dustConn, dustEm = nil, nil, nil

local function skySeq(t)
    return ColorSequence.new(t[1], t[2], t[3])
end

local function skyHostPart()
    if skyHost and skyHost.Parent then return skyHost end
    local p = Instance.new("Part")
    p.Name = "CWH_SkyFX_Host"
    p.Anchored = true
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.CastShadow = false
    p.Transparency = 1
    p.Size = Vector3.new(650, 650, 650)
    local cf = nil
    local m = getMap()
    if m then
        pcall(function() cf = m:GetModelCFrame() end)
        if not cf then
            local pp = m:FindFirstChildWhichIsA("BasePart", true)
            if pp then cf = pp.CFrame end
        end
    end
    if not cf then cf = CFrame.new(0, 200, 0) end
    p.CFrame = cf + Vector3.new(0, 380, 0)
    p.Parent = workspace
    skyHost = p
    return p
end

local function mkEmitter(host, props)
    local e = Instance.new("ParticleEmitter")
    for k, v in pairs(props) do e[k] = v end
    e.Parent = host
    return e
end

local function skyApply()
    -- Звёзды: статичные точки в объёме неба (LockedToPart, как в Pulse)
    if SKY.Stars then
        local host = skyHostPart()
        if not emStars then
            emStars = mkEmitter(host, {
                Texture = TEX.dot, LightEmission = 1, LightInfluence = 0,
                LockedToPart = true, Rate = SKY.StarDensity,
                Lifetime = NumberRange.new(9, 12),
                Speed = NumberRange.new(0.05, 0.15),
                Size = NumberSequence.new(3.2, 3.2),
                Transparency = NumberSequence.new(0.25, 0.25),
                Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-4, 4),
            })
        end
        emStars.Rate = SKY.StarDensity
        emStars.Color = skySeq(TINTS[SKY.StarTint] or TINTS.Natural)
        emStars.Enabled = true
    elseif emStars then
        emStars.Enabled = false
    end
    -- Падающие звёзды: редкие быстрые искры сверху вниз
    if SKY.Meteors then
        local host = skyHostPart()
        if not emMeteors then
            emMeteors = mkEmitter(host, {
                Texture = TEX.spark, LightEmission = 1, LightInfluence = 0,
                Rate = 3, LockedToPart = false, EmissionDirection = Enum.NormalId.Bottom,
                Lifetime = NumberRange.new(1.6, 2.4), Speed = NumberRange.new(90, 140),
                Acceleration = Vector3.new(0, -60, 0),
                Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4),
                    NumberSequenceKeypoint.new(0.5, 1.6), NumberSequenceKeypoint.new(1, 0) }),
                Transparency = NumberSequence.new(0, 0.3),
            })
        end
        emMeteors.Color = skySeq(TINTS[SKY.StarTint] or TINTS.Natural)
        emMeteors.Enabled = true
    elseif emMeteors then
        emMeteors.Enabled = false
    end
    -- Кометы: крупные медленные
    if SKY.Comets then
        local host = skyHostPart()
        if not emComets then
            emComets = mkEmitter(host, {
                Texture = TEX.sharp, LightEmission = 1, LightInfluence = 0,
                Rate = 2, LockedToPart = false, EmissionDirection = Enum.NormalId.Bottom,
                Lifetime = NumberRange.new(2.5, 3.5), Speed = NumberRange.new(55, 80),
                Acceleration = Vector3.new(0, -35, 0),
                Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8),
                    NumberSequenceKeypoint.new(0.5, 3.5), NumberSequenceKeypoint.new(1, 0) }),
                Transparency = NumberSequence.new(0, 0.35),
            })
        end
        emComets.Color = ColorSequence.new(Color3.fromRGB(120, 210, 255))
        emComets.Enabled = true
    elseif emComets then
        emComets.Enabled = false
    end
    -- Пыль: мягкие частицы вокруг персонажа
    if SKY.Dust then
        if not dustPart then
            dustPart = Instance.new("Part")
            dustPart.Name = "CWH_Dust_Host"
            dustPart.Anchored = true
            dustPart.CanCollide = false
            dustPart.CanQuery = false
            dustPart.CanTouch = false
            dustPart.CastShadow = false
            dustPart.Transparency = 1
            dustPart.Size = Vector3.new(14, 14, 14)
            dustEm = mkEmitter(dustPart, {
                Texture = TEX.soft, LightEmission = 1, LightInfluence = 0,
                Rate = 22, LockedToPart = true,
                Lifetime = NumberRange.new(2.5, 3.5), Speed = NumberRange.new(0.6, 1.6),
                Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4),
                    NumberSequenceKeypoint.new(0.5, 1.4), NumberSequenceKeypoint.new(1, 0) }),
                Transparency = NumberSequence.new(0.35, 0.55),
            })
            dustPart.Parent = workspace
        end
        dustEm.Color = skySeq(DUST[SKY.DustSet] or DUST.Gold)
        dustEm.Enabled = true
        if not dustConn then
            dustConn = RunService.Heartbeat:Connect(function()
                pcall(function()
                    local hrp = getHRP(getChar(LocalPlayer))
                    if hrp and dustPart and dustPart.Parent then
                        dustPart.CFrame = hrp.CFrame
                    end
                end)
            end)
        end
    elseif dustPart then
        if dustEm then dustEm.Enabled = false end
        if dustConn then pcall(function() dustConn:Disconnect() end) dustConn = nil end
        pcall(function() dustPart:Destroy() end)
        dustPart, dustEm = nil, nil
    end
end

local function skyCleanup()
    pcall(function() if skyHost then skyHost:Destroy() end end)
    skyHost, emStars, emMeteors, emComets = nil, nil, nil, nil
end

